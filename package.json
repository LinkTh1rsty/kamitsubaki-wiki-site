{
  "name": "kamitsubaki-wiki-site",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:generate": "node scripts/generate-traditional-chinese.mjs",
    "predev": "node scripts/sync-support-catalog.mjs && node scripts/generate-support-qr.mjs --check && node scripts/sync-traditional-definition.mjs && pnpm build:site-components && pnpm build:editor && pnpm i18n:generate",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-support-catalog.mjs && node scripts/generate-support-qr.mjs --check && node scripts/sync-traditional-definition.mjs && pnpm build:site-components && node scripts/build-game-ui.mjs && pnpm build:editor && pnpm validate:content && pnpm i18n:generate && pnpm gallery:entities:check && pnpm gallery:imports:check && pnpm gallery:publication:check",
    "build": "astro build",
    "build:online": "node scripts/build-online.mjs",
    "check:online-build": "node scripts/audit-online-build.mjs",
    "preview": "astro preview",
    "precheck": "node scripts/sync-traditional-definition.mjs && pnpm i18n:generate",
    "check": "astro check",
    "pretest": "node scripts/sync-traditional-definition.mjs && pnpm i18n:generate",
    "test": "node scripts/run-tests.mjs",
    "lyrics:timestamps:fetch": "node scripts/fetch-lyrics-timestamps.mjs",
    "lyrics:timestamps:apply": "node scripts/apply-lyrics-timestamps.mjs",
    "lyrics:timestamps:audit": "node scripts/audit-lyrics-timestamps.mjs",
    "pages:assets:audit": "node scripts/audit-pages-assets.mjs dist",
    "lyrics:content:repair": "node scripts/repair-lyrics-content.mjs",
    "contributors:sync": "node scripts/sync-contributors.mjs",
    "images:generate": "node scripts/generate-thumbnails.mjs",
    "dev:editor": "PUBLIC_EDITOR_ENABLED=true PUBLIC_EDITOR_LOCAL=true CHOKIDAR_USEPOLLING=true CHOKIDAR_INTERVAL=750 astro dev --config astro.editor.config.mjs --host 127.0.0.1 --port 4358",
    "validate:content": "node scripts/validate-content.mjs",
    "check:ui-actions": "node scripts/check-context-actions.mjs",
    "ui:tokens:sync": "node scripts/sync-ui-tokens.mjs",
    "ui:tokens:check": "node scripts/sync-ui-tokens.mjs --check",
    "gallery:entities:sync": "node scripts/sync-gallery-entities.mjs",
    "gallery:entities:check": "node scripts/sync-gallery-entities.mjs --check",
    "gallery:imports:build": "node scripts/build-gallery-import-manifest.mjs",
    "gallery:imports:check": "node scripts/build-gallery-import-manifest.mjs --check",
    "gallery:publication:build": "node scripts/build-gallery-publication-manifest.mjs",
    "gallery:publication:check": "node scripts/build-gallery-publication-manifest.mjs --check",
    "docs:check": "node scripts/check-docs.mjs",
    "migrate:v3": "node scripts/v3/migrate.mjs",
    "dev:online": "node scripts/dev-online.mjs",
    "check:tiptap": "node scripts/check-tiptap-compatibility.mjs",
    "check:ui-icons": "node scripts/check-ui-icons.mjs",
    "icons:generate": "node scripts/generate-ui-icon-assets.mjs",
    "release:build": "node scripts/release-build.mjs",
    "archive:check": "node scripts/check-fan-archive.mjs",
    "archive:snapshot": "node scripts/archive-snapshot.mjs",
    "archive:snapshots:check": "node scripts/archive-snapshot.mjs --check",
    "dev:novel": "pnpm --dir prototypes/novel-editor dev",
    "build:editor": "node scripts/build-editor-workbench.mjs",
    "build:site-components": "node scripts/build-site-components.mjs",
    "check:mature-components": "node scripts/build-site-components.mjs --check && node scripts/sync-companion-ui.mjs --check && node scripts/complete-ui-controls.mjs --check && node scripts/build-game-ui.mjs --check && node scripts/sync-traditional-definition.mjs --check && node scripts/sync-support-catalog.mjs --check && node scripts/generate-support-qr.mjs --check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource-variable/noto-serif-tc": "5.3.0",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@lezer/highlight": "^1.2.5",
    "@uppy/core": "6.2.0",
    "@uppy/dashboard": "6.0.1",
    "@uppy/locales": "5.3.0",
    "@uppy/status-bar": "6.0.0",
    "@uppy/xhr-upload": "6.0.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "astro": "latest",
    "dexie": "4.4.6",
    "eventsource-parser": "3.0.6",
    "fflate": "0.8.3",
    "fuse.js": "7.5.0",
    "katex": "^0.17.0",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "leaflet": "1.9.4",
    "lucide": "^1.55.0",
    "luxon": "3.7.2",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "opencc-js": "1.4.1",
    "pagefind": "1.5.2",
    "photoswipe": "^5.4.4",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "simple-icons": "^16.27.0",
    "sortablejs": "1.15.7",
    "tom-select": "2.6.2",
    "unified": "11.0.5",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@astrojs/markdown-remark": "^7.2.4",
    "@shikijs/rehype": "^4.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "daisyui": "5.7.47",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "qrcode": "1.5.4",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "6.0.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "latest",
    "vite": "7.3.5",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@11.1.1"
}
