---
import { getCollection } from 'astro:content';
import ToolsDock from '../components/ToolsDock.astro';
import AccountChrome from '../components/AccountChrome.astro';
import AiChatWidget from '../components/AiChatWidget.astro';
import LiveEventsWidget from '../components/LiveEventsWidget.astro';
import SiteSearch from '../components/SiteSearch.astro';
import SiteIntro from '../components/SiteIntro.astro';
import SocialContactWidget from '../components/SocialContactWidget.astro';
import {
  getLanguageTag,
  getLocaleFontStylesheet,
  getLocalizedSiteName,
  resolveLocaleCopy,
} from '../lib/i18n.mjs';
import { absoluteUrl, buildSearchAlternates, buildPageStructuredData, serializeStructuredData } from '../lib/searchMetadata.mjs';
import { getLocalizedSite } from '../lib/homeData.mjs';
import '../styles/global.css';
import '../styles/quietChrome.css';
import '../styles/interface.css';
import '../styles/mediaSwitcher.css';
import '../styles/reader.css';
import '../styles/readerFormats.css';
import '../styles/polish.css';

type PageMetadata = {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonicalPath?: string;
  type?: 'website' | 'article';
  keywords?: string[];
  noindex?: boolean;
};

const {
  title = 'Kamitsubaki Studio Fan Wiki',
  lang = 'zh',
  alternates = [],
  metadata = {},
  reading = false,
} = Astro.props as {
  title?: string;
  lang?: string;
  alternates?: {
    locale: string;
    href: string;
  }[];
  metadata?: PageMetadata;
  reading?: boolean;
};

const localizedSiteName = getLocalizedSiteName(lang);
const languageTag = getLanguageTag(lang);
const siteOrigin = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.origin || 'https://kamitsubaki.wiki').replace(/\/$/, '');
const requestedPageTitle = metadata.title || title;
const isLocalizedHome = new RegExp(`^/${lang}/?$`).test(Astro.url.pathname);
const pageTitle = isLocalizedHome
  ? localizedSiteName
  : requestedPageTitle.replace(/Kamitsubaki Studio Fan Wiki$/i, localizedSiteName);
const pageDescription = metadata.description || resolveLocaleCopy({
  zh: 'KAMITSUBAKI STUDIO 非官方粉丝百科。',
  ja: 'KAMITSUBAKI STUDIO 非公式ファン百科。',
  en: 'An unofficial KAMITSUBAKI STUDIO fan encyclopedia.',
}, lang);
const pageType = metadata.type || 'website';
const canonicalPath = metadata.canonicalPath || Astro.url.pathname;
const canonicalUrl = absoluteUrl(canonicalPath, siteOrigin);
const pageImage = metadata.image;
const pageImageUrl = pageImage ? absoluteUrl(pageImage, siteOrigin) : undefined;
const searchAlternates = buildSearchAlternates(alternates, siteOrigin);
const defaultAlternate = searchAlternates.find((alternate) => alternate.locale === 'zh');
const robots = metadata.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const structuredData = buildPageStructuredData({
  title: pageTitle, description: pageDescription, url: canonicalUrl,
  image: pageImageUrl, imageAlt: metadata.imageAlt, locale: lang,
  origin: siteOrigin, isHome: isLocalizedHome,
});
const siteEntries = await getCollection('site');
const siteContent = getLocalizedSite(siteEntries, lang);
const aiChatCopy = siteContent?.aiChat;
const socialContactCopy = siteContent?.socialContact;
const liveEventsCopy = siteContent?.liveEvents;
const fontStylesheet = getLocaleFontStylesheet(lang);
---

<!doctype html>
<html lang={languageTag} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ isLocalizedHome }}>
      (() => {
        const storageKey = 'kamitsubaki-theme';
        const introStorageKey = 'kamitsubaki-home-intro-seen';
        let preference = 'system';
        let shouldPlayIntro = false;

        try {
          const savedPreference = window.localStorage.getItem(storageKey);
          if (savedPreference === 'light' || savedPreference === 'dark' || savedPreference === 'system') {
            preference = savedPreference;
          }
        } catch {
          // Storage may be unavailable in privacy-restricted browsing contexts.
        }

        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = preference === 'system' ? (systemPrefersDark ? 'dark' : 'light') : preference;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = theme;

        if (isLocalizedHome) {
          shouldPlayIntro = true;

          try {
            shouldPlayIntro = window.sessionStorage.getItem(introStorageKey) !== 'true';
            if (shouldPlayIntro) window.sessionStorage.setItem(introStorageKey, 'true');
          } catch {
            // The intro still works when session storage is unavailable.
          }

          if (shouldPlayIntro) document.documentElement.classList.add('site-intro-enabled');
        }

        if (!shouldPlayIntro) document.documentElement.classList.add('site-page-transition-enabled');
      })();
    </script>
    <link rel="stylesheet" href="/ui-tokens.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/brand/kamitsubakiwiki-square.svg" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robots} />
    {metadata.keywords?.length && <meta name="keywords" content={metadata.keywords.join(', ')} />}
    <link rel="canonical" href={canonicalUrl} />
    {searchAlternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
    {isLocalizedHome && (
      <>
        <link rel="preload" href="/brand/site-intro-light.mp4" as="video" type="video/mp4" />
        <link rel="preload" href="/brand/main-logo-dark.svg" as="image" type="image/svg+xml" />
        <link rel="preload" href="/brand/main-logo-light.svg" as="image" type="image/svg+xml" />
      </>
    )}
    <meta property="og:site_name" content={localizedSiteName} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {pageImageUrl && <>
      <meta property="og:image" content={pageImageUrl} />
      <meta property="og:image:alt" content={metadata.imageAlt || pageTitle} />
      {metadata.imageWidth && <meta property="og:image:width" content={String(metadata.imageWidth)} />}
      {metadata.imageHeight && <meta property="og:image:height" content={String(metadata.imageHeight)} />}
    </>}
    <meta name="twitter:card" content={pageImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {pageImageUrl && <>
      <meta name="twitter:image" content={pageImageUrl} />
      <meta name="twitter:image:alt" content={metadata.imageAlt || pageTitle} />
    </>}
    <script type="application/ld+json" is:inline set:html={serializeStructuredData(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontStylesheet} rel="stylesheet" />
  </head>
  <body class:list={['antialiased font-sans selection:bg-white selection:text-black', { 'wiki-reading-page': reading, 'site-home': isLocalizedHome }]} id="body-wrap">
    {isLocalizedHome && <SiteIntro />}
    <div id="preloader" data-page-transition aria-hidden="true">
      <div class="flex flex-col items-center">
        <div class="preloader-line mb-4"></div>
        <p class="animate-pulse font-mono text-[8px] tracking-[0.5em] text-white/50">
          CONNECTING TO KAMITSUBAKI_CITY...
        </p>
      </div>
    </div>

    <div class="noise-bg"></div>
    <div class="cursor-dot hidden md:block" id="cursor" aria-hidden="true"></div>

    <slot />
    <AccountChrome locale={lang} />
    <SiteSearch lang={lang} />
    <ToolsDock lang={lang}>
      {isLocalizedHome && liveEventsCopy && <LiveEventsWidget lang={lang} copy={liveEventsCopy} />}
      {socialContactCopy && <SocialContactWidget lang={lang} copy={socialContactCopy} />}
    </ToolsDock>
    {aiChatCopy && <AiChatWidget lang={lang} copy={aiChatCopy} />}

    <script>
      import '../scripts/themeToggle.js';
      import '../scripts/siteInteractions.js';
      import '../scripts/readerEnhancements.js';
      import '../scripts/mediaSwitcher.js';
    </script>
  </body>
</html>
