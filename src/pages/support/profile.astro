---
import LoadingStatus from '../../components/LoadingStatus.astro';
import WorkspaceButton from '../../components/WorkspaceButton.astro';
import '../../styles/global.css';
import '../../styles/uiKit.css';
const apiBase=import.meta.env.PUBLIC_SUPPORT_API_BASE || import.meta.env.PUBLIC_AI_OBSERVER_API_BASE || 'https://api.kamitsubaki.wiki';
---
<!doctype html>
<html lang="zh-Hans">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="no-referrer"/><title>完善发电展示资料 · KAMITSUBAKI Wiki</title><script is:inline>(()=>{let p='system';try{const s=localStorage.getItem('kamitsubaki-theme');if(s==='light'||s==='dark'||s==='system')p=s}catch{}document.documentElement.dataset.theme=p==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):p})();</script></head>
<body>
<main class="supporter-profile" data-supporter-profile data-api-base={apiBase}>
 <header><a class="profile-brand" href="/zh/support/">KAMITSUBAKI WIKI</a><p class="profile-eyebrow">THANK YOU FOR YOUR SUPPORT</p><h1>让我们好好感谢你。</h1><p>付款后会先展示你的爱发电昵称和头像。想更换展示资料时，按下面三步完成；无需注册 Wiki。邮箱、订单和金额不会公开。</p></header>
 <ol class="profile-steps" aria-label="完善资料流程"><li>填写资料与验证邮箱</li><li>选择 Wiki 账号关联方式</li><li>提交审核，邮件接收结果</li></ol>
 <p class="profile-status" data-profile-status role="status" aria-live="polite" tabindex="-1"><LoadingStatus label="正在读取专属链接…"/></p>
 <WorkspaceButton data-email-confirm tone="primary" hidden>确认验证邮箱</WorkspaceButton>
 <section class="profile-done" data-profile-done hidden aria-live="polite">
  <h2 data-done-title>已提交，等待审核</h2>
  <dl><dt>展示昵称</dt><dd data-done-name></dd><dt>联系邮箱</dt><dd data-done-email></dd></dl>
  <p class="profile-done-verify" data-done-verify></p>

  <div class="profile-actions"><WorkspaceButton data-profile-retry>刷新审核状态</WorkspaceButton><WorkspaceButton data-profile-edit>修改后重新提交</WorkspaceButton><WorkspaceButton href="/zh/support/">返回项目支持页面</WorkspaceButton></div>
 </section>
 <form data-profile-form hidden>
  <div class="profile-avatar"><img data-avatar-preview hidden alt="头像预览" width="88" height="88"/><span data-avatar-placeholder aria-hidden="true">✦</span><label>展示头像 <span>选填</span><input type="file" data-avatar-input accept="image/png,image/jpeg,image/webp"/><small>PNG / JPEG / WebP，最大 2 MiB。建议正方形。</small></label></div>
  <label for="supporter-email">联系邮箱 <span class="required">必填</span></label><input id="supporter-email" name="email" type="email" required maxlength="254" autocomplete="email" class="dui-input"/><small>用于邮箱验证码、审核结果和必要联系，不公开。输入验证码验证后才能提交；更换邮箱需要重新验证。</small>
  <label for="supporter-name">展示昵称 <span class="required">必填</span></label><input id="supporter-name" name="name" type="text" required maxlength="60" autocomplete="nickname" class="dui-input"/><small>请勿填入邮箱、手机号等私人信息。</small>
  <p data-code-verified hidden role="status">邮箱已验证。更换邮箱时需重新验证。</p><fieldset class="profile-wiki" data-code-step><legend>1 · 验证联系邮箱</legend><div class="profile-actions"><WorkspaceButton data-code-send>发送验证码</WorkspaceButton></div><label for="supporter-code">邮箱验证码</label><input class="dui-input" id="supporter-code" data-email-code inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" aria-describedby="supporter-code-status"/><small id="supporter-code-status" data-code-status role="status">请先发送验证码，再输入邮件中的 6 位数字。10 分钟内有效。</small><div class="profile-actions"><WorkspaceButton data-code-confirm>验证邮箱</WorkspaceButton></div></fieldset>
  <fieldset class="profile-wiki" data-wiki-step hidden><legend>2 · 选择 Wiki 账号关联方式</legend><label><input type="radio" name="binding" value="later" checked/> 以后再绑定</label><small>可以直接提交。审核通过后，如果已有或以后注册的 Wiki 账号使用同一已验证邮箱，贡献会自动关联。</small><label><input type="radio" name="binding" value="now"/> 现在登录或注册，绑定我的 Wiki 账号</label><small>允许使用不同邮箱的本人账号。必须实际登录，绑定申请随资料一起审核；不会替换已有绑定。</small><div data-wiki-now hidden><p data-wiki-account-status><LoadingStatus label="正在读取登录状态…"/></p><p data-wiki-account-choice hidden>本次申请绑定：<strong data-wiki-account-name></strong></p><div class="profile-actions"><WorkspaceButton href="/auth/sign-in" target="_blank" rel="noopener noreferrer" data-wiki-login>登录 Wiki</WorkspaceButton><WorkspaceButton href="/auth/sign-up" target="_blank" rel="noopener noreferrer" data-wiki-register>注册 Wiki</WorkspaceButton><WorkspaceButton data-wiki-refresh>我已登录，刷新账号</WorkspaceButton></div><small>登录在新标签页完成。本页填写内容保留，回来刷新账号后提交。</small></div></fieldset>
  <div class="profile-actions"><WorkspaceButton type="submit" tone="primary" data-profile-submit disabled>验证邮箱后提交审核</WorkspaceButton><WorkspaceButton data-profile-retry>重新读取</WorkspaceButton></div>
  <p class="profile-note">审核通过或需要修改时会发送结果邮件。需要修改时可在专属链接中修改重提；审核期间保留原有公开资料。<br/>公开名单仅显示昵称、头像和爱发电主页，不显示邮箱、订单或金额。专属链接有效期 7 天，请勿转发。</p>
 </form>
 <WorkspaceButton data-profile-retry data-profile-outside-retry hidden>重新读取</WorkspaceButton>
 <section class="profile-reissue" data-reissue hidden><h2>重新获取专属链接</h2><p>填写原爱发电账号的个人主页链接。过期链接会补发到该账号的爱发电私信；已有有效邀请时请查看原私信，不会让正在使用的链接失效。</p><form data-reissue-form><label for="supporter-afdian-account">爱发电个人主页链接或账号 ID</label><input class="dui-input" id="supporter-afdian-account" name="afdianAccount" required maxlength="200" autocomplete="off" placeholder="https://afdian.com/u/…"/><div class="profile-actions"><WorkspaceButton type="submit" data-reissue-submit>发送到爱发电私信</WorkspaceButton></div><p data-reissue-status role="status"></p></form></section>
 <footer><a href="/zh/support/">返回项目支持页面</a><span>非官方粉丝项目 · 感谢你的每一份支持</span></footer>
</main>
<script>import '../../scripts/supporterProfile.ts';</script>
</body>
</html>
<style>
 .supporter-profile{--muted:rgb(var(--theme-fg-rgb)/.62);}
 :global(body){margin:0;background:var(--theme-bg);color:var(--theme-body);font-family:var(--font-sans);}
 .supporter-profile{max-width:600px;margin:64px auto;padding:0 24px 40px;line-height:1.8;}
 .profile-steps{list-style:decimal;padding-left:22px;font-size:14px;color:var(--muted);}.profile-reissue{margin-top:24px;}.profile-reissue h2{font:500 22px/1.5 var(--font-serif);}.profile-wiki input[type=radio]{min-width:20px;min-height:20px;vertical-align:middle;}.profile-wiki label{min-height:44px;display:flex;align-items:center;gap:8px;}
 .profile-wiki strong{overflow-wrap:anywhere;}[data-code-verified]{font-size:14px;color:var(--theme-fg);}
 .profile-brand{font-size:12px;font-weight:750;letter-spacing:.12em;color:inherit;text-decoration:none;}
 .profile-eyebrow{font:var(--ui-font-xs)/1.8 var(--font-mono);letter-spacing:.16em;color:var(--theme-accent-color);margin-top:42px;}
 h1{font:500 30px/1.5 var(--font-serif);color:var(--theme-fg);margin:12px 0 18px;}header>p:last-child{color:var(--muted);font-size:14px;}
 form{background:var(--theme-panel-solid);border:1px solid var(--ui-line);border-radius:var(--ui-radius-panel,8px);padding:28px;margin-top:24px;}
 label{display:block;margin:24px 0 8px;font-size:14px;font-weight:600;color:var(--theme-fg);}input.dui-input{display:block;width:100%;box-sizing:border-box;background:var(--theme-bg);color:var(--theme-fg);border:1px solid var(--ui-line);min-height:44px;border-radius:var(--ui-radius-control,6px);padding:10px 12px;font-size:16px;}
 small{display:block;color:var(--muted);font-size:12px;margin-top:6px;}.required,label span{font-weight:400;font-size:12px;color:var(--muted);margin-left:8px;}
 .profile-avatar{display:flex;gap:20px;align-items:center;margin-bottom:12px;}.profile-avatar img,.profile-avatar>span{width:88px;height:88px;object-fit:cover;border-radius:50%;flex-shrink:0;background:rgb(var(--theme-fg-rgb)/.06);}.profile-avatar>span{text-align:center;line-height:88px;font-size:32px;color:var(--muted);}.profile-avatar label{margin:0;min-width:0;}input[type=file]{display:block;margin-top:8px;max-width:100%;font-weight:400;font-size:12px;}
 .profile-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px;}.profile-note{font-size:12px;color:var(--muted);margin:20px 0 0;}.profile-status{position:sticky;top:12px;z-index:5;font-size:14px;padding:14px 16px;border-radius:var(--ui-radius-control,6px);background:var(--theme-panel-solid);border:1px solid rgb(var(--theme-accent-rgb)/.35);color:var(--theme-fg);outline:none;}.profile-status[data-error=true]{background:color-mix(in srgb,var(--ui-color-error) 12%,var(--theme-panel-solid));border-color:var(--ui-color-error);color:var(--theme-fg);font-weight:600;}.profile-status:focus-visible{outline:2px solid var(--theme-accent-color);outline-offset:2px;}
 .profile-done{background:var(--theme-panel-solid);border:1px solid var(--ui-line);border-radius:var(--ui-radius-panel,8px);padding:28px;margin-top:24px;}.profile-done h2{margin:0 0 16px;font:500 20px/1.5 var(--font-serif);color:var(--theme-fg);}.profile-done dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 16px;font-size:14px;}.profile-done dt{color:var(--muted);}.profile-done dd{margin:0;word-break:break-all;color:var(--theme-fg);}.profile-done-verify{margin:18px 0 0;font-size:13px;color:var(--muted);background:rgb(var(--theme-fg-rgb)/.05);border-radius:var(--ui-radius-control,6px);padding:12px 14px;}.profile-done a[data-email-preview]{display:inline-block;margin-top:10px;font-size:13px;}
 .profile-wiki{margin:24px 0 0;padding:16px;border:1px solid var(--ui-line);border-radius:var(--ui-radius-control,6px);}.profile-wiki legend{padding:0 6px;font-size:14px;font-weight:600;color:var(--theme-fg);}.profile-wiki legend span{font-size:12px;color:var(--muted);font-weight:400;}.profile-wiki label{font-size:13px;margin-top:10px;}.profile-wiki input{margin-right:8px;}.profile-wiki p{font-size:13px;color:var(--muted);margin:0;}.profile-wiki .profile-actions{margin-top:12px;}
 footer{display:flex;gap:12px;justify-content:space-between;flex-wrap:wrap;margin-top:24px;font-size:12px;color:var(--muted);}footer a{color:inherit;text-decoration:underline;}
 @media(max-width:500px){.supporter-profile{margin-top:28px;padding-inline:16px;}form{padding:20px;}h1{font-size:26px;}.profile-avatar{gap:12px;}}
</style>
