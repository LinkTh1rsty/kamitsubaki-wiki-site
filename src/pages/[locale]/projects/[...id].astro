---
import WikiArticleHeader from '../../../components/WikiArticleHeader.astro';
import { getBuildCollection as getCollection } from '../../../lib/contentAuditContext';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Reader from '../../../components/Reader.astro';
import ContentLicenseNotice from '../../../components/ContentLicenseNotice.astro';
import MemoryCorridorEntryLink from '../../../components/MemoryCorridorEntryLink.astro';
import { buildProjectDisplayData, getLocalizedSite } from '../../../lib/homeData.mjs';
import { buildLocaleLinks, defaultLocale, getEditableLocale, resolveLocaleCopy, supportedLocales } from '../../../lib/i18n.mjs';
import { buildProjectMetadata } from '../../../lib/metadata.mjs';
import { renderContentEntry } from '../../../lib/contentSource.mjs';
import { buildLocalizedStaticPaths } from '../../../lib/staticPaths.mjs';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');

  return buildLocalizedStaticPaths(projectEntries);
}

const { locale, id } = Astro.params;
const { entry } = Astro.props;
const { html: contentHtml, headings, body: articleBody } = await renderContentEntry(entry);
const localeCode = locale as 'zh' | 'zh-tw' | 'zh-hk' | 'ja' | 'en';
const siteEntries = await getCollection('site');
const homeContent = getLocalizedSite(siteEntries, localeCode, defaultLocale);
const project = buildProjectDisplayData(entry, localeCode);
const currentPath = `/projects/${id}`;
const localeLinks = buildLocaleLinks(homeContent, localeCode, currentPath);
const alternates = supportedLocales.map((localeCode) => ({
  locale: localeCode,
  href: `/${localeCode}/projects/${id}`,
}));
const metadata = buildProjectMetadata({
  data: project,
  body: articleBody,
  locale: localeCode,
  id,
});
const hasArticleBody = Boolean(articleBody);
const contentSourcePath = `src/content/projects/${id}/${getEditableLocale(localeCode)}.md`;
const sourceHref = `/${localeCode}/contribute/edit?target=${encodeURIComponent(contentSourcePath)}`;

const labels = resolveLocaleCopy({
  zh: {
    home: '首页', source: '编辑条目', languages: '切换语言',
    eyebrow: '项目条目',
    contents: '目录',
    emptyTitle: '资料正在整理',
    emptyBody: '这个项目已经建立观测入口，但可验证的资料仍待补充。欢迎从项目背景、时间线或关联作品开始完善。',
    emptyAction: '补充这个条目',
  },
  ja: {
    home: 'ホーム', source: '記事を編集', languages: '言語を切り替える',
    eyebrow: 'プロジェクト記事',
    contents: '目次',
    emptyTitle: '資料を整理中です',
    emptyBody: 'このプロジェクトの観測入口は用意されています。検証可能な資料は、背景・年表・関連作品から少しずつ補完できます。',
    emptyAction: 'この項目を補完する',
  },
  en: {
    home: 'Home', source: 'Edit article', languages: 'Change language',
    eyebrow: 'Project Article',
    contents: 'Contents',
    emptyTitle: 'Documentation in progress',
    emptyBody: 'This project already has an observation entry. Its verified background, timeline, and related works are ready to be documented.',
    emptyAction: 'Contribute to this entry',
  },
}, localeCode);
---

<BaseLayout reading lang={localeCode} alternates={alternates} title={`${project.title} - Kamitsubaki Studio Fan Wiki`} metadata={metadata}>
  <SiteNav navItems={homeContent.navItems} localeLinks={localeLinks} brandLines={homeContent.hero.brandLines} compact homeHref={`/${localeCode}/`} />

  <div class="fixed left-0 top-0 z-[60] h-px w-full origin-left bg-white/70" data-reading-progress></div>

  <main class="reader-frame reader-heading-frame mx-auto max-w-[92rem] px-4 pb-12 pt-24 sm:px-6 sm:pt-28 lg:pt-28">
    <WikiArticleHeader
      data={{ name: project.title, romanizedName: '', categoryTitle: project.categoryTitle, profileTagline: project.description }}
      localeLinks={localeLinks}
      labels={{ ...labels, section: labels.eyebrow }}
      sourceHref={sourceHref}
      homeHref={`/${localeCode}/`}
    />

    <Reader headings={headings} contentsTitle={labels.contents} hasContent={hasArticleBody}>
      <Fragment set:html={contentHtml} />
      <Fragment slot="empty">        <section class="wiki-empty-state mx-auto w-full max-w-2xl" aria-labelledby="project-empty-title">
          <h2 id="project-empty-title" class="mt-4 font-serif text-2xl text-white/88 sm:text-3xl">{labels.emptyTitle}</h2>
          <p class="mt-4 max-w-xl text-sm leading-7 text-white/62 sm:text-[15px] sm:leading-8">{labels.emptyBody}</p>
          <a href={sourceHref} class="wiki-empty-state__action mt-7">{labels.emptyAction}</a>
        </section></Fragment>
    </Reader>

    <div class="reader-end mx-auto mt-10 max-w-4xl">
      <MemoryCorridorEntryLink locale={localeCode} kind="project" entryId={id!} />
      <ContentLicenseNotice license={entry.data.license} locale={localeCode} />
    </div>
  </main>

  <SiteFooter footer={homeContent.footer} />
</BaseLayout>
