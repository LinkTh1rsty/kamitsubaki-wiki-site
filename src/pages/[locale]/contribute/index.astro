---
import {reviewCopy} from '../../../lib/reviewCopy.mjs';
import ContributionFlow from '../../../components/ContributionFlow.astro';
import {contributionFlowCopy} from '../../../lib/contributionFlowCopy.mjs';
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import WorkspaceLinkCard from '../../../components/WorkspaceLinkCard.astro';
import WorkspaceButton from '../../../components/WorkspaceButton.astro';
import {supportedLocales,resolveLocaleCopy} from '../../../lib/i18n.mjs';
import {knowledgeCopy} from '../../../lib/knowledgeCopy.mjs';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const {locale='zh'}=Astro.params;
const copy=resolveLocaleCopy({zh:{title:'参与共建',intro:'从一处补充开始。选择任务，保存草稿，提交审核。',home:'首页',docs:'贡献说明书',tasks:['编辑词条','投稿文章','上传照片'],notes:['补充资料、修正信息，保留来源。','记录观点与研究，可关联多个词条。','直接上传照片或创建设定组；逐张核对作者、出处与使用依据。'],progress:'我的投稿',load:'查看投稿进度',loading:'正在载入…',empty:'暂无投稿记录',error:'暂时无法载入，请重试。',login:'登录后查看',loginHint:'登录后可在这里查看词条、文章和图片投稿。',serviceUnavailable:'目前无法连接账号服务，请稍后重试。',open:'查看与继续',states:{draft:'草稿',pending:'待审核',approved:'已通过',rejected:'已退回',merged:'已合并',open:'审核中',closed:'已关闭',failed:'提交失败'}},en:{title:'Contribute',intro:'Start with one improvement. Choose a task, save a draft, submit for review.',home:'Home',docs:'Contribution manual',tasks:['Edit an entry','Write an article','Upload photos'],notes:['Improve information and preserve sources.','Share research and link relevant entries.','Upload standalone photos or create a design set; verify the author, source and basis for use of each image.'],progress:'My submissions',load:'View submission progress',loading:'Loading…',empty:'No submissions yet',error:'Unable to load. Please retry.',login:'Sign in to view',loginHint:'Sign in to see your entry, article and image submissions here.',serviceUnavailable:'The account service is unavailable. Please try again later.',open:'View and continue',states:{draft:'Draft',pending:'Pending',approved:'Approved',rejected:'Returned',merged:'Merged',open:'In review',closed:'Closed',failed:'Failed'}},ja:{title:'貢献する',intro:'一つの改善から。作業を選び、下書きを保存して審査へ。',home:'ホーム',docs:'投稿説明書',tasks:['項目を編集','記事を投稿','画像を投稿'],notes:['情報を補い、出典を残す。','考察を共有し、関連項目を選ぶ。','単独画像を投稿するか設定セットを作成し、画像ごとの作者・出典・利用根拠を確認します。'],progress:'自分の投稿',load:'投稿状況を確認',loading:'読み込み中…',empty:'投稿はまだありません',error:'読み込めません。再試行してください。',login:'ログインして確認',loginHint:'ログインすると、項目・記事・画像の投稿履歴を確認できます。',serviceUnavailable:'アカウントサービスに接続できません。後でもう一度お試しください。',open:'確認・編集',states:{draft:'下書き',pending:'審査待ち',approved:'承認済み',rejected:'差し戻し',merged:'反映済み',open:'審査中',closed:'終了',failed:'失敗'}}},locale);
const chronicleTask=resolveLocaleCopy({zh:{title:'投稿时间轴事件',note:'记录日期精度、关联词条与可核对来源。'},ja:{title:'年表の出来事を投稿',note:'日付の精度、関連項目、確認できる出典を記録します。'},en:{title:'Add a chronicle event',note:'Record date precision, related entries, and verifiable sources.'}},locale);
copy.tasks.push(chronicleTask.title);copy.notes.push(chronicleTask.note);
const activityTask=resolveLocaleCopy({zh:{title:'提交观测者企划',note:'登记聚会、应援与创作企划，补充日程、地区与来源。'},ja:{title:'観測者企画を投稿',note:'集まりや応援、創作企画の日程・地域・出典を登録します。'},en:{title:'Submit an observer project',note:'List meetups, support campaigns and creative projects with schedule, region and sources.'}},locale);
copy.tasks.push(activityTask.title);copy.notes.push(activityTask.note);
const paths=['contribute/editor/','articles/submit/','media/','chronicle/submit/','community/activities/apply/'];
const api=import.meta.env.PUBLIC_ARTICLE_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
---
<WorkspaceLayout locale={locale} title={copy.title} intro={copy.intro} path="/contribute/" eyebrow="CONTRIBUTE" width="wide" backHref={`/${locale}/`} backLabel={copy.home} mainAttributes={{'data-contribution-dashboard':'','data-api':api,'data-gallery-api':import.meta.env.PUBLIC_GALLERY_API_URL||api,'data-editor-api':import.meta.env.PUBLIC_EDITOR_API_BASE||api,'data-locale':locale,'data-copy':JSON.stringify(copy)}}>
 <WorkspaceButton slot="actions" href={`/${locale}/docs/contribute/`}>{copy.docs}</WorkspaceButton>
 <WorkspaceLinkCard href={`/${locale}/contribute/missing/`} title={knowledgeCopy(locale).title} description={knowledgeCopy(locale).intro} index="START" />
 <section>{paths.map((path,i)=><WorkspaceLinkCard href={`/${locale}/${path}`} title={copy.tasks[i]} description={contributionFlowCopy(locale)[(['entry','article','image','timeline','activity'] as const)[i]].route} index={String(i+1).padStart(2,'0')}/>)}</section>
 <ContributionFlow locale={locale}/>
 <section class="contribution-progress"><WorkspaceButton href={`/${locale}/contribute/review/`}>{reviewCopy(locale).title}</WorkspaceButton><h2>{copy.progress}</h2><WorkspaceButton data-progress-load>{copy.load}</WorkspaceButton><div data-progress-results aria-live="polite"></div></section>
</WorkspaceLayout>
<script>import '../../../scripts/contributionDashboard.js';</script>
<style>.contribution-progress{margin-top:40px;border-top:1px solid rgb(var(--theme-fg-rgb)/.15);padding-top:24px}.contribution-progress h2{font:22px var(--font-serif);margin-bottom:18px}.contribution-progress :global(article){padding:18px 0;border-bottom:1px solid rgb(var(--theme-fg-rgb)/.12)}.contribution-progress :global(p){font-size:13px;line-height:1.8;opacity:.7}.contribution-progress :global(a){font-size:12px;text-decoration:underline;text-underline-offset:4px}</style>
