---
import ContributionHubRedirect from '../../../components/ContributionHubRedirect.astro';
import { editorGuide } from '../../../lib/editorGuide.mjs';
import { getBuildCollection as getCollection } from '../../../lib/contentAuditContext';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ContributionNav from '../../../components/ContributionNav.astro';
import { getLocalizedSite } from '../../../lib/homeData.mjs';
import { buildLocaleLinks, defaultLocale, supportedLocales } from '../../../lib/i18n.mjs';
import { renderMarkdownFragment } from '../../../lib/markdown.mjs';
import '../../../styles/contributionGuide.css';

export function getStaticPaths() { return supportedLocales.map(locale => ({params:{locale}})); }
const localeCode = Astro.params.locale || 'zh';
const [sites, entries] = await Promise.all([getCollection('site'),getCollection('editGuide')]);
const homeContent = getLocalizedSite(sites,localeCode,defaultLocale);
const copy = entries.find(entry=>entry.data.locale===localeCode)?.data ?? entries.find(entry=>entry.data.locale===defaultLocale)?.data;
if (!copy) throw new Error('Missing contribution guide: '+localeCode);
const ui = copy.ui;
const flow = editorGuide(localeCode);
const lessons = await Promise.all(copy.lessons.map(async lesson=>({...lesson,html:await renderMarkdownFragment(lesson.body)})));
const workshops = await Promise.all(copy.workshops.map(async workshop=>({...workshop,html:await renderMarkdownFragment(workshop.body)})));
const localeLinks = buildLocaleLinks(homeContent,localeCode,'/contribute/edit');
const alternates = supportedLocales.map(locale=>({locale,href:'/'+locale+'/contribute/edit/'}));
const editorHref = '/'+localeCode+'/contribute/editor/';
const metadata = {title:copy.title,description:copy.intro,canonicalPath:'/'+localeCode+'/contribute/edit',type:'website' as const};
---
<BaseLayout reading lang={localeCode} title={copy.title} alternates={alternates} metadata={metadata}>
  <ContributionHubRedirect locale={localeCode} document="editor" />
  <SiteNav navItems={homeContent.navItems} localeLinks={localeLinks} brandLines={homeContent.hero.brandLines} compact homeHref={'/'+localeCode+'/'} />
  <main class="cg-shell" data-contribution-guide>
    <ContributionNav locale={localeCode} current="edit" />
    <header class="cg-hero"><p class="cg-eyebrow">{ui.eyebrow}</p><h1>{copy.title}</h1><p>{copy.intro}</p><div class="cg-actions"><a class="cg-button cg-button--primary" href="#workflow-choice">{ui.start}<span aria-hidden="true">↓</span></a><a class="cg-link" href={editorHref} data-editor-link>{ui.openEditor} →</a></div></header>
    <aside class="cg-target" data-target hidden><h2>{ui.target}</h2><code data-target-path></code><p data-target-hint></p><a class="cg-link" data-github-edit-link hidden>{ui.github} ↗</a></aside>
    <section class="cg-section" id="workflow-choice" aria-labelledby="workflow-title">
      <header class="cg-section-heading"><h2 id="workflow-title">{flow.choose}</h2><p>{flow.intro}</p></header>
      <nav class="cg-workflow-tabs" aria-label={flow.choose}>
        <a href="#editor-workflow" data-workflow="editor">{flow.editor}</a>
        <a href="#github-workflow" data-workflow="github">{flow.github}</a>
      </nav>
    </section>
    <section id="editor-workflow" class="cg-section cg-workflow" data-workflow-panel="editor" aria-labelledby="editor-workflow-title">
      <header class="cg-section-heading"><h2 id="editor-workflow-title">{flow.title}</h2><p>{flow.subtitle}</p></header>
      <p class="cg-scope">{flow.scope}</p>
      <ol class="cg-flow-steps">{flow.steps.map(([title,body]: string[],index: number)=><li><span aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}</ol>
      <div class="cg-actions"><a class="cg-button cg-button--primary" href={editorHref} data-editor-link>{flow.open} →</a><a class="cg-link" href={editorHref+'?view=submissions'}>{flow.submissions} →</a></div>
      <p class="cg-scope">{flow.reference}</p>
      <div class="cg-reference"><a href={'/'+localeCode+'/contribute/syntax/'}><strong>{ui.syntax} ↗</strong><p>{ui.syntaxHint}</p></a><a href={'/'+localeCode+'/contribute/format/'}><strong>{ui.format} ↗</strong><p>{ui.formatHint}</p></a></div>
    </section>
    <div id="github-workflow" data-workflow-panel="github">
      <section class="cg-section" aria-labelledby="github-workflow-title"><header class="cg-section-heading"><h2 id="github-workflow-title">{flow.githubTitle}</h2><p>{flow.githubIntro}</p></header><ol class="cg-flow-steps">{flow.githubSteps.map(([title,body]: string[],index: number)=><li><span aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}</ol></section>
    <section id="choose-guide" class="cg-section" aria-labelledby="cg-choose-title">
      <header class="cg-section-heading"><h2 id="cg-choose-title">{ui.choose}</h2><p>{ui.chooseHint}</p></header>
      <div class="cg-task-grid" role="group" aria-label={ui.choose}>{copy.tasks.map((task,index)=><button class="cg-task" data-guide-task={task.id} data-next={task.next} aria-pressed={index===0?'true':'false'} aria-controls="cg-task-hint"><small>{task.time}</small><strong>{task.title}</strong><span>{task.description}</span></button>)}</div>
      <p class="cg-route" id="cg-task-hint"><strong>{ui.route}</strong><span data-task-hint aria-live="polite">{copy.tasks[0].next}</span></p>
      <a class="cg-link" data-task-action href="#lesson-load">{ui.taskAction} →</a>
    </section>
    <div class="cg-learning">
      <aside class="cg-rail"><div class="cg-rail-heading"><span id="cg-progress-label">{ui.progress}</span><span data-progress-count aria-live="polite">0 / 6</span></div><progress data-guide-progress max="6" value="0" aria-labelledby="cg-progress-label"></progress>
        <nav aria-label={ui.journey}>{lessons.map((lesson,index)=><a href={'#lesson-'+lesson.id} data-lesson-link={lesson.id}><span>{String(index+1).padStart(2,'0')}</span>{lesson.title}</a>)}</nav>
        <a class="cg-link" href="#lesson-choose" data-resume>{ui.continue} →</a><p data-storage-note role="status">{ui.storage}</p><button class="cg-reset" data-reset-progress>{ui.reset}</button>
      </aside>
      <div class="cg-content">
        <section aria-labelledby="cg-journey-title"><header class="cg-section-heading"><h2 id="cg-journey-title">{ui.journey}</h2><p>{ui.journeyHint}</p></header>
          <div>{lessons.map((lesson,index)=><details id={'lesson-'+lesson.id} class="cg-lesson" data-guide-step={lesson.id} open={index===0}>
            <summary><span class="cg-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><h3>{lesson.title}</h3><p>{lesson.summary}</p></div></summary>
            <div class="cg-lesson-body"><div class="cg-prose wiki-reader wiki-prose prose max-w-none"><Fragment set:html={lesson.html}/></div><p class="cg-checkpoint">{lesson.checkpoint}</p>
              <div class="cg-lesson-actions"><button class="cg-button" data-step-complete={lesson.id} aria-pressed="false">{ui.complete}</button>
                {lesson.id==='choose' && <a class="cg-link" href={'/'+localeCode+'/songs/'}>{ui.example} →</a>}
                {lesson.id==='load' && <a class="cg-link" href={editorHref} data-editor-link>{ui.openEditor} →</a>}
                {index < lessons.length - 1 && <a class="cg-link" href={'#lesson-'+lessons[index+1].id}>{ui.continue} →</a>}
                {lesson.id==='submit' && <a class="cg-link" href="#pr-template">{ui.pr} ↓</a>}
              </div>
            </div>
          </details>)}</div>
        </section>
        <section id="editor-map" class="cg-section" aria-labelledby="cg-map-title"><header class="cg-section-heading"><h2 id="cg-map-title">{ui.mapTitle}</h2><p>{ui.mapHint}</p></header><dl class="cg-map">{copy.map.map(item=><div><dt>{item.title}</dt><dd>{item.body}</dd></div>)}</dl><div class="cg-actions"><a class="cg-link" href={editorHref} data-editor-link>{ui.openEditor} →</a></div></section>
        <section class="cg-section cg-workshops" aria-labelledby="cg-workshops-title"><header class="cg-section-heading"><h2 id="cg-workshops-title">{ui.workshops}</h2><p>{ui.workshopsHint}</p></header>
          {workshops.map(workshop=><details class="cg-lesson" id={'workshop-'+workshop.id}><summary><div><h3>{workshop.title}</h3><p>{workshop.summary}</p></div></summary><div class="cg-lesson-body"><div class="cg-prose wiki-reader wiki-prose prose max-w-none"><Fragment set:html={workshop.html}/></div><a class="cg-link" href={'/'+localeCode+'/contribute/syntax/'}>{ui.syntax} →</a></div></details>)}
        </section>
        <section class="cg-section" id="syntax-reference" aria-labelledby="cg-reference-title"><header class="cg-section-heading"><h2 id="cg-reference-title">{ui.reference}</h2></header><div class="cg-reference"><a href={'/'+localeCode+'/contribute/syntax/'}><strong>{ui.syntax} ↗</strong><p>{ui.syntaxHint}</p></a><a href={'/'+localeCode+'/contribute/format/'}><strong>{ui.format} ↗</strong><p>{ui.formatHint}</p></a></div></section>
        <section class="cg-section cg-review" aria-labelledby="cg-review-title"><header class="cg-section-heading"><h2 id="cg-review-title">{ui.review}</h2></header><ul>{copy.checklist.map(item=><li>{item}</li>)}</ul></section>
        <section class="cg-section" id="pr-template" aria-labelledby="cg-pr-title"><header class="cg-section-heading"><h2 id="cg-pr-title">{ui.pr}</h2><p>{ui.prHint}</p></header><button class="cg-button" data-copy-pr>{ui.copy}</button><p class="cg-copy-status" data-copy-status role="status"></p><textarea class="cg-template" readonly data-pr-template aria-labelledby="cg-pr-title" rows="12">{copy.prTemplate}</textarea></section>
        <section class="cg-section cg-faq" aria-labelledby="cg-faq-title"><header class="cg-section-heading"><h2 id="cg-faq-title">{ui.faq}</h2></header>{copy.faqs.map(faq=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
        <section class="cg-section cg-finish" id="guide-finish"><header class="cg-section-heading"><h2>{ui.finish}</h2><p>{ui.finishBody}</p></header><a class="cg-button cg-button--primary" href={editorHref} data-editor-link>{ui.openEditor} →</a><header class="cg-section-heading cg-section"><a class="cg-link" href="https://github.com/LinkTh1rsty/kamitsubaki-wiki-site/issues">{ui.issues} ↗</a><p>{ui.issuesHint}</p></header></section>
      </div>
    </div>
    </div>
    <script is:inline type="application/json" data-guide-copy set:html={JSON.stringify(ui).replace(/</g,'\\u003c')} />
  </main>
  <SiteFooter footer={homeContent.footer} />
  <script>import '../../../scripts/contributionGuide.js';</script>
</BaseLayout>
