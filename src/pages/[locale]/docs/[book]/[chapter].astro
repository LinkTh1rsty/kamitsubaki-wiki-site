---
import DocsLayout from '../../../../layouts/DocsLayout.astro';
import Reader from '../../../../components/Reader.astro';
import Icon from '../../../../components/Icon.astro';
import {supportedLocales} from '../../../../lib/i18n.mjs';
import {docsCopy} from '../../../../lib/docsCopy.mjs';
import {getManualCatalog,getManualChapter,getManualPaths} from '../../../../lib/docsCenter.mjs';
export async function getStaticPaths(){const paths=await getManualPaths();return supportedLocales.flatMap(locale=>paths.map(({book,chapter})=>({params:{locale,book,chapter}})));}
const {locale='zh',book='site',chapter='start'}=Astro.params;
const entry=await getManualChapter(book,chapter,locale) as Awaited<ReturnType<typeof getManualChapter>> & {html:string;headings:{depth:number;slug:string;text:string}[]};
const chapters=(await getManualCatalog(locale)).find(item=>item.id===book)?.chapters||[];
const position=chapters.findIndex(item=>item.slug===chapter),previous=chapters[position-1],next=chapters[position+1],copy=docsCopy(locale);
---
<DocsLayout locale={locale} title={entry.data.title} summary={entry.data.summary} book={book} chapter={chapter}>
 <Reader variant="guide" headings={entry.headings} contentsTitle={copy.contents}><Fragment set:html={entry.html}/></Reader>
 <nav class="docs-neighbors" aria-label={copy.navigation}>
  {previous?<a href={previous.href}><small><Icon name="arrow-left"/>{copy.previous}</small><strong>{previous.title}</strong></a>:<span/>}
  {next?<a href={next.href}><small>{copy.next}<Icon name="arrow-right"/></small><strong>{next.title}</strong></a>:<span/>}
 </nav>
</DocsLayout>
