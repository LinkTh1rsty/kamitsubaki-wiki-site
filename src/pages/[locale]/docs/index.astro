---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Icon from '../../../components/Icon.astro';
import {supportedLocales} from '../../../lib/i18n.mjs';
import {docsCopy} from '../../../lib/docsCopy.mjs';
import {getManualCatalog} from '../../../lib/docsCenter.mjs';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const {locale='zh'}=Astro.params,copy=docsCopy(locale),books=await getManualCatalog(locale);
---
<DocsLayout locale={locale} title={copy.title} summary={copy.intro}>
 <div class="docs-books">{books.map((book,index)=><section id={`docs-book-${book.id}`}><p class="docs-eyebrow">0{index+1}</p><h2><a href={book.href}>{copy.books[book.id]} <Icon name="arrow-up-right"/></a></h2><p>{book.description}</p><ul>{book.chapters.map(chapter=><li><a href={chapter.href}>{chapter.title}</a></li>)}</ul><a class="docs-browse" href={book.href}>{copy.browse}<Icon name="arrow-right"/></a></section>)}</div>
 <section class="docs-practice"><h2><a href={`/${locale}/contribute/edit/`}>{copy.practice}<Icon name="arrow-up-right"/></a></h2><p>{copy.practiceNote}</p></section>
</DocsLayout>
