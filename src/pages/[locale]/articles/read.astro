---
import LoadingStatus from '../../../components/LoadingStatus.astro';
import IconLabel from '../../../components/IconLabel.astro';
import Icon from '../../../components/Icon.astro';
import {articleCopy} from '../../../lib/articleCopy.mjs';
import ContextAction from '../../../components/ContextAction.astro';
import 'katex/dist/katex.min.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';import SiteNav from '../../../components/SiteNav.astro';import SiteFooter from '../../../components/SiteFooter.astro';import SharePopover from '../../../components/SharePopover.astro';
import {getCollection} from 'astro:content';import {getLocalizedSite} from '../../../lib/homeData.mjs';import {buildLocaleLinks} from '../../../lib/i18n.mjs';import {entityLocales} from '../../../lib/entityRegistry.mjs';import '../../../styles/articleWorkspace.css';
export function getStaticPaths(){return entityLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!,site=getLocalizedSite(await getCollection('site'),locale),api=import.meta.env.PUBLIC_ARTICLE_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
const copy=articleCopy(locale);
---
<BaseLayout title={`${copy.title} · Kamitsubaki Wiki`} lang={locale} reading metadata={{noindex:true}}>
<SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/articles/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
<main class="article-reader" data-article-page="read" data-article-api={api} data-locale={locale}>
 <div class="article-reader-toolbar">
  <a class="article-reader-back" href={`/${locale}/articles/`}><Icon name="arrow-left" /> {copy.backToArticles}</a>
  <div class="article-reader-actions"><SharePopover locale={locale} deferred /><ContextAction data-article-edit hidden><IconLabel text={copy.edit}/></ContextAction><ContextAction data-article-contribute href={`/${locale}/articles/submit/`}>{locale==='en'?'Write an article':locale==='ja'?'記事を投稿':'投稿文章'}</ContextAction></div>
 </div>
 <div class="article-reading-layout" data-reader data-reader-variant="entry">
  <header class="article-reader-header">
   <h1 data-article-title><LoadingStatus label={copy.loading}/></h1>
   <p data-article-summary></p>
   <p role="status" data-article-status></p>
   <button class="article-reader-retry" type="button" data-article-retry hidden>{copy.retry}</button>
  </header>
  <aside class="article-reader-info">
   <div data-article-meta></div>
   <details class="article-related" data-article-related-panel hidden open><summary>{copy.related}</summary><div data-article-related class="article-related-links"></div></details>
   <details class="article-toc" data-article-toc-panel hidden open><summary>{copy.toc}</summary><nav aria-label={copy.toc} data-article-toc></nav></details>
  </aside>
  <div class="article-reader-content">
   <article class="wiki-reader wiki-prose prose max-w-none" data-article-body></article>
   <footer class="article-reader-end" data-article-end hidden><a href={`/${locale}/articles/`}><Icon name="arrow-left" /> {copy.backToArticles}</a></footer>
  </div>
 </div>
</main><SiteFooter footer={site.footer}/></BaseLayout>
<script>import {initArticleBrowser} from '../../../lib/articleClient';initArticleBrowser(document.querySelector<HTMLElement>('[data-article-page]')!);</script>
