---
import AboutSection from '../../components/AboutSection.astro';
import HomeMusicSection from '../../components/HomeMusicSection.astro';
import HomeArticles from '../../components/HomeArticles.astro';
import HomeExplore from '../../components/HomeExplore.astro';
import HomeDirectory from '../../components/HomeDirectory.astro';
import {getEntityRegistry} from '../../lib/entityRegistry.mjs';
import {buildEntityMusicCatalog} from '../../lib/entityViews.mjs';
import ContributorRoster from '../../components/ContributorRoster.astro';
import ExperiencePortals from '../../components/ExperiencePortals.astro';
import Hero from '../../components/Hero.astro';
import HomeSiteNav from '../../components/HomeSiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SupportBanner from '../../components/SupportBanner.astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBuildCollection as getCollection } from '../../lib/contentAuditContext';
import { getLocalizedSite } from '../../lib/homeData.mjs';
import { sampleRandom } from '../../lib/homeMusicCatalog.mjs';
import { buildLocaleLinks, defaultLocale, supportedLocales } from '../../lib/i18n.mjs';
import { buildHomeMetadata } from '../../lib/metadata.mjs';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const siteEntries = await getCollection('site');
const homeContent = getLocalizedSite(siteEntries, locale, defaultLocale);
const registry=await getEntityRegistry();
const homeMusicCatalog = buildEntityMusicCatalog(registry, locale);
const songs = sampleRandom(homeMusicCatalog.songs, 5);
const albums = sampleRandom(homeMusicCatalog.albums, 5);

const localeLinks = buildLocaleLinks(homeContent, locale);
const alternates = supportedLocales.map((localeCode) => ({
  locale: localeCode,
  href: `/${localeCode}/`,
}));
const metadata = buildHomeMetadata(homeContent, locale);
---

<BaseLayout lang={locale} alternates={alternates} metadata={metadata}>
  <div data-page-context-root>
    <HomeSiteNav navItems={homeContent.navItems} localeLinks={localeLinks} brandLines={homeContent.hero.brandLines} homeHref={`/${locale}/`} />
    <Hero hero={homeContent.hero} />
    <HomeDirectory locale={locale} section={homeContent.sections.database}/>
    <HomeMusicSection songs={songs} albums={albums} sections={homeContent.sections} locale={locale}/>
    <HomeArticles locale={locale}/>
    <HomeExplore locale={locale}/>
    <ContributorRoster mode="summary" locale={locale} />
    <AboutSection content={{...homeContent.sections.about,heading:'PREFACE'}}>
      <ExperiencePortals slot="explore" locale={locale} compact />
    </AboutSection>
    <SupportBanner locale={locale ?? defaultLocale} />
    <SiteFooter footer={homeContent.footer} />
  </div>

  <script>
    import { initializeHomeMusicRandomizer } from '../../scripts/homeMusicRandomizer.js';

    initializeHomeMusicRandomizer();
  </script>
</BaseLayout>
