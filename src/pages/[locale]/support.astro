---
import WorkspaceButton from '../../components/WorkspaceButton.astro';
import AfdianWidget from '../../components/AfdianWidget.astro';
import SupportHero from '../../components/SupportHero.astro';
import Icon from '../../components/Icon.astro';
import WorkspaceShell from '../../components/WorkspaceShell.astro';
import {getBuildCollection as getCollection} from '../../lib/contentAuditContext';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WorkspaceHeader from '../../components/WorkspaceHeader.astro';
import WorkspaceNavigation from '../../components/WorkspaceNavigation.astro';
import {getLocalizedSite} from '../../lib/homeData.mjs';
import {buildLocaleLinks,defaultLocale,supportedLocales} from '../../lib/i18n.mjs';
import {getSupportCopy} from '../../data/supportCopy';
import {getSupportData} from '../../lib/support';
import {renderSupportData,renderSupportOverview} from '../../lib/supportView.mjs';
import {supportExperienceCopy} from '../../lib/supportExperienceCopy.mjs';
import '../../styles/support.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale??defaultLocale,homeContent=getLocalizedSite(await getCollection('site'),locale,defaultLocale),copy=getSupportCopy(locale),c=supportExperienceCopy(locale);
const apiBase=import.meta.env.PUBLIC_SUPPORT_API_BASE||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const data=getSupportData(),view=renderSupportData({...data,sponsors:data.sponsors.filter(item=>item.public),annualReports:data.annualReports.map(report=>({...report,entries:report.entries||[]}))},copy,locale,apiBase,true);
const currentPath='/support/',metadata={title:`${copy.title} - Kamitsubaki Studio Fan Wiki`,description:copy.intro,canonicalPath:`/${locale}${currentPath}`};
---
<BaseLayout lang={locale} metadata={metadata} alternates={supportedLocales.map(code=>({locale:code,href:`/${code}${currentPath}`}))}>
 <SiteNav navItems={homeContent.navItems} localeLinks={buildLocaleLinks(homeContent,locale,currentPath)} brandLines={homeContent.hero.brandLines} homeHref={`/${locale}/`}/>
 <WorkspaceShell width="wide" class="support-shell" data-support-page data-api-base={apiBase} data-locale={locale}>
  <script is:inline type="application/json" data-support-copy set:html={JSON.stringify(copy).replace(/</g,'\u003c')}/>
  <WorkspaceHeader title={copy.heroTitle} intro={copy.intro} eyebrow="SUPPORT THE OBSERVATORY" backHref={`/${locale}/`} backLabel={copy.home}/>
  <SupportHero locale={locale}/>
  <section class="support-overview" aria-label={copy.reportLabel}>
   <div class="support-overview-actions"><a class="support-text-link" href={`/${locale}/contribute/`}>{copy.contribute}</a><a class="support-text-link" href="#transparency">{copy.seeReports}</a></div>
   <div data-support-overview set:html={renderSupportOverview(data,copy,locale)}/>
  </section>
  <WorkspaceNavigation label={copy.pageNav} kind="support">{[{id:'ways-to-support',label:copy.navChannels},{id:'running-costs',label:copy.navCosts},{id:'transparency',label:copy.navReports},{id:'sponsor-wall',label:copy.navWall}].map(item=><a id={`support-tab-${item.id}`} href={`#${item.id}`} data-support-tab={item.id}>{item.label}</a>)}</WorkspaceNavigation>
  <div class="support-live-status"><p class="support-note" data-support-status role="status"></p><WorkspaceButton data-support-retry hidden>{copy.retry}<Icon name="history"/></WorkspaceButton></div>
  <div class="support-panels">
   <section class="support-section support-ways" id="ways-to-support" data-support-panel aria-label={copy.channelsTitle}>
    <div class="support-heading support-other-heading"><p class="support-eyebrow">DIRECT SUPPORT</p><h2>{copy.channelsTitle}</h2><p>{copy.channelsIntro}</p></div>
    <div class="support-channels" data-support-channels set:html={view.channels}/>
    <p class="support-free-note">{copy.freeNote}</p>
    <AfdianWidget locale={locale}/>
   </section>
   <section class="support-section support-costs" id="running-costs" data-support-panel aria-labelledby="support-costs-title"><div class="support-heading"><p class="support-eyebrow">PROJECT UPKEEP</p><h2 id="support-costs-title">{copy.costsTitle}</h2><p>{copy.costsIntro}</p></div><div data-support-costs set:html={view.costs}/></section>
   <section class="support-section support-transparency" id="transparency" data-support-panel aria-labelledby="support-transparency-title"><div class="support-heading"><p class="support-eyebrow">TRANSPARENCY</p><h2 id="support-transparency-title">{copy.reportsTitle}</h2><p>{copy.reportsIntro}</p></div><div class="support-records"><div class="support-reports" data-support-reports set:html={view.reports}/><p class="support-note support-accounting">{copy.accountingNote}</p></div></section>
   <section class="support-section support-thanks" id="sponsor-wall" data-support-panel aria-labelledby="support-wall-title"><div class="support-heading"><p class="support-eyebrow">OUR OBSERVERS</p><h2 id="support-wall-title">{copy.wallTitle}</h2><p>{copy.wallIntro}</p></div><div data-support-wall set:html={view.wall}/><p class="support-wall-help">{c.wallHelp}</p><p class="support-note">{copy.wallPrivacy}</p></section>
  </div>
  <aside class="support-disclaimer" aria-labelledby="support-disclaimer-title"><h2 id="support-disclaimer-title">{copy.disclaimerTitle}</h2><div>{copy.disclaimer.map(paragraph=><p>{paragraph}</p>)}</div></aside>
 </WorkspaceShell>
 <SiteFooter footer={homeContent.footer}/>
 <script>import '../../scripts/supportNavigation.js';import '../../scripts/supportPage.js';</script>
</BaseLayout>
