---
import HelpTip from '../../../components/HelpTip.astro';
import {contributionFlowCopy} from '../../../lib/contributionFlowCopy.mjs';
import LoadingStatus from '../../../components/LoadingStatus.astro';
import {reviewCopy} from '../../../lib/reviewCopy.mjs';
import WorkspaceButton from '../../../components/WorkspaceButton.astro';
import WorkspaceControl from '../../../components/WorkspaceControl.astro';
import Icon from '../../../components/Icon.astro';
import {imageLibraryCopy} from '../../../lib/imageLibraryCopy.mjs';
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import WorkspaceFilters from '../../../components/WorkspaceFilters.astro';
import AccountSections from '../../../components/AccountSections.astro';
import {supportedLocales} from '../../../lib/i18n.mjs';
import {editorApiBase} from '../../../lib/editorConfig.mjs';
import {creatorCenterCopy} from '../../../lib/creatorCenterCopy.mjs';
import '../../../styles/account.css';
import '../../../styles/creatorWorkspace.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale||'zh',c=creatorCenterCopy(locale);
const api=import.meta.env.PUBLIC_ARTICLE_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const create=[['entry',c.newEntry,`/${locale}/contribute/editor/`],['article',c.newArticle,`/${locale}/articles/submit/`],['gallery',c.newGallery,`/${locale}/media/`],['timeline',c.newTimeline,`/${locale}/chronicle/submit/`],['community',c.community,`/${locale}/community/activities/apply/`]];
---
<WorkspaceLayout locale={locale} title={c.title} intro={c.intro} path="/account/creator/" eyebrow="CREATOR SPACE" backHref={`/${locale}/account/`} backLabel={c.back} width="wide" noindex mainAttributes={{'class':'account-shell creator-page','data-creator-center':'','data-locale':locale,'data-api':api,'data-editor-api':editorApiBase,'data-copy':JSON.stringify(c)}}>
  <Fragment slot="actions"><WorkspaceButton href={`/${locale}/contribute/review/`}>{reviewCopy(locale).title}</WorkspaceButton><a class="creator-create-link" href={`/${locale}/contribute/`}>{c.create} <Icon name="arrow-right" /></a></Fragment>
  <div class="account-workspace"><AccountSections locale={locale} active="creator"/><div class="account-panels creator-content"><div class="creator-main">
    <p data-creator-status role="status" class="creator-status"><LoadingStatus label={c.loading}/></p>
    <section class="creator-guest" data-creator-guest hidden><div class="creator-guest-intro"><h2>{c.guestStart}</h2><p>{c.loginHint}</p><div><a class="creator-login" data-creator-login href={`/${locale}/account/?returnTo=${encodeURIComponent(`/${locale}/account/creator/`)}`}>{c.signIn} <Icon name="arrow-right" /></a><a href={`/${locale}/contribute/`}>{c.guestGuide} <Icon name="arrow-right" /></a></div></div><div class="creator-guest-options">{create.map(([type,label,href])=><a href={href}><span>{c[type]}</span><strong>{label}</strong><b aria-hidden="true"><Icon name="arrow-right" /></b></a>)}</div></section>
    <section class="creator-workflow" aria-label={c.create}>
      <div class="creator-heading"><h2>{c.create}</h2><a href={`/${locale}/media/`}>{imageLibraryCopy(locale).title} <Icon name="arrow-right" /></a></div>
      <div class="creator-workflow-actions">{create.map(([type,label,href])=><a href={href}><span>{c[type]}</span><strong>{label} <Icon name="arrow-right" /></strong></a>)}</div>
      
    </section>
    <div class="creator-start-grid">
      <section class="creator-section creator-todo" aria-labelledby="creator-todo-title" hidden><div class="creator-heading"><div><span>ACTION</span><h2 id="creator-todo-title">{c.todo}</h2></div><span data-todo-count></span></div><div data-creator-todo><p><LoadingStatus label={c.loading}/></p></div></section>
      <section class="creator-section creator-local" aria-labelledby="creator-local-title" hidden><div class="creator-heading"><div><span>DRAFTS</span><h2 id="creator-local-title">{c.local}<HelpTip label={c.local} text={c.localNote}/></h2></div></div><div data-creator-drafts></div></section>
    </div>
    <div class="creator-secondary-grid">
      <section class="creator-section creator-notifications" aria-labelledby="creator-notifications-title" hidden><div class="creator-heading"><div><span>UPDATES</span><h2 id="creator-notifications-title">{c.notifications}</h2></div><span data-notification-count></span></div><div data-creator-notifications><p><LoadingStatus label={c.loading}/></p></div></section>
      <section class="creator-section creator-overview" aria-labelledby="creator-dashboard-title" hidden><div class="creator-heading"><div><span>OVERVIEW</span><h2 id="creator-dashboard-title">{c.dashboard}<HelpTip label={c.review} text={contributionFlowCopy(locale).entry.note}/></h2></div></div><div class="creator-metrics">{(['attention','draft','review','published'] as const).map(key=><WorkspaceButton type="button" data-metric={key}><span>{c[key]}</span><strong data-metric-count={key}>—</strong></WorkspaceButton>)}</div></section>
    </div>
    <section class="creator-section creator-records-section" aria-labelledby="creator-records-title" hidden><div class="creator-heading"><div><span>ARCHIVE</span><h2 id="creator-records-title">{c.records}<HelpTip label={c.withdraw} text={c.withdrawHelp}/><HelpTip label={c.deleteSubmission} text={c.deleteHelp}/></h2></div></div>
      <WorkspaceFilters collapsible data-creator-filters class="creator-filters" role="search"><label>{c.search}<WorkspaceControl name="q" type="search" autocomplete="off"/></label><label>{c.type}<WorkspaceControl as="select" name="type"><option value="">{c.all}</option>{(['entry','article','gallery','timeline','community'] as const).map(key=><option value={key}>{c[key]}</option>)}</WorkspaceControl></label><label>{c.state}<WorkspaceControl as="select" name="state"><option value="">{c.all}</option>{(['attention','review','published','draft','withdrawn'] as const).map(key=><option value={key}>{c[key]}</option>)}</WorkspaceControl></label><WorkspaceButton type="button" data-creator-refresh>{c.retry}</WorkspaceButton></WorkspaceFilters>
      <div class="creator-record-list" data-creator-rows></div>
      <div class="creator-pagination"><span data-records-status role="status"></span><div><WorkspaceButton type="button" data-page-previous>{c.previous}</WorkspaceButton><WorkspaceButton type="button" data-page-next>{c.next}</WorkspaceButton></div></div>
    </section>
  </div><aside class="creator-detail" data-creator-detail hidden role="dialog" aria-labelledby="creator-detail-title"><div class="creator-detail-head"><span>{c.records}</span><WorkspaceButton type="button" data-detail-close>{c.close}</WorkspaceButton></div><div data-detail-content></div><footer class="creator-detail-footer" data-detail-footer></footer></aside></div></div>
  <div class="creator-detail-backdrop" data-detail-backdrop hidden></div>
</WorkspaceLayout>
<script>import '../../../scripts/creatorCenter.js';</script>
