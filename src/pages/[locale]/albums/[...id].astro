---
import { getCollection } from 'astro:content';
import AlbumInfoBox from '../../../components/AlbumInfoBox.astro';
import MusicSubnav from '../../../components/MusicSubnav.astro';
import ContributorRoster from '../../../components/ContributorRoster.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteNav from '../../../components/SiteNav.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import WikiArticleHeader from '../../../components/WikiArticleHeader.astro';
import ContentLicenseNotice from '../../../components/ContentLicenseNotice.astro';
import MemoryCorridorEntryLink from '../../../components/MemoryCorridorEntryLink.astro';
import EntryCompleteness from '../../../components/EntryCompleteness.astro';
import MissingDataNotice from '../../../components/MissingDataNotice.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedSite } from '../../../lib/homeData.mjs';
import { buildLocaleLinks, defaultLocale, getEditableLocale, resolveLocaleCopy, supportedLocales } from '../../../lib/i18n.mjs';
import { buildArticleMetadata } from '../../../lib/metadata.mjs';
import { renderContentEntry } from '../../../lib/contentSource.mjs';
import { buildLocalizedStaticPaths } from '../../../lib/staticPaths.mjs';
import { completenessTier, computeCompleteness } from '../../../lib/entryCompleteness.mjs';
import { buildContentIndex, detectEntryIssues, summarizeIssues } from '../../../lib/missingData.mjs';

export async function getStaticPaths() {
  const albumEntries = await getCollection('albums');

  return buildLocalizedStaticPaths(albumEntries);
}

const { locale, id } = Astro.params;
const { entry } = Astro.props;
const { html: contentHtml, headings, body: articleBody } = await renderContentEntry(entry);
const localeCode = locale as 'zh' | 'zh-tw' | 'zh-hk' | 'ja' | 'en';
const hasArticleBody = Boolean(articleBody);
const hasTracks = Boolean(entry.data.tracks?.length);
const hasMainContent = hasArticleBody || hasTracks;
const hasTableOfContents = hasArticleBody && headings.some((heading) => heading.depth === 2 || heading.depth === 3);

const siteEntries = await getCollection('site');
const songEntries = await getCollection('songs');
const localizedSongIds = new Set(
  songEntries
    .filter((song) => song.data.locale === localeCode)
    .map((song) => song.id.split('/').slice(0, -1).join('/')),
);
const homeContent = getLocalizedSite(siteEntries, localeCode, defaultLocale);
const currentPath = `/albums/${id}`;
const localeLinks = buildLocaleLinks(homeContent, localeCode, currentPath);
const alternates = supportedLocales.map((code) => ({ locale: code, href: `/${code}/albums/${id}` }));

const articleLabels = resolveLocaleCopy({
  zh: {
    home: '首页', albums: '专辑', article: 'Wiki 条目', category: '分类', source: '编辑条目', languages: '切换语言',
    contents: '目录', infobox: '专辑信息', artist: '艺人', type: '类型', releaseDate: '发行日期', label: '发行厂牌',
    catalogNumber: '商品编号', trackCount: '曲目数', duration: '总时长', officialLinks: '官方链接', coverPlaceholder: '暂无专辑封面',
    tracklist: '曲目列表', disc: '碟片', track: '曲目', trackArtist: '艺人', trackDuration: '时长', albumFallback: '专辑作品',
    completeness: {
      kicker: 'ENTRY COMPLETENESS',
      scoreLabel: '条目完整度',
      missingLabel: '缺失字段',
      missingSummary: '查看缺失字段',
      missingEmpty: '可选字段已齐全。',
      tiers: { complete: '完整', good: '良好', brief: '简要', stub: '草稿' },
      fieldLabels: {
        image: '封面图', releaseDate: '发行日期', tracks: '曲目列表', type: '类型', label: '发行厂牌',
        catalogNumber: '商品编号', trackCount: '曲目数', description: '简介', romanizedTitle: '罗马字标题', officialLinks: '官方链接',
      },
    },
  },
  ja: {
    home: 'ホーム', albums: 'アルバム', article: 'Wiki 記事', category: '分類', source: '記事を編集', languages: '言語を切り替え',
    contents: '目次', infobox: 'アルバム情報', artist: 'アーティスト', type: '種類', releaseDate: 'リリース日', label: 'レーベル',
    catalogNumber: '規格品番', trackCount: '曲数', duration: '総時間', officialLinks: '公式リンク', coverPlaceholder: 'ジャケット未登録',
    tracklist: '収録曲', disc: 'ディスク', track: '曲名', trackArtist: 'アーティスト', trackDuration: '時間', albumFallback: 'アルバム作品',
    completeness: {
      kicker: 'ENTRY COMPLETENESS',
      scoreLabel: '記事完成度',
      missingLabel: '不足フィールド',
      missingSummary: '不足フィールドを見る',
      missingEmpty: '任意項目は揃っています。',
      tiers: { complete: '完備', good: '良好', brief: '概要', stub: '草稿' },
      fieldLabels: {
        image: 'カバー画像', releaseDate: 'リリース日', tracks: '収録曲', type: '種類', label: 'レーベル',
        catalogNumber: '規格品番', trackCount: '曲数', description: '紹介', romanizedTitle: 'ローマ字タイトル', officialLinks: '公式リンク',
      },
    },
  },
  en: {
    home: 'Home', albums: 'Albums', article: 'Wiki Article', category: 'Category', source: 'Edit article', languages: 'Switch language',
    contents: 'Contents', infobox: 'Album Info', artist: 'Artist', type: 'Type', releaseDate: 'Release Date', label: 'Label',
    catalogNumber: 'Catalog No.', trackCount: 'Tracks', duration: 'Duration', officialLinks: 'Official Links', coverPlaceholder: 'No cover available',
    tracklist: 'Track listing', disc: 'Disc', track: 'Track', trackArtist: 'Artist', trackDuration: 'Duration', albumFallback: 'Album works',
    completeness: {
      kicker: 'ENTRY COMPLETENESS',
      scoreLabel: 'Entry completeness',
      missingLabel: 'Missing fields',
      missingSummary: 'View missing fields',
      missingEmpty: 'All optional fields are present.',
      tiers: { complete: 'Complete', good: 'Good', brief: 'Brief', stub: 'Stub' },
      fieldLabels: {
        image: 'Cover image', releaseDate: 'Release date', tracks: 'Track listing', type: 'Type', label: 'Label',
        catalogNumber: 'Catalog no.', trackCount: 'Track count', description: 'Description', romanizedTitle: 'Romanized title', officialLinks: 'Official links',
      },
    },
  },
}, localeCode);

const contentSourcePath = `src/content/albums/${id}/${getEditableLocale(localeCode)}.md`;
const sourceHref = `/${localeCode}/contribute/edit?target=${encodeURIComponent(contentSourcePath)}`;
const articleData = {
  ...entry.data,
  name: entry.data.title,
  romanizedName: entry.data.romanizedTitle ?? entry.data.artist,
  profileTagline: entry.data.description,
  categoryTitle: entry.data.categoryTitle ?? entry.data.type ?? articleLabels.albumFallback,
  categorySubtitle: entry.data.categorySubtitle ?? entry.data.artist,
  statusLabel: entry.data.releaseDate ? articleLabels.releaseDate : undefined,
  status: entry.data.releaseDate,
  meta: entry.data.artist,
};
const metadata = buildArticleMetadata({ data: articleData, body: articleBody, locale: localeCode, id, collection: 'albums' });
const theme = entry.data.theme ?? {
  accentColor: '#d7b8ff',
  mutedColor: '#9ba9d0',
  surfaceColor: '#11111a',
  highlightColor: '#f8f5ff',
};
const themeStyle = [
  `--wiki-accent-color:${theme.accentColor}`,
  `--wiki-muted-color:${theme.mutedColor ?? theme.accentColor}`,
  `--wiki-surface-color:${theme.surfaceColor ?? '#11111a'}`,
  `--wiki-highlight-color:${theme.highlightColor ?? '#f8f5ff'}`,
].join(';');

const completeness = computeCompleteness('albums', entry.data);
const completenessLabels = {
  kicker: articleLabels.completeness.kicker,
  scoreLabel: articleLabels.completeness.scoreLabel,
  missingLabel: articleLabels.completeness.missingLabel,
  missingSummary: articleLabels.completeness.missingSummary,
  missingEmpty: articleLabels.completeness.missingEmpty,
  tiers: articleLabels.completeness.tiers,
};
const completenessMissing = completeness.missing.map((item) => ({
  ...item,
  label: articleLabels.completeness.fieldLabels[item.field] ?? item.field,
}));

const [allSongs, allAlbums, allArtists] = await Promise.all([
  getCollection('songs'),
  getCollection('albums'),
  getCollection('artists'),
]);
const missingIndex = buildContentIndex({ songs: allSongs, albums: allAlbums, artists: allArtists });
const missingIssues = detectEntryIssues({
  collection: 'albums',
  entry,
  index: missingIndex,
  body: articleBody,
});
const missingSummary = summarizeIssues(missingIssues);
const missingLabels = resolveLocaleCopy({
  zh: {
    eyebrow: '待补全',
    summary: missingSummary.total === 1 ? '该条目有 1 项待补全资料' : `该条目有 ${missingSummary.total} 项待补全资料`,
    details: '展开明细',
    edit: '去编辑补充',
    severityWarning: '警告',
    severityInfo: '提示',
    kinds: {
      'missing-fields': '缺失字段',
      'missing-locale': '缺少语言版本',
      'unknown-artist': '未识别的艺人',
      'album-not-linked': '未关联到专辑条目',
      'track-song-missing': '曲目关联的歌曲缺失',
      'tracks-unlinked': '曲目均未关联歌曲',
      'thin-body': '正文过短',
    },
    fieldNames: {
      image: '封面图', releaseDate: '发行日期', tracks: '曲目列表', type: '类型', label: '发行厂牌',
      catalogNumber: '商品编号', trackCount: '曲目数', description: '简介', romanizedTitle: '罗马字标题', officialLinks: '官方链接',
      composer: '作曲', lyricist: '作词', lyricsSources: '歌词来源', album: '收录专辑', duration: '时长', code: '编号',
      categoryTitle: '分类', profileTagline: '简介标签', debutDate: '出道日期', meta: '备注', affiliations: '所属 / 关联',
      designCredits: '设定 / 设计', featuredEntries: '相关词条',
    },
    localeNames: { zh: '简体中文', ja: '日语', en: '英语' },
  },
  ja: {
    eyebrow: '要補完',
    summary: missingSummary.total === 1 ? 'この記事には補完が必要な情報が 1 件あります' : `この記事には補完が必要な情報が ${missingSummary.total} 件あります`,
    details: '詳細を展開',
    edit: '編集して補う',
    severityWarning: '警告',
    severityInfo: '情報',
    kinds: {
      'missing-fields': '不足フィールド',
      'missing-locale': '不足している言語',
      'unknown-artist': '未確認のアーティスト',
      'album-not-linked': 'アルバム記事が未リンク',
      'track-song-missing': '収録曲のリンク先が不足',
      'tracks-unlinked': '収録曲が未リンク',
      'thin-body': '本文が短すぎます',
    },
    fieldNames: {
      image: 'カバー画像', releaseDate: 'リリース日', tracks: '収録曲', type: '種類', label: 'レーベル',
      catalogNumber: '規格品番', trackCount: '曲数', description: '紹介', romanizedTitle: 'ローマ字タイトル', officialLinks: '公式リンク',
      composer: '作曲', lyricist: '作詞', lyricsSources: '歌詞ソース', album: '収録アルバム', duration: '時間', code: 'コード',
      categoryTitle: '分類', profileTagline: '紹介タグライン', debutDate: 'デビュー', meta: 'メモ', affiliations: '所属 / 関連',
      designCredits: '設定 / デザイン', featuredEntries: '関連記事',
    },
    localeNames: { zh: '中国語（簡体）', ja: '日本語', en: '英語' },
  },
  en: {
    eyebrow: 'Needs work',
    summary: missingSummary.total === 1 ? 'This entry has 1 item that still needs work' : `This entry has ${missingSummary.total} items that still need work`,
    details: 'Show details',
    edit: 'Edit to fill in',
    severityWarning: 'Warning',
    severityInfo: 'Info',
    kinds: {
      'missing-fields': 'Missing fields',
      'missing-locale': 'Missing language',
      'unknown-artist': 'Unknown artist',
      'album-not-linked': 'Album not linked',
      'track-song-missing': 'Track song missing',
      'tracks-unlinked': 'Tracks unlinked',
      'thin-body': 'Thin body',
    },
    fieldNames: {
      image: 'Cover image', releaseDate: 'Release date', tracks: 'Track listing', type: 'Type', label: 'Label',
      catalogNumber: 'Catalog no.', trackCount: 'Track count', description: 'Description', romanizedTitle: 'Romanized title', officialLinks: 'Official links',
      composer: 'Composer', lyricist: 'Lyricist', lyricsSources: 'Lyrics sources', album: 'Album', duration: 'Duration', code: 'Code',
      categoryTitle: 'Category', profileTagline: 'Profile tagline', debutDate: 'Debut date', meta: 'Meta', affiliations: 'Affiliations',
      designCredits: 'Design credits', featuredEntries: 'Related entries',
    },
    localeNames: { zh: 'Simplified Chinese', ja: 'Japanese', en: 'English' },
  },
}, localeCode);
---

<BaseLayout reading lang={localeCode} alternates={alternates} title={`${entry.data.title} - Kamitsubaki Studio Fan Wiki`} metadata={metadata}>
  <div class="wiki-theme-shell" style={themeStyle}>
    <SiteNav navItems={homeContent.navItems} localeLinks={localeLinks} brandLines={homeContent.hero.brandLines} compact homeHref={`/${localeCode}/`} />
    <div class="fixed left-0 top-0 z-[60] h-px w-full origin-left bg-white/70" data-reading-progress></div>

    <div class="reader-frame reader-heading-frame mx-auto max-w-[92rem] px-4 pb-3 pt-24 sm:px-6 sm:pb-4 sm:pt-28 lg:pt-28">
      <WikiArticleHeader data={articleData} localeLinks={localeLinks} labels={articleLabels} sourceHref={sourceHref} homeHref={`/${localeCode}/`}>
        <MusicSubnav locale={localeCode} current="albums" slot="section" />
      </WikiArticleHeader>
    </div>

    <div class:list={[
      'reader-frame reader-layout mx-auto grid max-w-[92rem] items-start gap-5 px-4 py-4 sm:gap-8 sm:px-6 sm:py-5 lg:gap-8',
      hasMainContent ? 'lg:grid-cols-12' : 'lg:grid-cols-[minmax(0,1fr)_22rem]',
    ]}>
      {hasTableOfContents && (
        <aside class="reader-toc-column hidden lg:col-span-2 lg:block lg:sticky lg:top-32">
          <TableOfContents headings={headings} title={articleLabels.contents} />
        </aside>
      )}

      {hasMainContent && (
        <main class:list={[
          'reader-body w-full min-w-0',
          hasTableOfContents ? 'lg:col-span-7' : 'lg:col-span-8 lg:col-start-2',
        ]}>
          {hasTableOfContents && (
            <details class="wiki-mobile-toc mb-8 rounded-lg border border-white/10 bg-white/[0.03] p-4 lg:hidden">
              <summary class="cursor-pointer font-mono text-[11px] uppercase tracking-[0.24em] text-white/65">{articleLabels.contents}</summary>
              <div class="mt-4 border-t border-white/10 pt-4"><TableOfContents headings={headings} title={articleLabels.contents} /></div>
            </details>
          )}

          {missingIssues.length > 0 && (
            <MissingDataNotice
              issues={missingIssues}
              summary={missingSummary}
              labels={missingLabels}
              editHref={sourceHref}
            />
          )}

          {hasArticleBody && <article class="wiki-reader wiki-prose prose prose-invert max-w-none"><Fragment set:html={contentHtml} /></article>}

          {hasTracks && (
            <section class:list={['reveal-up', hasArticleBody && 'mt-12 border-t border-white/10 pt-10']}>
              <h2 class="font-serif text-2xl tracking-[0.08em] text-white">{articleLabels.tracklist}</h2>
              <div class="mt-6 overflow-x-auto border-y border-white/10">
                <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
                  <thead class="font-mono text-[9px] uppercase tracking-[0.18em] text-white/35">
                    <tr class="border-b border-white/10">
                      <th class="px-3 py-3 font-normal">#</th>
                      <th class="px-3 py-3 font-normal">{articleLabels.track}</th>
                      <th class="px-3 py-3 font-normal">{articleLabels.trackArtist}</th>
                      <th class="px-3 py-3 text-right font-normal">{articleLabels.trackDuration}</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/5">
                    {entry.data.tracks?.map((track, index) => (
                      <tr class="text-white/70">
                        <td class="px-3 py-4 font-mono text-[10px] text-white/30">
                          {track.disc && track.disc > 1 ? `${track.disc}-` : ''}{track.number ?? String(index + 1).padStart(2, '0')}
                        </td>
                        <td class="px-3 py-4 font-serif tracking-wide text-white/85">
                          {track.songId && localizedSongIds.has(track.songId)
                            ? <a href={`/${localeCode}/songs/${track.songId}`} class="transition-colors hover:text-white">{track.title}</a>
                            : track.title}
                        </td>
                        <td class="px-3 py-4 text-xs text-white/50">{track.artist ?? entry.data.artist}</td>
                        <td class="px-3 py-4 text-right font-mono text-[10px] text-white/40">{track.duration}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}
        </main>
      )}

      <aside class:list={[
        'reader-sidebar w-full max-w-sm mx-auto lg:sticky lg:top-32 lg:max-w-none reveal-up',
        hasMainContent ? 'lg:col-span-3' : 'lg:col-start-2',
      ]}>
        <AlbumInfoBox data={entry.data} labels={articleLabels} />
        <EntryCompleteness
          score={completeness.score}
          tier={completenessTier(completeness.score)}
          missing={completenessMissing}
          labels={completenessLabels}
        />
        <ContributorRoster mode="entry" locale={localeCode} collection="albums" entryId={id} />
      </aside>
    </div>

    <div class="reader-frame reader-end mx-auto max-w-[92rem] px-4 pb-6 sm:px-6">
      <MemoryCorridorEntryLink locale={localeCode} kind="album" entryId={id!} />
      <ContentLicenseNotice license={entry.data.license} locale={localeCode} />
    </div>

    <SiteFooter footer={homeContent.footer} />
  </div>
</BaseLayout>
