---
import WorkspaceControl from '../../../components/WorkspaceControl.astro';
import WorkspaceButton from '../../../components/WorkspaceButton.astro';
import Icon from '../../../components/Icon.astro';
import {chroniclePresetLinks} from '../../../lib/chroniclePresets.mjs';
import WorkspaceToolbar from '../../../components/WorkspaceToolbar.astro';
import WorkspaceFilters from '../../../components/WorkspaceFilters.astro';
import WorkspaceShell from '../../../components/WorkspaceShell.astro';
import '../../../styles/chronicleTimeline.css';
import '../../../styles/fanArchive.css';
import {entityLabel} from '../../../lib/entityLabels.mjs';
import WorkspaceHeader from '../../../components/WorkspaceHeader.astro';
import {pageLabels} from '../../../lib/pageLabels.mjs';
import {dateBounds,timelineBounds} from '../../../lib/chronicleTimeline.mjs';
import '../../../styles/labsFeatures.css';
import {getCollection} from 'astro:content';import BaseLayout from '../../../layouts/BaseLayout.astro';import SiteNav from '../../../components/SiteNav.astro';import SiteFooter from '../../../components/SiteFooter.astro';import {getLocalizedEntries,getLocalizedSite} from '../../../lib/homeData.mjs';import {buildLocaleLinks,resolveLocaleCopy} from '../../../lib/i18n.mjs';import {getEntityRegistry,entityLocales} from '../../../lib/entityRegistry.mjs';import {loadFeatureData,featureText,loadTaxonomy} from '../../../lib/featureData.mjs';import '../../../styles/encyclopedia.css';import '../../../styles/observatoryWorkspaces.css';
export function getStaticPaths(){return entityLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!;const site=getLocalizedSite(await getCollection('site'),locale);const data=await loadFeatureData();const registry=await getEntityRegistry();const tracks=[...(await loadTaxonomy('tracks')).values,'site-updates'];const types=(await loadTaxonomy('event-types')).values;
const copy=resolveLocaleCopy({zh:{title:'全景纪元时间轴',intro:'沿横向轨道浏览事件与站点更新。拖动时间刻度上的播放头定位日期，拖动轨道平移；纪元为 Wiki 编辑部分期。',all:'全部',search:'检索事件',year:'年份',entity:'关联实体',type:'事件类型',era:'纪元',solo:'聚焦轨道',empty:'没有符合条件的事件。',tracks:['音乐与现场','企划与世界观','同位体与合成','组织与商业','站点更新'],eras:['创立期 · 黎明破晓','扩张期 · 武道馆与同位体','跨媒体期 · 虚实深化与决战','新纪元 · 宇宙交汇与基础设施']},ja:{title:'年代記',intro:'横方向のトラックで出来事とサイト更新をたどります。再生ヘッドをドラッグして日付を選び、トラックをドラッグして移動できます。',all:'すべて',search:'出来事を検索',year:'年',entity:'関連項目',type:'種類',era:'時代',solo:'この軌道に集中',empty:'該当する出来事はありません。',tracks:['音楽とライブ','企画と世界観','同位体と合成音声','組織と事業','サイト更新'],eras:['創立期','拡張期','クロスメディア期','新時代']},en:{title:'The chronicle',intro:'Browse events and site updates in horizontal tracks. Drag the playhead to scrub dates, or drag the tracks to pan.',all:'All',search:'Search events',year:'Year',entity:'Related entity',type:'Event type',era:'Era',solo:'Focus track',empty:'No matching events.',tracks:['Music & live','Projects & lore','Isotopes & synthesis','Organizations & business','Site updates'],eras:['Founding','Expansion','Transmedia','New era']}},locale);
const people=[...new Set(data.events.flatMap(e=>e.related?.map(r=>r.entity)||[]))].map(id=>registry.resolveEntity(id,locale)).filter((e): e is NonNullable<typeof e>=>Boolean(e));
const ui=resolveLocaleCopy({
  zh:{more:'再显示 12 项事件',fit:'全景',zoom:'时间缩放',position:'拖动总览窗口移动时间轴',scrub:'拖动播放头选择时间',hint:'拖动刻度定位日期 · 拖动轨道平移 · 点击片段阅读详情 · 缩放可展开密集事件',events:'项事件',select:'选择片段，阅读事件与来源',preview:'片段预览 · 点击固定详情',sources:'资料来源',previous:'上一事件',next:'下一事件',range:'当前时间窗口',filter:'筛选事件',reset:'清除筛选',uncertain:'日期范围未精确',siteNotice:'阅读站点公告',scopeLabel:'时间轴类型',scopeChronicle:'神椿纪元',scopeSite:'站点时间轴',archive:'公告档案',view:'视图',timelineView:'时间轴',listView:'事件列表',order:'排序',ascending:'从早到晚',descending:'从晚到早',submit:'投稿时间轴事件',revise:'修订这条事件',collapse:'收起',sourceLanguage:'原文语言',translationPending:'待翻译'},
  ja:{more:'次の12件を表示',fit:'全体',zoom:'時間の拡大率',position:'概要ウィンドウをドラッグして移動',scrub:'再生ヘッドをドラッグして日付を選ぶ',hint:'目盛りをドラッグして日付を選択・トラックをドラッグして移動・クリップで詳細を表示',events:'件',select:'クリップを選んで出来事と出典を表示',preview:'クリップのプレビュー · クリックで詳細を固定',sources:'出典',previous:'前の出来事',next:'次の出来事',range:'表示期間',filter:'絞り込み',reset:'条件をクリア',uncertain:'日付の範囲は未確定',siteNotice:'サイトのお知らせを読む',scopeLabel:'時間軸の種類',scopeChronicle:'神椿年代記',scopeSite:'サイト年表',archive:'お知らせ一覧',view:'表示',timelineView:'時間軸',listView:'一覧',order:'順序',ascending:'古い順',descending:'新しい順',submit:'出来事を投稿',revise:'この出来事を修正',collapse:'折りたたむ',sourceLanguage:'原文',translationPending:'翻訳待ち'},
  en:{more:'Show 12 more events',fit:'Overview',zoom:'Time scale',position:'Drag the overview window to pan',scrub:'Drag the playhead to choose a date',hint:'Drag the ruler to scrub · Drag tracks to pan · Select a clip to read · Zoom to separate dense events',events:'events',select:'Select a clip to read its details and sources',preview:'Clip preview · Click to pin details',sources:'Sources',previous:'Previous event',next:'Next event',range:'Visible range',filter:'Filter events',reset:'Clear filters',uncertain:'Approximate date range',siteNotice:'Read site announcement',scopeLabel:'Timeline collection',scopeChronicle:'Chronicle',scopeSite:'Site timeline',archive:'Announcement archive',view:'View',timelineView:'Timeline',listView:'Event list',order:'Order',ascending:'Oldest first',descending:'Newest first',submit:'Add an event',revise:'Revise this event',collapse:'Collapse',sourceLanguage:'Original language',translationPending:'Translation pending'}
},locale);
const readLocale=locale.startsWith('zh')?'zh':locale;
const history=getLocalizedEntries(await getCollection('announcements'),locale).filter(entry=>!entry.data.draft);
const siteEvents=history.map(entry=>({id:`site-${entry.data.translationKey||entry.id}`,title:entry.data.title,summary:entry.data.summary,era:'',date:{start:entry.data.date.replaceAll('.','-'),precision:'day'},tracks:['site-updates'],eventTypes:[],importance:'standard',sourceLocale:entry.data.locale,translationPending:false,related:[],links:[{label:ui.siteNotice,url:`/${locale}/announcements/#${encodeURIComponent(entry.data.translationKey||entry.id)}`}],sources:[]}));
const events=[...data.events.map(event=>({...event,...featureText(event.text,locale),sourceLocale:event.sourceLocale||(['zh','ja','en'].find(lang=>event.text[lang])||'zh'),translationPending:!event.text[readLocale],links:[...(event.related||[]).map(r=>r.entity),...(event.articles||[])].map(id=>registry.resolveEntity(id,locale)).filter((e): e is NonNullable<typeof e>=>Boolean(e)).map(e=>({label:e.data.name||e.data.title,url:e.url}))})),...siteEvents];
const chronicleBounds=timelineBounds(events,data.eras);
---
<BaseLayout title={`${copy.title} · Kamitsubaki Studio Fan Wiki`} lang={locale}>
<SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/chronicle/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
<WorkspaceShell width="wide" class="wiki-v3 feature-workspace chronicle-editor" data-timeline data-timeline-scope="chronicle">
<WorkspaceHeader title={copy.title} intro={copy.intro} eyebrow="EXPLORE / CHRONICLE" backHref={`/${locale}/explore/`} backLabel={pageLabels(locale).explore}><a class="chronicle-contribute" href={`/${locale}/chronicle/submit/`}>{ui.submit} <Icon name="arrow-up-right" /></a></WorkspaceHeader>

<div class="timeline-era-index" aria-label={copy.era}>{data.eras.map((era,i)=><WorkspaceButton type="button" data-era={era.id} style={`--era-share:${Math.max(1,Math.min(chronicleBounds.end,dateBounds(era.end).end)-Math.max(chronicleBounds.start,dateBounds(era.start).start))}`}><span>0{i+1} / {era.start.slice(0,4)}{i<3?'—'+era.end.slice(0,4):'—'}</span><strong>{copy.eras[i]}</strong><small>{events.filter(e=>e.era===era.id).length} {ui.events}</small></WorkspaceButton>)}</div>
<WorkspaceToolbar class="timeline-options"><div class="timeline-scope-switch workspace-tool-segments" role="group" aria-label={ui.scopeLabel}><WorkspaceButton type="button" data-timeline-scope="chronicle" aria-pressed="true">{ui.scopeChronicle}</WorkspaceButton><WorkspaceButton type="button" data-timeline-scope="site" aria-pressed="false">{ui.scopeSite} <small>{siteEvents.length}</small></WorkspaceButton></div><a class="timeline-announcements-link workspace-tool-action" href={`/${locale}/announcements/`}>{ui.archive} <Icon name="arrow-up-right" /></a><details class="timeline-filter-panel"><summary>{ui.filter} <span data-filter-count></span></summary>
<WorkspaceFilters class="toolbar feature-filters"><label><span>{copy.search}</span><WorkspaceControl name="q" type="search" placeholder={copy.search}/></label><label><span>{copy.entity}</span><WorkspaceControl as="select" name="entity"><option value="">{copy.all}</option>{people.map(e=><option value={e.data.id}>{e.data.name||e.data.title}</option>)}</WorkspaceControl></label><label><span>{copy.type}</span><WorkspaceControl as="select" name="type"><option value="">{copy.all}</option>{types.map(type=><option value={type}>{entityLabel(type,locale)}</option>)}</WorkspaceControl></label><label><span>{copy.year}</span><WorkspaceControl as="select" name="year"><option value="">{copy.all}</option>{[...new Set(events.map(e=>e.date.start.slice(0,4)))].map(year=><option>{year}</option>)}</WorkspaceControl></label><label><span>{locale==='en'?'From date':locale==='ja'?'開始日':'开始日期'}</span><WorkspaceControl name="from" placeholder="2023 / 2023-01-01" maxlength="10"/></label><label><span>{locale==='en'?'To date':locale==='ja'?'終了日':'结束日期'}</span><WorkspaceControl name="to" placeholder="2024 / 2024-12-31" maxlength="10"/></label><WorkspaceButton type="reset" class="filter-reset">{ui.reset}</WorkspaceButton></WorkspaceFilters></details>
<div class="timeline-view-tools workspace-tool-group"><label class="workspace-tool-field">{ui.view} <WorkspaceControl as="select" data-timeline-view><option value="timeline">{ui.timelineView}</option><option value="list">{ui.listView}</option></WorkspaceControl></label><label class="workspace-tool-field">{ui.order} <WorkspaceControl as="select" data-timeline-order><option value="asc">{ui.ascending}</option><option value="desc">{ui.descending}</option></WorkspaceControl></label></div></WorkspaceToolbar>
<nav class="archive-links" aria-label="Chronicle">{chroniclePresetLinks(locale).map(preset=><a href={preset.href}>{preset.title}</a>)}<a href={'/'+locale+'/explore/today/'}>{locale==='en'?'This day in KAMITSUBAKI':locale==='ja'?'今日は何の日':'历史上的今天'}</a></nav>
<div class="timeline-workbench"><div class="timeline-main">
<div data-chronicle-list hidden></div>
<section class="timeline-console" aria-label={copy.title}>
<div class="timeline-transport"><WorkspaceButton type="button" data-fit>{ui.fit}</WorkspaceButton><label>{ui.zoom}<WorkspaceControl data-time-zoom type="range" min="0" max="100" step=".1" value="27.3" aria-label={ui.zoom}/><output data-scale>4×</output></label><div class="timeline-zoom-presets" role="group" aria-label={ui.zoom}>{[1,4,16,64,160].map(scale=><WorkspaceButton type="button" data-zoom-preset={scale} aria-label={`${ui.zoom} ${scale}×`} aria-pressed={scale===4?'true':'false'}>{scale}×</WorkspaceButton>)}</div><output data-playhead-time aria-live="off"></output><output data-window aria-label={ui.range}></output></div>
<div class="timeline-editor-body"><div class="timeline-track-labels"><div class="timeline-ruler-label">CHRONICLE</div>{tracks.map((track,i)=><div class="timeline-track-label"><span>0{i+1}</span><label><WorkspaceControl type="checkbox" checked data-track value={track}/>{copy.tracks[i]}</label><WorkspaceButton type="button" data-solo={track}>{copy.solo}</WorkspaceButton></div>)}</div><div class="timeline-scroll" data-time-scroll tabindex="0" aria-label={ui.position}><div class="timeline-canvas" data-time-canvas><div class="timeline-ruler" data-ruler aria-label={ui.scrub}></div>{tracks.map((track,i)=><div class="timeline-track" data-lane={track} style={`--track-index:${i}`} aria-label={copy.tracks[i]}></div>)}<div class="timeline-playhead" data-playhead><span class="timeline-playhead-grip" aria-hidden="true"></span></div></div></div></div>
<div class="timeline-overview"><div data-overview-eras class="timeline-overview-eras"></div><div class="timeline-window" data-window-marker role="scrollbar" tabindex="0" aria-orientation="horizontal" aria-label={ui.position} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span aria-hidden="true"></span></div></div>
<p class="timeline-hint">{ui.hint}<span data-count aria-live="polite"></span></p>
</section>
<p class="timeline-no-results" data-empty hidden>{copy.empty}</p>
</div>
<section class="timeline-inspector" aria-label={ui.select}><article class="timeline-detail" data-detail tabindex="-1" aria-live="polite"><p>{ui.select}</p></article><div class="timeline-inspector-list"><span class="timeline-kicker" data-group-title>{ui.select}</span><div data-event-list></div></div></section>
</div>
<noscript><p>{locale==='en'?'Enable JavaScript to explore the interactive timeline.':locale==='ja'?'時間軸の操作には JavaScript が必要です。':'交互时间轴需要启用 JavaScript。'}</p></noscript>
<script type="application/json" data-timeline-data set:html={JSON.stringify({events,eras:data.eras,tracks,trackLabels:copy.tracks,eraLabels:copy.eras,ui,locale}).replaceAll('<','\\u003c')}/>
</WorkspaceShell><SiteFooter footer={site.footer}/></BaseLayout>
<script>import {initTimeline} from '../../../lib/chronicleTimeline.ts';initTimeline();</script>

<style>.chronicle-contribute{display:inline-flex;align-items:center;min-height:42px;padding:8px 13px;border:1px solid var(--theme-fg);border-radius:3px;background:var(--theme-fg);color:var(--theme-bg);font-size:12px;text-decoration:none}.timeline-options{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:10px 0 13px}.timeline-options .timeline-filter-panel{margin:0}.timeline-scope-switch{display:inline-flex;gap:3px;flex:none;padding:3px;border:1px solid var(--workspace-line);border-radius:4px}.timeline-scope-switch button{min-height:35px;padding:7px 12px;border:0;border-radius:2px;background:transparent;color:var(--workspace-muted);font:12px var(--font-sans);cursor:pointer}.timeline-scope-switch button:hover{color:var(--theme-fg)}.timeline-scope-switch button[aria-pressed=true]{background:var(--theme-fg);color:var(--theme-bg)}.timeline-scope-switch small{margin-left:5px;font:10px var(--font-mono)}.timeline-announcements-link{font:11px var(--font-sans);color:var(--theme-fg);text-underline-offset:4px;white-space:nowrap}.timeline-view-tools{display:flex;gap:20px;font-size:12px}.timeline-view-tools select{background:var(--theme-bg);color:var(--theme-fg);padding:8px;border:1px solid rgb(var(--theme-fg-rgb)/.15);border-radius:4px}[data-chronicle-list] :global(button){display:block;width:100%;text-align:left;padding:16px 8px;border-bottom:1px solid rgb(var(--theme-fg-rgb)/.12);font-size:13px}[data-chronicle-list] :global(button:hover){color:var(--theme-accent-color)}@media(max-width:1000px){.timeline-options{justify-content:flex-start;flex-wrap:wrap}.timeline-view-tools{margin-left:auto}}@media(max-width:650px){.timeline-options{align-items:flex-start}.timeline-view-tools{margin-left:0;flex-wrap:wrap;gap:8px}}</style>
