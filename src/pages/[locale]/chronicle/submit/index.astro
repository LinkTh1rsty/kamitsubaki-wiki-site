---
import WorkspaceControl from '../../../../components/WorkspaceControl.astro';
import Icon from '../../../../components/Icon.astro';
import WorkspaceLayout from '../../../../layouts/WorkspaceLayout.astro';
import WorkspaceButton from '../../../../components/WorkspaceButton.astro';
import ContributionFlow from '../../../../components/ContributionFlow.astro';
import {supportedLocales,resolveLocaleCopy} from '../../../../lib/i18n.mjs';
import {getEntityRegistry} from '../../../../lib/entityRegistry.mjs';
import '../../../../styles/chronicleEditor.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale||'zh';
const api=import.meta.env.PUBLIC_EDITOR_API_BASE||'https://api.kamitsubaki.wiki';
const registry=await getEntityRegistry();
const entities=[...registry.entities.keys()].sort().map(id=>({id,name:registry.resolveEntity(id,locale)?.data.name||id}));
const c=resolveLocaleCopy({
 zh:{title:'投稿时间轴事件',intro:'按步骤记录事件、日期精度、关联词条和可核对来源。可先保存草稿，确认后再提交审核。',back:'返回时间轴',guide:'查看投稿指南',step1:'事件内容',step2:'时间与分类',step3:'关联与来源',step4:'预览与提交',language:'原文语言',translation:'填写多种语言可以让更多读者看见；缺译会显示原文语言。',titleField:'事件标题',summary:'事件摘要',date:'开始日期',end:'结束日期（可选）',precision:'日期精度',day:'准确到日',month:'仅确定月份',year:'仅确定年份',dateFormatDay:'准确日期用 YYYY-MM-DD；持续事件可填写结束日期。',dateFormatMonth:'只知道月份时输入 YYYY-MM，不要猜测具体日期。',dateFormatYear:'只知道年份时输入 YYYY，不要猜测具体月份和日期。',track:'叙事轨道',type:'事件类型',importance:'重要程度',regular:'普通事件',milestone:'重要节点',related:'关联词条 ID（用逗号分隔）',relatedHint:'可从下方建议中选择 ID；没有关联时可留空。',sourceTitle:'来源名称',sourceUrl:'来源网址',sourcePublisher:'发布方（可选）',sourcePage:'页码或章节（可选）',addSource:'添加来源',remove:'移除',preview:'投稿预览',save:'保存草稿',submit:'提交审核',login:'登录后保存与提交',guest:'可以先在本机准备草稿；登录后才能保存到账号并提交审核。',localUnavailable:'浏览器未能保存本机草稿。请先复制内容并检查本机存储设置。',continueLogin:'登录账号',viewRecord:'查看投稿进度',status:'填写内容后可以保存草稿。',missing:'待翻译',sourceRequired:'至少填写一项可核对的来源，AI 整理的资料也需要人工核对事实。',reviewHint:'提交后会创建 GitHub PR；维护者审核合并，再等待网站发布。',conflictTitle:'事件原文已变化',conflictHint:'先核对下方当前版本与你正在编辑的内容，再确认新的比较基准。草稿会保留。',currentVersion:'当前公开版本',yourVersion:'你的修改',confirmVersion:'已核对，继续用我的修改',rechecked:'已采用当前版本作为比较基准。请检查预览后重新提交。',tracks:['音乐与现场','企划与世界观','同位体与合成','组织与商业'],types:['现场','发布','公告','组织变动','动画','游戏','出版','展览']},
 ja:{title:'年表の出来事を投稿',intro:'出来事、日付の精度、関連項目、確認できる出典を順に入力します。下書きを保存してから審査に提出できます。',back:'年表に戻る',guide:'投稿ガイド',step1:'内容',step2:'日付と分類',step3:'関連項目と出典',step4:'プレビューと提出',language:'原文の言語',translation:'翻訳がない場合は原文の言語を表示します。',titleField:'出来事の見出し',summary:'概要',date:'開始日',end:'終了日（任意）',precision:'日付の精度',day:'日まで確定',month:'月のみ確定',year:'年のみ確定',dateFormatDay:'確定した日付は YYYY-MM-DD。継続する出来事には終了日を入力できます。',dateFormatMonth:'月のみ分かる場合は YYYY-MM と入力し、日は推測しないでください。',dateFormatYear:'年のみ分かる場合は YYYY と入力し、月日は推測しないでください。',track:'軌道',type:'種類',importance:'重要度',regular:'通常',milestone:'重要',related:'関連項目 ID（カンマ区切り）',relatedHint:'候補から ID を選べます。関連項目がなければ空欄にできます。',sourceTitle:'出典名',sourceUrl:'出典 URL',sourcePublisher:'発行元（任意）',sourcePage:'ページ・章（任意）',addSource:'出典を追加',remove:'削除',preview:'プレビュー',save:'下書きを保存',submit:'審査に提出',login:'ログインして保存・提出',guest:'端末内で下書きを準備できます。アカウントへの保存と審査への提出にはログインが必要です。',localUnavailable:'端末に下書きを保存できませんでした。内容をコピーし、ブラウザーの保存設定を確認してください。',continueLogin:'ログイン',viewRecord:'投稿の進捗を見る',status:'入力後に下書きを保存できます。',missing:'未翻訳',sourceRequired:'確認できる出典が必要です。AI が整理した情報も人が事実を確認してください。',reviewHint:'提出後に GitHub PR が作成され、審査・マージ後、サイト公開を待ちます。',conflictTitle:'元の出来事が更新されました',conflictHint:'公開中の内容と編集中の内容を確認してください。下書きは保持されます。',currentVersion:'現在の公開内容',yourVersion:'あなたの変更',confirmVersion:'確認して自分の変更を続ける',rechecked:'現在の版を基準にしました。プレビューを確認して再提出してください。',tracks:['音楽とライブ','企画と世界観','同位体と合成','組織と事業'],types:['ライブ','リリース','発表','組織変更','アニメ','ゲーム','出版','展示']},
 en:{title:'Submit a chronicle event',intro:'Record an event, date precision, related entries, and verifiable sources. Save a draft before submitting for review.',back:'Back to the chronicle',guide:'Contribution guide',step1:'Event',step2:'Date and category',step3:'Links and sources',step4:'Preview and submit',language:'Original language',translation:'Missing translations display the original language.',titleField:'Event title',summary:'Event summary',date:'Start date',end:'End date (optional)',precision:'Date precision',day:'Exact day',month:'Month only',year:'Year only',dateFormatDay:'Use YYYY-MM-DD for an exact day. Add an end date for an ongoing event.',dateFormatMonth:'Use YYYY-MM when only the month is known. Do not invent a day.',dateFormatYear:'Use YYYY when only the year is known. Do not invent a month or day.',track:'Narrative track',type:'Event type',importance:'Importance',regular:'Regular event',milestone:'Milestone',related:'Related entry IDs (comma separated)',relatedHint:'Choose IDs from the suggestions. Leave blank if none apply.',sourceTitle:'Source title',sourceUrl:'Source URL',sourcePublisher:'Publisher (optional)',sourcePage:'Page or section (optional)',addSource:'Add source',remove:'Remove',preview:'Preview',save:'Save draft',submit:'Submit for review',login:'Sign in to save and submit',guest:'Prepare a draft on this device. Sign in to save it to your account and submit it for review.',localUnavailable:'This browser could not save the local draft. Copy your content and check browser storage settings.',continueLogin:'Sign in',viewRecord:'View submission progress',status:'You can save a draft after entering content.',missing:'Translation pending',sourceRequired:'Provide at least one verifiable source. Check facts yourself even when AI helps organize material.',reviewHint:'Submission creates a GitHub PR. After review and merge, the website must publish it.',conflictTitle:'The source event changed',conflictHint:'Compare the current published version with your edits before choosing a new base. Your draft is preserved.',currentVersion:'Current published version',yourVersion:'Your edits',confirmVersion:'I checked; keep my edits',rechecked:'The current version is now your comparison base. Review your preview before submitting again.',tracks:['Music and live','Projects and worlds','Isotopes and synthesis','Organizations and business'],types:['Live','Release','Announcement','Organization change','Anime','Game','Publication','Exhibition']}
},locale);
const tracks=['music-live','project-verse','isotope-synth','organization-biz'];
const types=['live','release','announcement','organization-change','anime','game','publication','exhibition'];
---
<WorkspaceLayout locale={locale} title={c.title} intro={c.intro} path="/chronicle/submit/" eyebrow="CONTRIBUTE / CHRONICLE" backHref={`/${locale}/chronicle/`} backLabel={c.back} width="wide" noindex mainAttributes={{class:'chronicle-submit','data-chronicle-editor':'','data-api':api,'data-locale':locale,'data-copy':JSON.stringify(c)}}>
 <WorkspaceButton slot="actions" href={`/${locale}/docs/contribute/chronicle/`}>{c.guide}</WorkspaceButton>
 <ContributionFlow locale={locale} kind="timeline"/>
 <p class="chronicle-editor-status" data-editor-status role="status" aria-live="polite">{c.status}</p>
 <section class="chronicle-conflict" data-chronicle-conflict hidden><h2>{c.conflictTitle}</h2><p>{c.conflictHint}</p><div class="chronicle-conflict-columns"><div><h3>{c.currentVersion}</h3><p data-conflict-current></p></div><div><h3>{c.yourVersion}</h3><p data-conflict-yours></p></div></div><WorkspaceButton type="button" data-confirm-conflict>{c.confirmVersion}</WorkspaceButton></section>
 <div class="chronicle-editor-layout"><form data-chronicle-form novalidate>
  <section><h2>{c.step1}</h2><label>{c.language}<WorkspaceControl as="select" name="sourceLocale"><option value="zh">中文</option><option value="ja">日本語</option><option value="en">English</option></WorkspaceControl></label><p>{c.translation}</p><div class="chronicle-language-tabs" role="group" aria-label={c.language}>{(['zh','ja','en'] as const).map(lang=><WorkspaceButton type="button" data-language={lang} aria-pressed={lang===locale||locale.startsWith('zh')&&lang==='zh'}>{lang==='zh'?'中文':lang==='ja'?'日本語':'English'} <small data-language-state={lang}></small></WorkspaceButton>)}</div>{(['zh','ja','en'] as const).map(lang=><div data-language-panel={lang} hidden><label>{c.titleField}<WorkspaceControl name={`title-${lang}`} maxlength="200"/></label><label>{c.summary}<WorkspaceControl as="textarea" name={`summary-${lang}`} rows={4} maxlength="2000"></WorkspaceControl></label></div>)}</section>
  <section><h2>{c.step2}</h2><div class="chronicle-editor-fields"><label>{c.precision}<WorkspaceControl as="select" name="precision"><option value="day">{c.day}</option><option value="month">{c.month}</option><option value="year">{c.year}</option></WorkspaceControl></label><label>{c.date}<WorkspaceControl name="start" required placeholder="YYYY-MM-DD" inputmode="numeric" maxlength="10"/></label><label>{c.end}<WorkspaceControl name="end" placeholder="YYYY-MM-DD" inputmode="numeric" maxlength="10"/></label></div><p data-date-format></p><fieldset><legend>{c.track}</legend>{tracks.map((value,i)=><label><WorkspaceControl type="checkbox" name="tracks" value={value}/>{c.tracks[i]}</label>)}</fieldset><fieldset><legend>{c.type}</legend>{types.map((value,i)=><label><WorkspaceControl type="checkbox" name="eventTypes" value={value}/>{c.types[i]}</label>)}</fieldset><label>{c.importance}<WorkspaceControl as="select" name="importance"><option value="regular">{c.regular}</option><option value="milestone">{c.milestone}</option></WorkspaceControl></label></section>
  <section><h2>{c.step3}</h2><label>{c.related}<WorkspaceControl name="related" list="chronicle-entities" autocomplete="off" placeholder="kaf, kamitsubaki-studio"/></label><datalist id="chronicle-entities">{entities.map(entity=><option value={entity.id}>{entity.name}</option>)}</datalist><p>{c.relatedHint}</p><div data-sources><div class="chronicle-source-row" data-source-row><div class="chronicle-source-primary"><label>{c.sourceTitle}<WorkspaceControl name="sourceTitle" maxlength="300"/></label><label>{c.sourceUrl}<WorkspaceControl name="sourceUrl" type="url" inputmode="url"/></label><WorkspaceButton type="button" data-remove-source>{c.remove}</WorkspaceButton></div><div class="chronicle-source-secondary"><label>{c.sourcePublisher}<WorkspaceControl name="sourcePublisher" maxlength="200"/></label><label>{c.sourcePage}<WorkspaceControl name="sourcePage" maxlength="100"/></label></div></div></div><WorkspaceButton type="button" class="chronicle-add-source" data-add-source>{c.addSource} <Icon name="plus" /></WorkspaceButton><p>{c.sourceRequired}</p></section>
  <section><h2>{c.step4}</h2><p>{c.reviewHint}</p><div class="chronicle-editor-actions"><WorkspaceButton type="button" data-save-draft>{c.save}</WorkspaceButton><WorkspaceButton type="submit" data-submit tone="primary">{c.submit}</WorkspaceButton></div></section>
 </form><aside class="chronicle-editor-preview"><span>PREVIEW</span><h2>{c.preview}</h2><time data-preview-date></time><p data-preview-language></p><h3 data-preview-title>—</h3><p data-preview-summary></p><div data-preview-meta></div><p data-preview-sources></p></aside></div>
</WorkspaceLayout>
<script>import '../../../../scripts/chronicleEditor.js';</script>
