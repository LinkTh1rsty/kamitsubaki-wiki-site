---
import '../../../styles/uploadComponents.css';
import GalleryNavigation from '../../../components/GalleryNavigation.astro';
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import {supportedLocales,resolveLocaleCopy} from '../../../lib/i18n.mjs';
import CreationWorkbench from '../../../components/CreationWorkbench.astro';
import ContextAction from '../../../components/ContextAction.astro';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!;
const api=import.meta.env.PUBLIC_GALLERY_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const copy=resolveLocaleCopy({
 zh:{title:'投稿设定组',intro:'填写共用的角色、形态和来源，再选择组内图片。',back:'返回图库',login:'登录后参与',photos:'直接上传照片',photosHint:'先收录可核对来源的照片；角色、类型与标签以后也能补。',sets:'创建设定组',setsHint:'一组设定填写一次角色、形态与共用来源，再安排组内照片。'},
 ja:{title:'設定セットを投稿',intro:'人物・形態・出典を入力し、セットに含める画像を選択します。',back:'ギャラリーへ',login:'ログインして参加',photos:'画像を直接投稿',photosHint:'出典を記して画像を収集。人物や種類は後から追加できます。',sets:'設定セットを作成',setsHint:'人物・形態・共通出典を記して画像をまとめます。'},
 en:{title:'Submit a design set',intro:'Add the shared subject, form and source, then select the images in the set.',back:'Back to gallery',login:'Sign in to contribute',photos:'Upload photos',photosHint:'Start with attributable photos; people, types and tags can be added later.',sets:'Create a design set',setsHint:'Group related images with a shared person, form and source.'}
},locale);
---
<WorkspaceLayout locale={locale} title={copy.title} intro={copy.intro} path="/gallery/manage/" eyebrow="GALLERY / UPLOAD" noindex mainAttributes={{class:'gallery-manage-shell creation-preview-page','data-gallery-api':api,'data-gallery-login':`/${locale}/account/`,'data-admin-intro':resolveLocaleCopy({zh:'管理员可以直接发布；暂存的图片在发布前不会公开。',ja:'管理者は直接公開できます。一時保存した画像は公開前には表示されません。',en:'Administrators can publish directly. Staged images remain private until publication.'},locale)}}>
 <Fragment slot="actions"><ContextAction data-gallery-login hidden>{copy.login}</ContextAction></Fragment>
 <GalleryNavigation slot="navigation" locale={locale} current="upload" kind="sets"/>
 <CreationWorkbench live locale={locale}/>
</WorkspaceLayout>
<script>import '../../../scripts/galleryUploader.js';</script>
