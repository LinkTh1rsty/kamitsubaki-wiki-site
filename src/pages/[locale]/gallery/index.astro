---
import GalleryNavigation from '../../../components/GalleryNavigation.astro';
import galleryEntities from '../../../data/gallery-entities.json';
import {imageAttributes} from '../../../lib/imageAssets.mjs';
import WorkspaceControl from '../../../components/WorkspaceControl.astro';
import Icon from '../../../components/Icon.astro';
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import WorkspaceButton from '../../../components/WorkspaceButton.astro';
import WorkspaceToolbar from '../../../components/WorkspaceToolbar.astro';
import ExpandControl from '../../../components/ExpandControl.astro';
import {supportedLocales,resolveLocaleCopy} from '../../../lib/i18n.mjs';
import '../../../styles/galleryArchive.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const previewAssets=Object.fromEntries(galleryEntities.filter(item=>item.image).map(item=>[item.image,imageAttributes(item.image,{widths:[192,480],sizes:'(max-width:700px) 40vw, 200px'})]));
const locale=Astro.params.locale!;
const api=import.meta.env.PUBLIC_GALLERY_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const copy=resolveLocaleCopy({
 zh:{title:'神椿图库',intro:'浏览照片与设定资料，按人物、团体、类型或标签查找。',back:'返回探索',upload:'投稿图片',roles:'人物与团体',rolesHint:'先按人物或团体分类，查看关联的公开照片；也可以浏览全部对象。',latest:'最新设定组',latestPhotos:'最新照片',photo:'照片',photos:'全部照片',viewSets:'设定组',roleSets:'设定组',photosInSet:'只看本组照片',clearSet:'清除设定组筛选',allForms:'全部形态',unclassified:'未分类',filters:'筛选图片',search:'搜索照片或设定',clear:'清除条件',more:'加载更多',retry:'重新加载',loading:'正在载入图库…',error:'图库暂时无法加载，请重试。',empty:'公开图片需要核对来源与使用依据；通过审核后会出现在这里。你也可以投稿图片。',noMatch:'没有符合条件的内容。',images:'张图片',sets:'套设定',allRoles:'全部对象',backToSets:'返回设定组',backToRecord:'返回投稿记录',source:'资料来源',original:'查看原图',date:'资料日期',publisher:'发布机构',notes:'设定备注',edit:'完善这套设定',related:'词条档案',allTypes:'全部类型',unclassifiedType:'待分类',tags:'全部标签',choose:'多选照片',cancelChoose:'结束多选',classify:'提出分类建议',typeSetting:'设定图',typePortrait:'肖像',typeCover:'作品封面',typePromo:'宣传视觉',typeEvent:'演出／活动',classifyPhoto:'完善这张照片',unknownPhoto:'尚未命名的照片',siteEntry:'查看本站词条',existingSiteNote:'本站既有图片；原图作者、出处与使用依据待补充'},
 ja:{title:'神椿ビジュアルアーカイブ',intro:'写真や設定資料を、人物・グループ・種類・タグから探せます。',back:'探索に戻る',upload:'画像を投稿',roles:'人物とグループ',rolesHint:'関連する公開画像を見る',latest:'新着の設定',latestPhotos:'新着の画像',photo:'画像',photos:'すべての画像',viewSets:'設定一覧',roleSets:'設定一覧',photosInSet:'この設定の画像を見る',clearSet:'設定の絞り込みを解除',allForms:'すべての形態',unclassified:'未分類',filters:'絞り込み',search:'画像・設定を検索',clear:'条件をクリア',more:'さらに読み込む',retry:'再読み込み',loading:'読み込み中…',error:'読み込めません。再試行してください。',empty:'画像は出典と利用根拠を確認し、審査を通過するとここに表示されます。画像の投稿もできます。',noMatch:'該当する資料はありません。',images:'枚の画像',sets:'件の設定',allRoles:'すべて',backToSets:'設定一覧へ',backToRecord:'投稿記録へ戻る',source:'出典',original:'原画像を見る',date:'資料の日付',publisher:'公開元',notes:'補足',edit:'設定を編集',related:'関連項目',allTypes:'すべての種類',unclassifiedType:'未分類',tags:'すべてのタグ',choose:'画像を複数選択',cancelChoose:'選択を終了',classify:'分類を提案',typeSetting:'設定画',typePortrait:'ポートレート',typeCover:'作品カバー',typePromo:'プロモーション画像',typeEvent:'ライブ／イベント',classifyPhoto:'この画像を分類',unknownPhoto:'無題の画像',siteEntry:'サイト内の記事を見る',existingSiteNote:'既存のサイト画像。原画像の作者・出典・利用根拠は追記待ち'},
 en:{title:'KAMITSUBAKI image archive',intro:'Explore photos and design references by person, group, type or tag.',back:'Back to Explore',upload:'Contribute images',roles:'People and groups',rolesHint:'Browse all public photos linked to a person or group.',latest:'Latest design sets',latestPhotos:'Latest photos',photo:'Photo',photos:'All photos',viewSets:'Design sets',roleSets:'Design sets',photosInSet:'View photos in this set',clearSet:'Clear set filter',allForms:'All forms',unclassified:'Unclassified',filters:'Filter photos',search:'Search photos or sets',clear:'Clear filters',more:'Load more',retry:'Retry',loading:'Loading gallery…',error:'Gallery unavailable. Please try again.',empty:'Images appear here after their sources and usage basis are reviewed. You can contribute photos, too.',noMatch:'No matching material.',images:'images',sets:'sets',allRoles:'All subjects',backToSets:'Back to sets',backToRecord:'Back to submission',source:'Source',original:'View original',date:'Date',publisher:'Publisher',notes:'Notes',edit:'Improve this set',related:'Related entry',allTypes:'All types',unclassifiedType:'Needs classification',tags:'All tags',choose:'Select photos',cancelChoose:'Done selecting',classify:'Suggest classification',typeSetting:'Setting art',typePortrait:'Portrait',typeCover:'Cover art',typePromo:'Promotional image',typeEvent:'Live / event',classifyPhoto:'Classify this photo',unknownPhoto:'Untitled photo',siteEntry:'View wiki entry',existingSiteNote:'Existing site image; original creator, source and usage basis need verification'}
},locale);
Object.assign(copy,resolveLocaleCopy({
 zh:{roleSort:'人物排序',roleOrderSite:'站内顺序',roleOrderCount:'照片最多',roleOrderName:'名称顺序',roleNoMatch:'没有找到人物或团体，请换个名称。',roleCount:'已显示人物与团体',roleSearch:'查找人物或团体',showAllRoles:'继续展开人物与团体',collapseRoles:'收起',moreLoading:'正在加载下一页…',loaded:'已显示',noSets:'暂无已公开设定组',noSetsHint:'现有图片作为独立照片收录；经过投稿与审核组成资料后，会显示在这里。',browsePhotos:'浏览全部照片',createSet:'创建设定组',suggestedPhotos:'先看看这些公开照片',download:'下载照片',imageType:'图片类型',subject:'关联对象',author:'图片作者',attribution:'来源核对',setName:'所属设定组',globalCount:'全图库数量'},
 ja:{roleSort:'表示順',roleOrderSite:'サイト掲載順',roleOrderCount:'画像が多い順',roleOrderName:'名前順',roleNoMatch:'該当する人物・グループがありません。',roleCount:'表示中の人物・グループ',roleSearch:'人物・グループを探す',showAllRoles:'人物とグループをさらに表示',collapseRoles:'閉じる',moreLoading:'次の画像を読み込み中…',loaded:'表示中',noSets:'公開済みの設定一覧はまだありません',noSetsHint:'既存の画像は個別の写真として公開中です。投稿・審査を経て資料にまとめられると、ここに表示されます。',browsePhotos:'すべての画像を見る',createSet:'設定資料を作る',suggestedPhotos:'公開画像から探す',download:'画像を保存',imageType:'画像の種類',subject:'関連する人物',author:'画像の作者',attribution:'出典の確認',setName:'所属する設定',globalCount:'アーカイブ全体の件数'},
 en:{roleSort:'Sort subjects',roleOrderSite:'Directory order',roleOrderCount:'Most photos',roleOrderName:'Name',roleNoMatch:'No matching people or groups. Try another name.',roleCount:'People and groups shown',roleSearch:'Find a person or group',showAllRoles:'Show more people and groups',collapseRoles:'Collapse',moreLoading:'Loading next page…',loaded:'Showing',noSets:'No published design sets yet',noSetsHint:'Existing images are available as individual photos. Curated sets will appear here after contribution and review.',browsePhotos:'Browse all photos',createSet:'Create a design set',suggestedPhotos:'Explore these public photos',download:'Download photo',imageType:'Image type',subject:'Related subjects',author:'Image creator',attribution:'Source check',setName:'Design set',globalCount:'Archive-wide count'}
},locale));
---
<WorkspaceLayout locale={locale} title={copy.title} intro={copy.intro} path="/gallery/" eyebrow="VISUAL ARCHIVE" width="wide" mainAttributes={{class:'gallery-archive','data-gallery':'','data-mobile-filters':'closed','data-api':api,'data-image-origin':import.meta.env.PUBLIC_GALLERY_IMAGE_ORIGIN||'https://images.kamitsubaki.wiki','data-locale':locale,'data-copy':JSON.stringify(copy)}}>
 <GalleryNavigation slot="actions" locale={locale} current="browse"/>
 <div class="gallery-overview" data-gallery-overview>
  <section class="gallery-set-section" aria-labelledby="gallery-sets-title"><div class="gallery-section-heading"><div><h2 id="gallery-sets-title" data-gallery-section-title tabindex="-1">{copy.latestPhotos}</h2></div><output data-gallery-count></output></div>
   <WorkspaceToolbar class="gallery-controls"><div class="gallery-view-switch workspace-tool-segments" role="group" aria-label={copy.title}><WorkspaceButton type="button" data-gallery-view="photos" aria-pressed="true">{copy.photos}</WorkspaceButton><WorkspaceButton type="button" data-gallery-view="sets" aria-pressed="false">{copy.viewSets}</WorkspaceButton></div>
    <form class="gallery-toolbar gallery-primary-search" id="gallery-search-filters" data-gallery-search role="search"><label class="workspace-tool-field"><span class="sr-only">{copy.search}</span><WorkspaceControl type="search" name="q" placeholder={copy.search} autocomplete="off"/></label></form>
   <WorkspaceButton class="gallery-filter-toggle" type="button" data-gallery-filter-toggle aria-expanded="false" aria-controls="gallery-filter-panel"><span data-gallery-filter-label>{copy.filters}</span><Icon name="chevron-down" class="gallery-filter-chevron" /></WorkspaceButton>
   <div class="gallery-filter-panel" id="gallery-filter-panel" hidden>
  <section class="gallery-role-section" id="gallery-role-filters" aria-labelledby="gallery-roles-title">
   <div class="gallery-role-head"><div><span>PEOPLE / GROUPS</span><h2 id="gallery-roles-title">{copy.roles}</h2><p>{copy.rolesHint}</p></div></div>
   <div class="gallery-role-tools">
    <label class="gallery-role-search"><span>{copy.roleSearch}</span><WorkspaceControl type="search" data-gallery-role-search placeholder={copy.roleSearch} autocomplete="off"/></label>
    <label class="gallery-role-sort"><span>{copy.roleSort}</span><WorkspaceControl as="select" data-gallery-role-sort><option value="site">{copy.roleOrderSite}</option><option value="count">{copy.roleOrderCount}</option><option value="name">{copy.roleOrderName}</option></WorkspaceControl></label>
   </div>
   <div class="gallery-role-list" id="gallery-role-list" data-gallery-roles></div>
   <p class="gallery-role-empty" data-gallery-role-empty hidden role="status">{copy.roleNoMatch}</p>
   <output class="gallery-role-count" data-gallery-role-count aria-label={copy.roleCount} aria-live="polite"></output>
   <ExpandControl controls="gallery-role-list" expandLabel={copy.showAllRoles} collapseLabel={copy.collapseRoles} galleryRoles initiallyHidden withCollapse />
  </section>
    <div class="gallery-extra-tools workspace-tool-group"><label class="workspace-tool-field"><span class="sr-only">{copy.tags}</span><WorkspaceControl as="select" data-gallery-tag><option value="">{copy.tags}</option></WorkspaceControl></label><WorkspaceButton type="button" data-gallery-select>{copy.choose}</WorkspaceButton><a class="workspace-tool-action" data-gallery-classify hidden href={`/${locale}/gallery/classify/`}>{copy.classify}</a></div>
    <nav class="gallery-type-list workspace-tool-filters" data-gallery-types aria-label={copy.allTypes}></nav>
    <nav class="gallery-form-list workspace-tool-filters" id="gallery-form-filters" data-gallery-forms aria-label={copy.allForms}></nav>
   </div></WorkspaceToolbar>
   <div class="gallery-set-filter" data-gallery-set-filter hidden><span data-gallery-set-filter-name></span><WorkspaceButton type="button" data-gallery-set-filter-clear>{copy.clearSet} <Icon name="x" /></WorkspaceButton></div><div class="gallery-active-filters" data-gallery-active-filters aria-label={copy.filters} hidden><span class="gallery-filter-chips" data-gallery-filter-chips></span><WorkspaceButton type="button" data-gallery-clear>{copy.clear}</WorkspaceButton></div>
   <p class="gallery-feedback" data-gallery-feedback role="status" aria-live="polite"></p><div class="gallery-set-grid" data-gallery-grid></div>
   <div class="gallery-bottom"><WorkspaceButton type="button" data-gallery-more hidden>{copy.more}</WorkspaceButton><WorkspaceButton type="button" data-gallery-retry hidden>{copy.retry}</WorkspaceButton></div>
  </section>
 </div>
 <section class="gallery-set-detail" data-gallery-detail hidden aria-labelledby="gallery-detail-title"><WorkspaceButton type="button" class="gallery-detail-back" data-gallery-back><Icon name="arrow-left" /> {copy.backToSets}</WorkspaceButton><header class="gallery-detail-head"><div><p data-gallery-detail-path></p><h1 id="gallery-detail-title" data-gallery-detail-title></h1><p data-gallery-detail-meta></p></div><div class="gallery-detail-actions"><WorkspaceButton type="button" data-gallery-photos-in-set>{copy.photosInSet} <Icon name="arrow-right" /></WorkspaceButton><WorkspaceButton data-gallery-edit href={`/${locale}/gallery/manage/`}>{copy.edit} <Icon name="arrow-up-right" /></WorkspaceButton></div></header><div class="gallery-detail-layout"><div class="gallery-detail-images" data-gallery-images></div><aside class="gallery-detail-aside"><dl data-gallery-properties></dl><WorkspaceButton data-gallery-related hidden tone="quiet" href={`/${locale}/database/`}>{copy.related} <Icon name="arrow-up-right" /></WorkspaceButton></aside></div></section>
</WorkspaceLayout>
<script type="application/json" data-gallery-image-assets set:html={JSON.stringify(previewAssets).replaceAll('<','\\u003c')}/>
<script>
 import {initGallery} from '../../../lib/gallery';
 initGallery();
</script>
