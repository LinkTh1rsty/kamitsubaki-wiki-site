---
import GalleryNavigation from '../../../../components/GalleryNavigation.astro';
import {galleryImageAccept,galleryHeicCopy} from '../../../../lib/galleryImageInput.mjs';
import WorkspaceControl from '../../../../components/WorkspaceControl.astro';
import WorkspaceButton from '../../../../components/WorkspaceButton.astro';
import Icon from '../../../../components/Icon.astro';
import UploadGuidance from '../../../../components/UploadGuidance.astro';
import UploadDraftStatus from '../../../../components/UploadDraftStatus.astro';
import {uploadGuidanceCopy,uploadSourceLabels} from '../../../../lib/uploadGuidanceCopy.mjs';
import WorkspaceToolbar from '../../../../components/WorkspaceToolbar.astro';
import SubmissionField from '../../../../components/SubmissionField.astro';
import SubmissionPanel from '../../../../components/SubmissionPanel.astro';
import {contributionLayoutCopy} from '../../../../lib/contributionLayoutCopy.mjs';
import {imageLibraryCopy} from '../../../../lib/imageLibraryCopy.mjs';
import WorkspaceLayout from '../../../../layouts/WorkspaceLayout.astro';
import {supportedLocales,resolveLocaleCopy} from '../../../../lib/i18n.mjs';
import '../../../../styles/galleryPhotoWorkbench.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!;
const layout=contributionLayoutCopy(locale);
const guidance=uploadGuidanceCopy(locale),sources=uploadSourceLabels(locale);
const api=import.meta.env.PUBLIC_GALLERY_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const copy=resolveLocaleCopy({
 zh:{title:'直接上传照片',intro:'先收录图片，人物与类型可以留空，之后由任何投稿者提出分类建议。图片须有可核对的出处和使用依据。',back:'返回上传工作台',select:'选择照片',drop:'拖入照片，或点击选择',shared:'这一批共用的资料',inherit:'沿用批次资料',differentEntities:'此图单独选择关联',author:'图片作者',sourceTitle:'出处名称',sourceUrl:'原始来源链接',basis:'使用依据',official:'官方公开素材',original:'投稿者原创',authorized:'已获授权',evidence:'授权说明',type:'图片类型（可选）',noType:'暂不分类',entities:'关联人物或团体（可选）',findEntity:'搜索人物或团体',tags:'标签（可选，用逗号分隔）',photos:'本批照片',perPhoto:'单张补充资料',photoTitle:'图片标题（可选）',override:'单张资料 · 修改本图',remove:'移除',save:'保存草稿',stage:'私有暂存图片',submit:'提交审核',saving:'正在保存草稿…',staging:'正在私有暂存图片…',submitting:'正在提交审核…',chooseFirst:'请先选择至少一张照片。',stageFirst:'还有照片尚未私有暂存，请先完成暂存。',successTitle:'投稿已进入审核',successNote:'照片已安全提交。你可以在创作者中心查看逐图审核意见和公开进度。',successClose:'留在此页',empty:'尚未选择照片。',status:'登录后可保存草稿并上传。',readyStatus:'选择照片并填写资料，再私有暂存并提交审核。',retryReady:'已恢复需要修改的照片与审核意见；修改资料后可重新提交。',login:'登录后继续',queued:'待上传',staged:'已私有暂存',failed:'暂存失败',review:'已提交审核；公开前仅审核员可查看。',receipt:'打开创作者中心查看审核记录',reviewReason:'修改意见',limit:'支持 PNG、JPEG、WebP、GIF；每批最多 100 张，单张不超过 20 MiB。'},
 ja:{title:'画像を直接投稿',intro:'まず画像を収集します。人物と種類は後から分類を提案できます。出典と利用根拠は必須です。',back:'投稿ワークベンチへ',select:'画像を選択',drop:'画像をドラッグ、またはクリックして選択',shared:'このバッチの共通情報',inherit:'バッチの情報を使用',differentEntities:'この画像だけ関連先を選ぶ',author:'画像の作者',sourceTitle:'出典名',sourceUrl:'原典 URL',basis:'利用根拠',official:'公式公開素材',original:'投稿者のオリジナル',authorized:'許可済み',evidence:'許可の説明',type:'画像の種類（任意）',noType:'未分類',entities:'人物・グループ（任意）',findEntity:'人物・グループを検索',tags:'タグ（任意、カンマ区切り）',photos:'このバッチの画像',perPhoto:'画像ごとの情報',photoTitle:'画像タイトル（任意）',override:'画像ごとの情報を編集',remove:'削除',save:'下書きを保存',stage:'非公開で一時保存',submit:'審査に提出',saving:'下書きを保存中…',staging:'画像を非公開で保存中…',submitting:'審査に提出中…',chooseFirst:'画像を一枚以上選択してください。',stageFirst:'未保存の画像があります。先に非公開で保存してください。',successTitle:'審査に提出しました',successNote:'画像を受け付けました。画像ごとの審査結果と公開状況はクリエイターセンターで確認できます。',successClose:'このページに留まる',empty:'画像を選択してください。',status:'ログインすると保存・投稿できます。',readyStatus:'画像と出典を確認し、非公開で一時保存してから審査に提出してください。',retryReady:'差し戻された画像と理由を復元しました。修正して再提出できます。',login:'ログインして続ける',queued:'アップロード待ち',staged:'非公開で一時保存済み',failed:'一時保存に失敗',review:'審査に提出しました。公開までは審査員のみ閲覧できます。',receipt:'クリエイターセンターで確認',reviewReason:'差し戻し理由',limit:'PNG、JPEG、WebP、GIF。1 バッチ 100 枚、1 枚 20 MiB まで。'},
 en:{title:'Upload photos',intro:'Collect photos now; people and types can be classified later. Every photo still needs an attributable source and basis for use.',back:'Back to upload workbench',select:'Choose photos',drop:'Drop photos here or choose files',shared:'Shared details for this batch',inherit:'Use batch details',differentEntities:'Choose links for this photo',author:'Image creator',sourceTitle:'Source name',sourceUrl:'Original source URL',basis:'Basis for use',official:'Official public material',original:'Your original work',authorized:'Authorized use',evidence:'Authorization details',type:'Image type (optional)',noType:'Unclassified',entities:'People or groups (optional)',findEntity:'Find a person or group',tags:'Tags (optional, comma separated)',photos:'Photos in this batch',perPhoto:'Photo details',photoTitle:'Photo title (optional)',override:'Edit this photo’s details',remove:'Remove',save:'Save draft',stage:'Stage photos privately',submit:'Submit for review',saving:'Saving draft…',staging:'Staging photos privately…',submitting:'Submitting for review…',chooseFirst:'Choose at least one photo first.',stageFirst:'Some photos are not staged yet. Stage them privately before submitting.',successTitle:'Submitted for review',successNote:'Your photos are safely submitted. Track per-photo feedback and publication in Creator Center.',successClose:'Stay on this page',empty:'No photos selected yet.',status:'Sign in to save a draft and upload.',readyStatus:'Choose photos and add details, then stage privately and submit for review.',retryReady:'Returned photos and review notes are restored. Update the details before resubmitting.',login:'Sign in to continue',queued:'Waiting to upload',staged:'Privately staged',failed:'Staging failed',review:'Submitted for review. Only reviewers can see the photos until publication.',receipt:'Track this batch in Creator Center',reviewReason:'Reason for changes',limit:'PNG, JPEG, WebP or GIF; up to 100 photos per batch and 20 MiB per photo.'}
},locale);
Object.assign(copy,resolveLocaleCopy({
 zh:{localStorageFull:'本机空间不足。已暂存的图片可从批次恢复；尚未暂存的文件请勿关闭页面。',tooMany:'每批最多 100 张',invalidFile:'文件格式或大小不符合要求',duplicateFile:'已经在本批次中',reselectFile:'本机文件需重新选择',wrongBatch:'这不是独立照片批次',accountChanged:'账号已变化，请刷新页面。',loginFirst:'请先登录，再选择照片和填写资料。',loginReason:'未登录时选取的本机文件无法在登录跳转后恢复。',authUnavailable:'暂时无法确认账号。',authUnavailableReason:'连接恢复后才能安全保存草稿或上传照片。',retryAuth:'重试连接'},
 ja:{localStorageFull:'端末の空き容量が不足しています。一時保存済みの画像はバッチから復元できます。未保存のファイルがある場合はページを閉じないでください。',tooMany:'1 バッチにつき最大 100 枚です',invalidFile:'ファイル形式またはサイズが条件に合いません',duplicateFile:'このバッチに追加済みです',reselectFile:'端末のファイルを選び直してください',wrongBatch:'これは単独画像のバッチではありません',accountChanged:'アカウントが変更されました。ページを再読み込みしてください。',loginFirst:'ログインしてから画像と資料を追加してください。',loginReason:'ログイン前に選んだ端末のファイルは、画面移動後に復元できません。',authUnavailable:'アカウントを確認できません。',authUnavailableReason:'接続が戻るまで、下書きの保存と画像のアップロードはできません。',retryAuth:'再接続'},
 en:{localStorageFull:'Device storage is full. Staged photos can be restored from the batch. Keep this page open for files that have not been staged.',tooMany:'A batch can contain up to 100 photos',invalidFile:'Unsupported file format or size',duplicateFile:'Already in this batch',reselectFile:'Choose the local file again',wrongBatch:'This is not a standalone photo batch',accountChanged:'The signed-in account changed. Reload this page.',loginFirst:'Sign in before choosing photos or entering details.',loginReason:'Files selected before sign-in cannot be restored after the redirect.',authUnavailable:'Your account could not be checked.',authUnavailableReason:'Reconnect before saving a draft or uploading photos.',retryAuth:'Retry connection'}
},locale));
const formCopy=resolveLocaleCopy({
 zh:{ heading:'投稿照片', status:'选择照片后会自动暂存。补齐标题与出处即可提交审核。', photoTitle:'图片标题', shared:'共用出处', sharedHint:'同一出处只填一次。某张照片不同，可在该行补充。', titleHint:'例如 花譜「不可解」演出主视觉', titleError:'请给这张图片填写标题。', linked:'关联词条', details:'单张资料', missing:'张待填标题', required:'请补齐出处与使用依据。' },
 en:{ heading:'Submit photos', status:'Selected photos are staged automatically. Add titles and attribution before submitting.', photoTitle:'Photo title', shared:'Shared attribution', sharedHint:'Enter a shared source once. Use the photo row for exceptions.', titleHint:'Example: KAF — Fukakai concert key visual', titleError:'Enter a title for this photo.', linked:'Related entries', details:'Photo details', missing:'missing titles', required:'Complete the source and usage information.' },
 ja:{ heading:'写真を投稿', status:'選択した画像は自動で一時保存されます。タイトルと出典を入力して提出してください。', photoTitle:'画像タイトル', shared:'共通の出典', sharedHint:'同じ出典は一度だけ入力します。異なる写真は各行で補足できます。', titleHint:'例：花譜「不可解」公演キービジュアル', titleError:'この画像のタイトルを入力してください。', linked:'関連項目', details:'画像の詳細', missing:'件のタイトルが未入力', required:'出典と利用根拠を入力してください。' },
},locale);
Object.assign(copy,formCopy,{fieldErrors:resolveLocaleCopy({
 zh:{gallery_author_required:'填写图片上署名的作者或发布方。',gallery_source_required:'填写可核对的出处名称。',gallery_rights_required:'请选择这张图片的使用依据。',gallery_original_url_required:'官方素材需要原始发布链接。',gallery_url_invalid:'请填写有效的 HTTP 或 HTTPS 链接。',gallery_evidence_required:'请说明授权来源或填写授权凭据。'},
 en:{gallery_author_required:'Enter the credited creator or publisher.',gallery_source_required:'Enter the name of a verifiable source.',gallery_rights_required:'Choose a basis for using this photo.',gallery_original_url_required:'Official material needs the original publication URL.',gallery_url_invalid:'Enter a valid HTTP or HTTPS URL.',gallery_evidence_required:'Describe where the permission came from or include evidence.'},
 ja:{gallery_author_required:'画像に記載された作者または公開元を入力してください。',gallery_source_required:'確認できる出典名を入力してください。',gallery_rights_required:'この画像の利用根拠を選択してください。',gallery_original_url_required:'公式素材は元の公開先 URL が必要です。',gallery_url_invalid:'有効な HTTP または HTTPS の URL を入力してください。',gallery_evidence_required:'許諾の出所または根拠を入力してください。'},
},locale)});
const libraryCopy=imageLibraryCopy(locale);
Object.assign(copy,{inspectorTitle:guidance.inspectorTitle,inspectorClose:guidance.inspectorClose,inspectPhoto:guidance.inspectPhoto,retryPhoto:guidance.retryPhoto,purpose:libraryCopy.purpose,galleryPurpose:libraryCopy.gallery,entryPurpose:libraryCopy.entry});
---
<WorkspaceLayout locale={locale} title={formCopy.heading} intro={copy.intro} path="/gallery/manage/photos/" eyebrow="GALLERY / UPLOAD" width="wide" noindex mainAttributes={{class:'gallery-photo-workbench','data-photo-workbench':'','data-api':api,'data-locale':locale,'data-copy':JSON.stringify(copy)}}>
 <GalleryNavigation slot="navigation" locale={locale} current="upload" kind="photos"/>
 <nav class="gallery-photo-draft-nav"><a class="gallery-photo-draft-link" href={`/${locale}/gallery/manage/photos/?new=1`}>{guidance.newDraft} <Icon name="arrow-right" /></a><a class="gallery-photo-draft-link" href={`/${locale}/gallery/mine/`}>{guidance.drafts} <Icon name="arrow-right" /></a></nav>
 <UploadGuidance locale={locale}/>
 <div class="gallery-photo-layout">
  <div class="gallery-photo-main submission-columns">
   <div class="gallery-photo-access" data-photo-access hidden role="status"><strong data-photo-access-title></strong><p data-photo-access-note></p><div><a data-photo-access-login href={`/${locale}/account/`}>{copy.login} <Icon name="arrow-right" /></a><WorkspaceButton type="button" data-photo-access-retry hidden>{copy.retryAuth}</WorkspaceButton></div></div>
   <SubmissionPanel title={formCopy.shared} hint={formCopy.sharedHint} class="gallery-photo-section gallery-photo-information"><fieldset class="submission-field-group"><legend>{layout.source}</legend><p class="submission-hint">{layout.requiredHint}</p><div class="gallery-photo-fields submission-field-grid"><SubmissionField id="photo-shared-author" label={copy.author} required><WorkspaceControl id="photo-shared-author" data-default="author" maxlength="200" autocomplete="off" placeholder={guidance.authorPlaceholder}/></SubmissionField><SubmissionField id="photo-shared-sourceTitle" label={copy.sourceTitle} required><WorkspaceControl id="photo-shared-sourceTitle" data-default="sourceTitle" maxlength="300" list="photo-source-candidates" placeholder={guidance.sourcePlaceholder}/><datalist id="photo-source-candidates">{sources.map(source=><option value={source.label} data-source-id={source.id}/>)}</datalist></SubmissionField><SubmissionField id="photo-shared-sourceUrl" label={copy.sourceUrl}><WorkspaceControl id="photo-shared-sourceUrl" data-default="sourceUrl" type="url" maxlength="2000" placeholder={guidance.urlPlaceholder}/></SubmissionField><SubmissionField id="photo-shared-rightsBasis" label={copy.basis} required><WorkspaceControl id="photo-shared-rightsBasis" as="select" data-default="rightsBasis"><option value="">{guidance.basisPlaceholder}</option><option value="official">{copy.official}</option><option value="original">{copy.original}</option><option value="authorized">{copy.authorized}</option></WorkspaceControl></SubmissionField><label class="submission-field-wide" data-evidence-field hidden>{copy.evidence}<WorkspaceControl as="textarea" data-default="rightsEvidence" maxlength="2000" rows={3}></WorkspaceControl></label></div></fieldset><fieldset class="submission-field-group"><legend>{layout.optional}</legend><p class="submission-hint">{layout.optionalHint}</p><div class="gallery-photo-fields submission-field-grid"><label>{imageLibraryCopy(locale).purpose}<WorkspaceControl as="select" data-default="purpose"><option value="gallery">{imageLibraryCopy(locale).gallery}</option><option value="entry">{imageLibraryCopy(locale).entry}</option></WorkspaceControl></label><label>{copy.type}<WorkspaceControl as="select" data-default="mediaType"><option value="">{copy.noType}</option></WorkspaceControl></label><label>{copy.tags}<WorkspaceControl data-default="tags" maxlength="500"/></label></div><div class="gallery-photo-entities"><SubmissionField id="photo-shared-entities" label={copy.entities}><WorkspaceControl id="photo-shared-entities" type="search" placeholder={copy.findEntity} data-entity-search/></SubmissionField><div data-entity-options></div></div></fieldset></SubmissionPanel>
   <SubmissionPanel title={copy.photos} class="gallery-photo-section gallery-photo-media"><label class="gallery-photo-drop" data-photo-drop><WorkspaceControl type="file" accept={galleryImageAccept} title={galleryHeicCopy(locale).note} multiple data-photo-files/><strong>{copy.drop}</strong><span>{copy.limit}</span><small>{galleryHeicCopy(locale).note}</small></label><div data-photo-list><p>{copy.empty}</p></div>
    <template data-photo-title-template><SubmissionField id="photo-title" label={copy.photoTitle} required>
     <WorkspaceControl data-row-title required maxlength="200" placeholder={formCopy.titleHint}/>
    </SubmissionField></template></SubmissionPanel>
  </div>
  <aside class="gallery-photo-actions"><h2>{copy.submit}</h2><UploadDraftStatus locale={locale}/><p data-photo-status role="status" aria-live="polite">{copy.status}</p><div class="gallery-photo-count" data-photo-count>0</div><WorkspaceToolbar class="gallery-photo-submit-tools"><WorkspaceButton type="button" data-photo-save>{copy.save}</WorkspaceButton><WorkspaceButton type="button" data-photo-stage>{copy.stage}</WorkspaceButton><WorkspaceButton type="button" data-photo-submit tone="primary">{copy.submit}</WorkspaceButton></WorkspaceToolbar><a class="gallery-photo-action-link" data-photo-receipt hidden href={`/${locale}/account/creator/`}>{copy.receipt} <Icon name="arrow-right" /></a><a class="gallery-photo-action-link" data-photo-login hidden href={`/${locale}/account/`}>{copy.login} <Icon name="arrow-right" /></a></aside>
 </div>
 <dialog class="gallery-photo-inspector" data-photo-inspector aria-labelledby="photo-inspector-title"><header><h2 id="photo-inspector-title" data-photo-inspector-title>{guidance.inspectorTitle}</h2><WorkspaceButton type="button" data-photo-inspector-close>{guidance.inspectorClose}</WorkspaceButton></header><div data-photo-inspector-body></div></dialog>
 <dialog class="gallery-photo-success" data-photo-success aria-labelledby="photo-success-title"><div class="gallery-photo-success__mark" aria-hidden="true"><Icon name="check" size={30}/></div><p class="gallery-photo-success__eyebrow">REVIEW / RECEIVED</p><h2 id="photo-success-title">{copy.successTitle}</h2><p>{copy.successNote}</p><div><a class="gallery-photo-action-link" data-photo-success-link href={`/${locale}/account/creator/`}>{copy.receipt} <Icon name="arrow-right" /></a><WorkspaceButton type="button" data-photo-success-close>{copy.successClose}</WorkspaceButton></div></dialog>
</WorkspaceLayout>
<script>import '../../../../scripts/galleryPhotoUploader.js';</script>
