---
import {pageLabels} from '../../lib/pageLabels.mjs';
import WorkspaceButton from '../../components/WorkspaceButton.astro';
import WorkspaceControl from '../../components/WorkspaceControl.astro';
import Icon from '../../components/Icon.astro';
import WorkspaceShell from '../../components/WorkspaceShell.astro';
import WorkspaceHeader from '../../components/WorkspaceHeader.astro';
import {accountWorkspaceCopy} from '../../lib/accountWorkspaceCopy.mjs';
import AppearanceControls from '../../components/AppearanceControls.astro';
import AccountSections from '../../components/AccountSections.astro';
import {getBuildCollection as getCollection} from '../../lib/contentAuditContext';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LibraryPanel from '../../components/labs/LibraryPanel.astro';
import {getLocalizedSite} from '../../lib/homeData.mjs';
import {buildLocaleLinks,supportedLocales} from '../../lib/i18n.mjs';
import {editorEnabled} from '../../lib/editorConfig.mjs';
import {accountCopy} from '../../lib/accountCopy.mjs';
import {labsCopy} from '../../lib/labsCopy.mjs';
import '../../styles/account.css';
import '../../styles/labs.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale||'zh', c=accountCopy(locale), site=getLocalizedSite(await getCollection('site'),locale);
const ui=accountWorkspaceCopy(locale);
const libraryCopy={...labsCopy(locale),savedLocal:c.library,storageNote:c.privacy};
---
<BaseLayout lang={locale} title={`${c.title} · KAMITSUBAKI Wiki`} metadata={{noindex:true}}>
  <SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/account/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
  <WorkspaceShell width="wide" class="account-shell" data-account-page data-summary-error={ui.summaryError}>
    <WorkspaceHeader title={c.title} intro={ui.intro} eyebrow="MY OBSERVATORY" backHref={`/${locale}/`} backLabel={pageLabels(locale).home}><Fragment slot="status"><p data-account-action-status role="status"></p><WorkspaceButton type="submit" class="account-button" data-account-reload hidden>{c.reloadAccount}</WorkspaceButton></Fragment></WorkspaceHeader>
    <noscript>{c.javascript}</noscript>
    <section class="account-gate account-surface" data-account-gate><header class="account-panel-heading"><span class="account-kicker">ACCOUNT / ACCESS</span><h2 data-account-gate-title>{c.loginTitle}</h2><p>{c.loginNote}</p></header><WorkspaceButton type="submit" tone="primary" class="account-button account-primary" data-account-login>{c.login}</WorkspaceButton><WorkspaceButton data-account-retry hidden>{ui.retry}</WorkspaceButton></section>
    <div class="account-workspace" data-account-workspace hidden><AccountSections locale={locale}/><div class="account-panels">
    <section data-account-panel="overview" class="account-section account-overview">
      <header class="account-home-header"><div><p class="account-kicker">{c.title}</p><h2 class="account-overview-identity" data-account-identity data-guest-title={ui.welcome}>{ui.welcome}</h2><p class="account-note">{ui.welcomeNote}</p></div><div class="account-home-header-actions"><a class="account-overview-primary" href={`/${locale}/contribute/`}>{ui.newSubmission}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></a><a class="account-overview-secondary" href={`/${locale}/account/creator/`}>{ui.openCreator}<span aria-hidden="true"><Icon name="arrow-right" /></span></a></div></header>
      <section class="account-overview-guest" data-account-overview-guest data-checking-title={ui.checkingTitle} data-checking-note={ui.checkingNote} data-unavailable-title={ui.unavailableTitle} data-unavailable-note={ui.unavailableNote} data-guest-eyebrow={ui.guestEyebrow} data-guest-title={ui.guestTitle} data-guest-note={ui.guestNote}><div><span class="account-kicker" data-guest-eyebrow>{ui.guestEyebrow}</span><h3 data-guest-title>{ui.guestTitle}</h3><p data-guest-note>{ui.guestNote}</p></div><div class="account-guest-actions"><WorkspaceButton tone="primary" type="button" class="account-button account-primary" data-account-login>{ui.guestAction} <Icon name="arrow-right" /></WorkspaceButton><WorkspaceButton type="button" class="account-button" data-account-retry hidden>{ui.retry}</WorkspaceButton></div></section>
      <div class="account-home-grid">
        <section class="account-home-work"><span class="account-kicker">01 / {ui.workArea}</span><h3>{ui.creator}</h3><p>{ui.writeNote}</p>
          <div class="account-overview-progress" data-account-overview-progress hidden>
            <a href={`/${locale}/account/creator/?state=attention`}><span>{ui.attention}</span><strong data-account-summary="attention">—</strong></a>
            <a href={`/${locale}/account/creator/?state=draft`}><span>{ui.draft}</span><strong data-account-summary="draft">—</strong></a>
            <a href={`/${locale}/account/creator/?state=review`}><span>{ui.review}</span><strong data-account-summary="review">—</strong></a>
          </div>
          <p class="account-overview-summary-status" data-account-overview-summary-status role="status"></p>
          <div class="account-home-actions"><a href={`/${locale}/account/creator/`}>{ui.openCreator}<span aria-hidden="true"><Icon name="arrow-right" /></span></a></div>
        </section>
        <section class="account-home-library"><span class="account-kicker">02 / {ui.saved}</span><h3>{c.library}</h3><p>{ui.savedNote}</p><div data-account-recent data-empty-label={ui.empty}><p>{ui.empty}</p></div><a class="account-home-library-link" href="#library">{ui.open}<span aria-hidden="true"><Icon name="arrow-right" /></span></a></section>
      </div>
      <section class="account-home-settings"><div><span class="account-kicker">03 / ACCOUNT</span><h3>{ui.settingsArea}</h3><p>{ui.settingsNote}</p></div><nav aria-label={ui.settingsArea}><a href="#profile">{c.profile}<span aria-hidden="true"><Icon name="arrow-right" /></span></a><a data-account-security href="#security">{ui.security}<span aria-hidden="true"><Icon name="arrow-right" /></span></a><a href="#data">{c.data}<span aria-hidden="true"><Icon name="arrow-right" /></span></a><a href="#appearance">{ui.appearance}<span aria-hidden="true"><Icon name="arrow-right" /></span></a></nav></section>
    </section>
    <section data-account-panel="appearance" class="account-section account-surface" hidden><header class="account-panel-heading"><span class="account-kicker">04 / APPEARANCE</span><h2>{ui.appearance}</h2><p>{ui.settingsNote}</p></header><AppearanceControls locale={locale}/></section>

    <section data-account-panel="library" class="account-section account-surface account-library-panel" hidden><header class="account-panel-heading"><span class="account-kicker">02 / LIBRARY</span><h2>{c.library}</h2><p>{ui.savedNote}</p></header><p class="account-note">{c.privacy}</p><div data-account-library data-copy={JSON.stringify(libraryCopy)}><LibraryPanel copy={libraryCopy} locale={locale}/></div></section>
    <section class="account-section" data-account-panel="library" data-account-member hidden><details><summary>{c.importTitle}</summary><p>{c.importNote}</p><WorkspaceButton type="submit" class="account-button" data-guest-preview>{c.preview}</WorkspaceButton><div data-guest-preview-result hidden><p data-guest-count></p><ul class="account-import-items" data-guest-items></ul><div class="account-actions"><WorkspaceButton type="submit" class="account-button" data-guest-merge>{c.merge}</WorkspaceButton><WorkspaceButton type="submit" class="account-button" data-guest-cancel>{c.importCancel}</WorkspaceButton></div></div></details></section>
    <section data-account-panel="profile" class="account-section account-surface" data-account-member hidden><header class="account-panel-heading"><span class="account-kicker">03 / PROFILE</span><h2>{c.profile}</h2><p>{ui.profileNote}</p></header><div data-profile-component></div><p data-profile-status role="status"></p></section>    <section data-account-panel="data" class="account-section account-surface" data-account-member hidden><header class="account-panel-heading"><span class="account-kicker">06 / DATA</span><h2>{c.data}</h2></header><p>{c.exportNote}</p><div class="account-actions"><WorkspaceButton type="submit" class="account-button" data-account-export>{c.export}</WorkspaceButton><WorkspaceButton type="submit" class="account-button" data-ai-export>{c.exportAI}</WorkspaceButton></div><details class="account-delete"><summary>{c.requestDelete}</summary><p>{c.deleteNote}</p><form data-deletion-form><label>{c.deleteConfirm}<WorkspaceControl name="confirmation" required pattern="DELETE" autocomplete="off"/></label><WorkspaceButton class="account-button" type="submit">{c.requestDelete}</WorkspaceButton></form></details><p data-deletion-status role="status"></p><WorkspaceButton type="submit" class="account-button" data-deletion-cancel hidden>{c.cancelDelete}</WorkspaceButton><p data-data-status role="status"></p></section>
    </div></div>
  </WorkspaceShell>
  <SiteFooter footer={site.footer}/>
</BaseLayout>
<script>
import '../../scripts/accountNavigation.js';
import '../../scripts/accountContributionBadge.js';
import '../../scripts/accountOverview.js';
import {initializeAccountPage} from '../../scripts/accountPage.js';
const start=()=>{try{initializeAccountPage();window.dispatchEvent(new Event('kamitsubaki-account-state'));}catch(error){console.error('Account workspace initialization failed',error);const status=document.querySelector('[data-account-action-status]'),guest=document.querySelector<HTMLElement>('[data-account-overview-guest]');if(status)status.textContent=[guest?.dataset.unavailableTitle,guest?.dataset.unavailableNote].filter(Boolean).join(' ')||'Account workspace unavailable. Refresh to retry.';}};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();
</script>
