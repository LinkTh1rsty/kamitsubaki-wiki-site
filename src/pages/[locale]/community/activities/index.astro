---
import WorkspaceShell from '../../../../components/WorkspaceShell.astro';
import { getBuildCollection as getCollection } from '../../../../lib/contentAuditContext';
import ActivityCenter from '../../../../components/ActivityCenter.astro';
import {activityCopy} from '../../../../lib/activityCopy.mjs';
import SiteFooter from '../../../../components/SiteFooter.astro';
import SiteNav from '../../../../components/SiteNav.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getLocalizedSite } from '../../../../lib/homeData.mjs';
import { buildLocaleLinks, defaultLocale, supportedLocales } from '../../../../lib/i18n.mjs';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const localeCode = locale as 'zh' | 'zh-tw' | 'zh-hk' | 'ja' | 'en';
const siteEntries = await getCollection('site');
const homeContent = getLocalizedSite(siteEntries, localeCode, defaultLocale);
const copy = homeContent.liveEvents;
const centerCopy=activityCopy(localeCode);
const currentPath = '/community/activities/';
const localeLinks = buildLocaleLinks(homeContent, localeCode, currentPath);
const alternates = supportedLocales.map((code) => ({ locale: code, href: `/${code}${currentPath}` }));
const metadata = {
  title: `${centerCopy.title} - Kamitsubaki Wiki`,
  description: centerCopy.intro,
  canonicalPath: `/${localeCode}${currentPath}`,
};
---

<BaseLayout lang={localeCode} alternates={alternates} metadata={metadata}>
  <div class="events-page min-h-screen">
    <SiteNav
      navItems={homeContent.navItems}
      localeLinks={localeLinks}
      brandLines={homeContent.hero.brandLines}
      compact
      homeHref={`/${localeCode}/`}
    />

    <WorkspaceShell width="wide" class="events-page__main">
      <ActivityCenter locale={localeCode} source="community" />
    </WorkspaceShell>

    <SiteFooter footer={homeContent.footer} />
  </div>
</BaseLayout>
