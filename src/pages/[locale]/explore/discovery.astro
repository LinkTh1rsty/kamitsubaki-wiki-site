---
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import WorkspaceButton from '../../../components/WorkspaceButton.astro';
import DiscoveryEntry from '../../../components/DiscoveryEntry.astro';
import { getEntityRegistry, entityLocales } from '../../../lib/entityRegistry.mjs';
import { loadFeatureData } from '../../../lib/featureData.mjs';
import { buildDiscoveryCatalog } from '../../../lib/discoveryCatalog.mjs';
import { loadDiscoveryArticles } from '../../../lib/discoveryArticles.mjs';
import { createDiscoveryEngine, readDiscoveryState, discoveryDay } from '../../../lib/discoveryEngine.mjs';
import { discoveryCopy } from '../../../lib/discoveryCopy.mjs';
import { discoveryFormat } from '../../../lib/discoveryPresentation.mjs';
import '../../../styles/discovery.css';
export function getStaticPaths() { return entityLocales.map(locale => ({ params: { locale } })); }
const { locale = 'zh' } = Astro.params;
const c = discoveryCopy(locale), catalog = buildDiscoveryCatalog(await getEntityRegistry(), await loadFeatureData(), locale, await loadDiscoveryArticles());
const day = discoveryDay(), initial = createDiscoveryEngine(catalog).plan(readDiscoveryState(new URLSearchParams(), day));
---
<WorkspaceLayout locale={locale} title={c.title} intro={c.intro} path="/explore/discovery/" eyebrow="DISCOVERY / DAILY" width="wide"
  backHref={`/${locale}/explore/`} backLabel={c.back} mainAttributes={{ 'data-discovery-app': '', 'data-discovery-catalog': `/${locale}/discovery-catalog.json`, 'data-locale': locale }}>
  <dl class="discovery-metrics">{[[c.entities, catalog.summary.entities], [c.styled, catalog.summary.styled], [c.relations, catalog.summary.connections], [c.dayMetric, day]].map(([title, value]) =>
    <div><dt>{title}</dt><dd data-discovery-day-metric={title === c.dayMetric || undefined}>{value}</dd></div>)}</dl>
  <p class="discovery-note">{c.note}</p>
  <p class="discovery-note">{c.articles.replace('{count}', String(catalog.summary.articles || 0))}{catalog.articleCoverage !== 'complete' && <> · {c.articleIncomplete}</>}</p>
  <p data-discovery-load-status role="status" aria-live="polite">{c.loading}</p>
  <WorkspaceButton data-discovery-retry hidden>{c.retry}</WorkspaceButton><a data-discovery-reload href={`/${locale}/explore/discovery/`} hidden>{c.retry} ↗</a>
  <details class="discovery-preferences" data-discovery-preferences hidden>
    <summary>{c.preferences}</summary>
  <form data-discovery-form hidden aria-label={c.preferences}>
    <fieldset aria-label={c.preferences}>
      <div class="discovery-fields">
        {[0, 1, 2].map(index => <label><span>{index ? c.extraArtist : c.artist}</span><select name="artist"><option value="">{c.all}</option></select></label>)}
        <label><span>{c.kind}</span><select name="kind"><option value="">{c.all}</option></select></label>
        <label><span>{c.style}</span><select name="style"><option value="">{c.all}</option></select></label>
        <label><span>{c.year}</span><input type="number" name="year" min="1000" max="9999" step="1" inputmode="numeric" placeholder="2020" /></label>
        <label><span>{c.radius}</span><select name="radius"><option value="2">{c.around.replace('{count}', '2')}</option><option value="0">{c.exactYear}</option><option value="5">{c.around.replace('{count}', '5')}</option></select></label>
        <label><span>{c.length}</span><select name="length">{[5, 3, 7].map(count => <option value={count}>{c.stations.replace('{count}', String(count))}</option>)}</select></label>
        <label><span>{c.day}</span><input type="date" name="day" value={day} required /></label>
        <label class="discovery-wide"><span>{c.start}</span><input name="start" type="search" list="discovery-start-options" placeholder={c.startPlaceholder} autocomplete="off" /></label>
        <label class="discovery-wide"><span>{c.query}</span><input name="q" type="search" maxlength="160" placeholder={c.queryPlaceholder} autocomplete="off" /></label>
      </div>
      <datalist id="discovery-start-options" data-discovery-options></datalist>
      <div class="discovery-form-actions"><label class="discovery-checkbox"><input type="checkbox" name="events" />{c.events}</label><WorkspaceButton type="submit" tone="primary">{c.apply}</WorkspaceButton><WorkspaceButton type="reset" tone="quiet">{c.reset}</WorkspaceButton></div>
      <p class="discovery-note">{c.preferenceHint}</p><p data-discovery-status role="status" aria-live="polite"></p>
    </fieldset>
  </form>
  </details>
  <section class="discovery-route-section" aria-labelledby="discovery-route-title">
    <header class="discovery-section-header"><div><span>01 / DAILY ROUTE</span><h2 id="discovery-route-title" tabindex="-1" data-discovery-route-title>{c.routeTitle}</h2><p>{c.routeIntro}</p></div>
      <div class="discovery-actions" data-discovery-controls hidden><WorkspaceButton data-discovery-reroll>{c.reroll}</WorkspaceButton><WorkspaceButton tone="quiet" data-discovery-today>{c.today}</WorkspaceButton><WorkspaceButton data-discovery-share>{c.share}</WorkspaceButton></div>
    </header>
    <p class="discovery-note"><time data-discovery-day datetime={day}>{day}</time> · {c.utc}</p>
    <p class="discovery-note">{c.routeNote}</p>
    <ol class="discovery-route" data-discovery-route>{initial.route.map((record, index) => <DiscoveryEntry record={record} index={index} route catalog={catalog} copy={c} locale={locale} />)}</ol>
    <p data-discovery-route-empty hidden>{c.routeEmpty}</p><p class="discovery-note" data-discovery-route-short hidden>{c.shortRoute}</p>
    <div class="discovery-route-navigation" data-discovery-controls hidden>
      <WorkspaceButton data-discovery-previous>{c.previous}</WorkspaceButton><p data-discovery-progress role="status"></p><WorkspaceButton data-discovery-next>{c.next}</WorkspaceButton>
    </div>
    <p data-discovery-share-status role="status"></p><input data-discovery-share-url class="discovery-share-url" aria-label={c.share} readonly hidden />
  </section>
  <section class="discovery-recommendations" aria-labelledby="discovery-recommendations-title">
    <header class="discovery-section-header"><div><span>02 / DISCOVER MORE</span><h2 id="discovery-recommendations-title">{c.recommendations}</h2></div><p data-discovery-count role="status" aria-live="polite">{discoveryFormat(c.results, { shown: Math.min(12, initial.items.length), total: initial.items.length })}</p></header>
    <ul class="discovery-records" data-discovery-results>{initial.items.slice(0, 12).map(record => <DiscoveryEntry record={record} catalog={catalog} copy={c} locale={locale} />)}</ul>
    <div data-discovery-empty hidden><p>{c.noMatches}</p><p class="discovery-note">{c.loosen}</p><WorkspaceButton data-discovery-clear-style hidden>{c.clearStyle}</WorkspaceButton></div>
    <WorkspaceButton data-discovery-more data-discovery-controls hidden>{c.more}</WorkspaceButton>
  </section>
  <noscript><style is:inline>[data-discovery-load-status]{display:none}</style><p class="discovery-note">{c.nojs}</p></noscript>
  <script is:inline type="application/json" data-discovery-copy set:html={JSON.stringify(c).replace(/</g, '\\u003c')} />
  <script is:inline>
    window.setTimeout(() => {
      const root = document.querySelector('[data-discovery-app]'), status = root?.querySelector('[data-discovery-load-status]'), config = root?.querySelector('[data-discovery-copy]'), reload = root?.querySelector('[data-discovery-reload]');
      if (!root || !status || !config || !reload || root.dataset.discoveryInitialized === 'true') return;
      const copy = JSON.parse(config.textContent || '{}');
      if (status.textContent !== copy.loading) return;
      status.textContent = copy.failure; reload.href = location.href; reload.hidden = false;
    }, 14000);
  </script>
  <script>import '../../../scripts/discoveryApp.js';</script>
</WorkspaceLayout>
