---
import Icon from './Icon.astro';
import WorkspaceButton from './WorkspaceButton.astro';
import {supportCatalog} from '../lib/supportCatalog.mjs';
import {supportExperienceCopy} from '../lib/supportExperienceCopy.mjs';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
const {locale='zh'}=Astro.props,c=supportExperienceCopy(locale),tiers=supportCatalog.tiers;
const text=resolveLocaleCopy({
 zh:{label:'支持方案',cta:'前往爱发电支持',ctaNote:'在爱发电完成支付，可随时调整或取消。',other:'微信 / 支付宝扫码',uses:['服务器、域名与 CDN','图库存储与 AI 接口','资料整理与持续维护'],usesLabel:'你的支持会用于',recommended:'推荐',groups:'观测者组别',custom:'自选金额',customNote:'任意金额，一次或每月',long:'长期支援',wall:'查看感谢名单',free:'Wiki 永远免费开放，支持不解锁任何内容。'},
 ja:{label:'支援プラン',cta:'愛発電で支援する',ctaNote:'決済は愛発電で完了。いつでも変更・解約できます。',other:'WeChat / Alipay のQR',uses:['サーバー・ドメイン・CDN','画像ストレージと AI API','資料整理と継続的な保守'],usesLabel:'支援の使いみち',recommended:'おすすめ',groups:'観測者グループ',custom:'金額を自由に',customNote:'任意の金額で',long:'長期サポート',wall:'謝辞一覧を見る',free:'Wiki は常に無料で公開。支援で解放される内容はありません。'},
 en:{label:'Support plans',cta:'Support on Afdian',ctaNote:'Pay on Afdian; change or cancel any time.',other:'WeChat / Alipay QR',uses:['Servers, domain and CDN','Gallery storage and AI API','Archive work and maintenance'],usesLabel:'Where support goes',recommended:'Popular',groups:'Observer groups',custom:'Custom amount',customNote:'Any amount you choose',long:'Long-term support',wall:'See acknowledgements',free:'The Wiki stays free for everyone; support unlocks nothing.'}
},locale);
const tier=(id:string)=>tiers.find(item=>item.id===id)!;
const cards=[
 {key:'observer',tier:tier('observer'),note:c.base[0]},
 {key:'group',tier:tier('koko'),note:c.group[0],featured:true},
 {key:'joint',tier:tier('joint'),note:c.joint[0]}
];
const long=tier('long-term');
---
<section class="support-hero" aria-labelledby="support-hero-title" data-support-hero>
 <div class="support-hero__lead">
  <p class="support-eyebrow">{text.usesLabel}</p>
  <h2 id="support-hero-title">{c.quickNote}</h2>
  <ul class="support-hero__uses">{text.uses.map((item:string)=><li>{item}</li>)}</ul>
  <div class="support-hero__actions">
   <WorkspaceButton tone="primary" class="support-hero__cta" href={supportCatalog.planUrl} target="_blank" rel="noopener noreferrer" data-support-primary>{text.cta}<Icon name="arrow-up-right"/></WorkspaceButton>
   <button type="button" class="support-hero__alt" data-support-open data-support-preferred-channel="wechat">{text.other}</button>
  </div>
  <p class="support-hero__note">{text.ctaNote} {text.free}</p>
 </div>
 <ul class="support-hero__plans" aria-label={text.label}>
  {cards.map(card=><li><a class="support-plan" data-featured={card.featured?'':undefined} href={supportCatalog.planUrl} target="_blank" rel="noopener noreferrer">
   {card.featured&&<span class="support-plan__badge">{text.recommended}</span>}
   <span class="support-plan__price"><strong>¥{card.tier.monthlyAmount}</strong><span>{c.month}</span></span>
   <span class="support-plan__name">{card.key==='group'?text.groups:card.tier.name}</span>
   <span class="support-plan__note">{card.note}</span>
  </a></li>)}
  <li><a class="support-plan support-plan--custom" href={supportCatalog.planUrl} target="_blank" rel="noopener noreferrer">
   <span class="support-plan__price"><strong>{text.custom}</strong></span>
   <span class="support-plan__note">{text.customNote}</span>
  </a></li>
 </ul>
 <p class="support-hero__more"><span>{text.long} ¥{long.monthlyAmount} {c.month}</span><a href="#sponsor-wall">{text.wall}<Icon name="arrow-right"/></a></p>
</section>
