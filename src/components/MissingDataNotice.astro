---
interface MissingDataIssue {
  kind: string;
  severity: 'info' | 'warning';
  refs?: string[];
}

interface Props {
  issues: MissingDataIssue[];
  summary: { total: number; warnings: number; infos: number };
  labels: {
    eyebrow: string;
    summary: string;
    details: string;
    edit: string;
    kinds: Record<string, string>;
    fieldNames?: Record<string, string>;
    localeNames?: Record<string, string>;
    severityWarning: string;
    severityInfo: string;
  };
  editHref: string;
}

const { issues, summary, labels, editHref } = Astro.props;

function formatIssue(issue: MissingDataIssue) {
  const kindLabel = labels.kinds[issue.kind] ?? issue.kind;
  const refs = issue.refs ?? [];

  if (issue.kind === 'missing-fields' && refs.length > 0) {
    const names = refs.map((ref) => labels.fieldNames?.[ref] ?? ref);
    return `${kindLabel}：${names.join('、')}`;
  }

  if (issue.kind === 'missing-locale' && refs.length > 0) {
    const names = refs.map((ref) => labels.localeNames?.[ref] ?? ref);
    return `${kindLabel}：${names.join('、')}`;
  }

  if (refs.length > 0) {
    return `${kindLabel}：${refs.join('、')}`;
  }

  return kindLabel;
}

function severityMark(severity: MissingDataIssue['severity']) {
  return severity === 'warning' ? '!' : 'i';
}

function hasWarning() {
  return summary.warnings > 0;
}
---

{
  issues.length > 0 && (
    <aside
      class="not-prose missing-data-notice mb-6 rounded-md border border-white/10 bg-white/[0.025] p-4 text-left sm:p-5"
      data-missing-data
      data-missing-total={summary.total}
      aria-label={labels.eyebrow}
    >
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="font-mono text-[9px] uppercase tracking-[0.22em] text-white/35">{labels.eyebrow}</p>
          <p class:list={[
            'mt-2 text-sm leading-6',
            hasWarning() ? 'text-amber-50/75' : 'text-white/62',
          ]}>
            <span
              class:list={[
                'mr-2 inline-flex h-4 min-w-4 items-center justify-center rounded-sm px-1 font-mono text-[10px] leading-none',
                hasWarning() ? 'bg-amber-200/15 text-amber-50/90' : 'bg-cyan-200/10 text-cyan-50/70',
              ]}
              aria-hidden="true"
            >
              {hasWarning() ? severityMark('warning') : severityMark('info')}
            </span>
            {labels.summary}
          </p>
        </div>
        <a
          href={editHref}
          class="inline-flex shrink-0 items-center rounded-sm border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-cyan-50/70 transition-colors hover:border-white/20 hover:text-cyan-50"
        >
          {labels.edit}
        </a>
      </div>

      <details class="mt-4 border-t border-white/8 pt-3">
        <summary class="cursor-pointer list-none font-mono text-[10px] uppercase tracking-[0.18em] text-white/45 transition-colors hover:text-white/70">
          {labels.details}
        </summary>
        <ul class="mt-3 grid gap-2">
          {issues.map((issue) => (
            <li class="flex items-start gap-2 text-xs leading-5 text-white/58 sm:text-[13px]">
              <span
                class:list={[
                  'mt-0.5 inline-flex h-4 min-w-4 shrink-0 items-center justify-center rounded-sm px-1 font-mono text-[10px] leading-none',
                  issue.severity === 'warning'
                    ? 'bg-amber-200/15 text-amber-50/90'
                    : 'bg-cyan-200/10 text-cyan-50/70',
                ]}
                title={issue.severity === 'warning' ? labels.severityWarning : labels.severityInfo}
              >
                {severityMark(issue.severity)}
              </span>
              <span class="min-w-0 break-words">{formatIssue(issue)}</span>
            </li>
          ))}
        </ul>
      </details>
    </aside>
  )
}

<style>
  .missing-data-notice summary::-webkit-details-marker {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .missing-data-notice,
    .missing-data-notice * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
