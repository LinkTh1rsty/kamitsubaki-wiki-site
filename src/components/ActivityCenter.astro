---
import WorkspaceButton from './WorkspaceButton.astro';
import WorkspaceControl from './WorkspaceControl.astro';
import Icon from './Icon.astro';
import ContentSkeleton from './ContentSkeleton.astro';
import {activityCopy} from '../lib/activityCopy.mjs';
import '../styles/community.css';
import '../styles/activityCenter.css';
const {locale='zh',source='community'}=Astro.props,c=activityCopy(locale);
const api=import.meta.env.PUBLIC_COMMUNITY_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
---
<section class="activity-center" data-ui-kit data-activity-center data-source={source} data-locale={locale} data-api={api} data-copy={JSON.stringify(c)}>
 <a class="activity-home activity-text-action" href={`/${locale}/`}><Icon name="arrow-left"/>{c.home}</a>
 <header class="activity-head"><div class="activity-heading"><h1>{c.title}</h1><p>{c.intro}</p></div><div class="activity-head-navigation"><nav class="activity-tabs dui-tabs dui-tabs-box" aria-label={c.title}>
  <a class="dui-tab" href={`/${locale}/community/activities/`} aria-current={source==='community'?'page':undefined} data-activity-tab="community" aria-label={c.communityTab}><span class="activity-label-full">{c.communityTab}</span><span class="activity-label-short" aria-hidden="true">{c.communityTabShort}</span></a>
  <a class="dui-tab" href={`/${locale}/events/?source=official`} aria-current={source==='official'?'page':undefined} data-activity-tab="official" aria-label={c.officialTab}><span class="activity-label-full">{c.officialTab}</span><span class="activity-label-short" aria-hidden="true">{c.officialTabShort}</span></a>
 </nav><a class="activity-text-action activity-apply" href={`/${locale}/community/activities/apply/?kind=promotion`} aria-label={c.publishProject}><span class="activity-label-full">{c.publishProject}</span><span class="activity-label-short" aria-hidden="true">{c.publishProjectShort}</span><Icon name="arrow-up-right"/></a></div></header>
 <form data-activity-filters class="activity-filters activity-bar">
  <div class="activity-month-step"><WorkspaceButton tone="quiet" data-activity-prev aria-label={c.previous}><Icon name="chevron-left"/></WorkspaceButton><label><span class="sr-only">{c.month}</span><WorkspaceControl name="month" type="month" aria-label={c.month}/></label><WorkspaceButton tone="quiet" data-activity-next aria-label={c.next}><Icon name="chevron-right"/></WorkspaceButton><WorkspaceButton tone="quiet" data-activity-today>{c.today}</WorkspaceButton></div>
  <div data-activity-range-slot><div class="activity-ranges"><WorkspaceButton tone="quiet" data-activity-range="next">{c.nearby}</WorkspaceButton><WorkspaceButton tone="quiet" data-activity-range="deadline" data-community-only>{c.deadlineView}</WorkspaceButton><WorkspaceButton tone="quiet" data-activity-range="past">{c.past}</WorkspaceButton></div></div>
  <div class="activity-search" data-activity-search-slot><label class="activity-query"><span class="sr-only">{c.keyword}</span><Icon name="search"/><WorkspaceControl type="search" name="q" data-activity-q placeholder={c.keyword}/></label></div>
  <details data-activity-filter-details><summary class="activity-filter-trigger workspace-button dui-btn dui-btn-ghost" data-ui-kit>{c.filterShort}<Icon name="chevron-down"/></summary><div class="activity-filter-surface" data-filter-surface>
   <div data-activity-mobile-controls></div>
   <label data-official-only><span>{c.allArtists}</span><WorkspaceControl as="select" name="artist"><option value="">{c.allArtists}</option></WorkspaceControl></label>
   <div class="activity-location-filters" data-community-only data-location-root>
    <label><span>{c.country}</span><WorkspaceControl as="select" name="country"><option value="">{c.all}</option></WorkspaceControl></label>
    <label><span>{c.subdivisionCode}</span><WorkspaceControl as="select" name="subdivisionCode"><option value="">{c.all}</option></WorkspaceControl></label>
    <label><span>{c.city}</span><WorkspaceControl as="select" name="cityId"><option value="">{c.all}</option></WorkspaceControl></label><input name="city" type="hidden"/>
    <label><span>{c.mode}</span><WorkspaceControl as="select" name="mode"><option value="">{c.all}</option>{['online','offline','hybrid'].map(key=><option value={key}>{c[key]}</option>)}</WorkspaceControl></label>
    <label><span>{c.category}</span><WorkspaceControl as="select" name="category"><option value="">{c.all}</option>{['new-year','support','meetup','convention','other'].map(key=><option value={key}>{c[key]}</option>)}</WorkspaceControl></label><p data-location-status role="status"></p><WorkspaceButton data-location-retry hidden>{c.retry}</WorkspaceButton>
   </div>
   <label class="activity-deadline-toggle" data-community-only><WorkspaceControl type="checkbox" name="deadlines" data-activity-deadlines checked/>{c.pointToggle}</label>
   <WorkspaceButton data-activity-clear tone="quiet" hidden>{c.clear}</WorkspaceButton>
  </div></details>
  <div data-activity-view-slot><div class="activity-view"><WorkspaceButton tone="quiet" data-activity-view="calendar" aria-pressed="false"><Icon name="calendar-days"/>{c.calendar}</WorkspaceButton><WorkspaceButton tone="quiet" data-activity-view="agenda" aria-pressed="false"><Icon name="list"/>{c.agenda}</WorkspaceButton></div></div>
 </form>
 <p data-activity-status role="status" aria-live="polite"></p><WorkspaceButton data-activity-retry hidden>{c.retry}</WorkspaceButton>
 <section data-activity-featured-section hidden><h2 class="sr-only">{c.featuredTitle}</h2><div data-activity-featured data-activity-featured-list class="activity-card-grid"></div></section>
 <div class="activity-master-detail" data-activity-calendar-panel><div class="activity-calendar-surface"><ContentSkeleton kind="calendar" count={5} data-activity-loading/><div class="activity-native" data-activity-native></div></div><section data-activity-day><div class="activity-section-title"><h2 data-activity-day-title>{c.selectedDay}</h2><WorkspaceButton data-activity-day-close tone="quiet" hidden>{c.close}</WorkspaceButton></div><div data-activity-day-list aria-live="polite" class="activity-card-grid"></div></section></div>
 <section data-activity-agenda hidden><div class="activity-section-title"><h2 data-activity-agenda-title>{c.agenda}</h2><span data-activity-search-scope></span></div><ContentSkeleton kind="lines" count={2} data-activity-agenda-loading hidden/><div data-activity-agenda-list aria-live="polite"></div><WorkspaceButton data-activity-older hidden>{c.older}</WorkspaceButton></section>
 <section data-activity-undated hidden><div class="activity-section-title"><h2>{c.undated}</h2></div><div class="activity-card-grid" data-activity-undated-list></div></section>
 <section data-activity-past-archive><div class="activity-section-title"><h2>{c.pastArchive}</h2><WorkspaceButton data-activity-past-all tone="quiet">{c.pastAll} →</WorkspaceButton></div><p data-activity-archive-status role="status"></p><WorkspaceButton data-activity-archive-retry hidden>{c.retry}</WorkspaceButton><div class="activity-card-grid" data-activity-archive-list></div></section>
 <dialog data-activity-event-modal class="activity-event-modal" aria-label={c.activityInfo}><WorkspaceButton data-activity-modal-close>{c.close}</WorkspaceButton><div data-activity-modal-body></div></dialog>
 <div data-activity-hover-card class="activity-hover-card" role="region" aria-label={c.activityInfo} hidden></div>
 <footer class="community-subscription"><a class="activity-text-action" href={`/${locale}/community/activities/apply/`}>{c.contributeInfo}<Icon name="arrow-up-right"/></a><p>{c.subscriptionHint} {c.basis}</p><div class="community-actions"><WorkspaceButton data-activity-subscribe href="#"><Icon name="calendar-days"/>{c.subscribe}</WorkspaceButton><WorkspaceButton data-activity-copy-subscription tone="quiet">{c.copySubscription}</WorkspaceButton></div></footer>
</section>
<script>import {initActivityCenter} from '../scripts/activityCenter.js';document.querySelectorAll('[data-activity-center]').forEach(initActivityCenter);</script>
