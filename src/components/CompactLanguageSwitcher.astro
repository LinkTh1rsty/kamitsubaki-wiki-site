---
import WorkspaceButton from './WorkspaceButton.astro';
import Icon from './Icon.astro';
type LocaleLink = {
  code: string;
  label: string;
  shortLabel: string;
  navShortLabel?: string;
  dropdownLabel?: string;
  href: string;
  current: boolean;
};

const { localeLinks } = Astro.props as { localeLinks: LocaleLink[] };
const linksByCode = new Map(localeLinks.map((item) => [item.code, item]));
const chineseLinks = ['zh', 'zh-tw', 'zh-hk'].map(code => linksByCode.get(code)).filter((item): item is LocaleLink => Boolean(item));
const primaryLinks = ['ja', 'en'].map(code => linksByCode.get(code)).filter((item): item is LocaleLink => Boolean(item));
const chineseIsCurrent = chineseLinks.some(item => item.current);
const currentLocale = localeLinks.find(item => item.current)?.code || 'zh';
const chineseMenuLabel = currentLocale === 'ja' ? '中国語：簡体字と繁体字を選択' : currentLocale === 'en' ? 'Chinese: choose Simplified or Traditional' : '中文：展开简体与繁体选项';
---

<div class="site-nav__language-switcher" role="group" aria-label="Language / 语言 / 言語">
  {chineseLinks.length > 0 && (
    <div class="site-nav__language-family" data-language-family>
      <WorkspaceButton type="button" class="site-nav__language-trigger" data-language-menu-trigger
        data-current-language={chineseIsCurrent ? 'true' : undefined}
        aria-haspopup="menu" aria-expanded="false" aria-label={chineseMenuLabel} title={chineseMenuLabel}>
        <span>中</span><Icon name="chevron-down" class="site-nav__language-chevron" size={10} />
      </WorkspaceButton>
      <div class="site-nav__language-menu" role="menu" aria-label="中文" aria-hidden="true" data-language-menu>
        {chineseLinks.map(item => <a href={item.href} data-locale-href={item.href} hreflang={item.code} lang={item.code} role="menuitem" aria-current={item.current ? 'page' : undefined} class={item.current ? 'is-current' : undefined}>{item.dropdownLabel ?? item.shortLabel}</a>)}
      </div>
    </div>
  )}
  {primaryLinks.map(item => <a href={item.href} data-locale-href={item.href} hreflang={item.code} lang={item.code} aria-current={item.current ? 'page' : undefined} title={item.label}>{item.navShortLabel ?? item.shortLabel}</a>)}
</div>
<script>
  import '../scripts/languageSwitcher.js';
</script>
