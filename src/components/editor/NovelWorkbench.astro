---
import LoadingStatus from '../LoadingStatus.astro';
import WorkspaceButton from '../WorkspaceButton.astro';
import {editorAssetManifest} from '../../lib/editorAssets.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {editorApiBase,localEditor,editorEnabled} from '../../lib/editorConfig.mjs';
import {resolveLocaleCopy,getEditableLocale} from '../../lib/i18n.mjs';
import {adminURL} from '../../lib/adminOrigin.mjs';
const {locale='zh',articleMode=false}=Astro.props;
const copy=resolveLocaleCopy({en:{title:'Editing workbench',back:'Back to Wiki',login:'Sign in / Create account',loading:'Loading the editor…',history:'Submission history',restore:'Restore older drafts',close:'Close',recovery:'Restore a draft from this account or an unclaimed draft on this device. The original remains intact.'},ja:{title:'編集ワークスペース',back:'Wikiに戻る',login:'ログイン / 登録',loading:'エディターを読み込み中…',history:'提出履歴',restore:'旧形式の下書きを復元',close:'閉じる',recovery:'このアカウント、またはこの端末の未所属の下書きを復元します。原本は保持されます。'},zh:{title:'编辑工作台',back:'返回 Wiki',login:'登录 / 注册',loading:'正在载入编辑器…',history:'投稿记录',restore:'恢复旧版本地草稿',close:'关闭',recovery:'仅恢复当前账号或无账号标记的本机草稿。旧版本原件仍会保留。'}},locale);
const manifest=await editorAssetManifest();
const entry=manifest['src/main.tsx'];if(!entry)throw Error('Editor workbench must be built before the site.');
const config={locale,contentLocale:getEditableLocale(locale),apiBase:localEditor?(import.meta.env.PUBLIC_EDITOR_API_BASE||editorApiBase):editorApiBase,mode:articleMode?'article':'entry',transport:localEditor?'local':'production',loginHref:'/auth/sign-in?locale='+locale};
const adminReturnHref=adminURL('/content',{type:'articles'});
---
<BaseLayout reading lang={locale} title={copy.title} metadata={{title:copy.title,canonicalPath:`/${locale}/${articleMode?'articles/submit':'contribute/editor'}/`,noindex:true}}>
 <main class="novel-host ve-workbench" data-novel-workbench data-locale={locale} data-editor-enabled={String(editorEnabled)} data-editor-local={String(localEditor)} data-editor-api={config.apiBase} data-article-api={articleMode?config.apiBase:undefined}>
  <nav class="novel-host-nav" hidden><a data-editor-back href={`/${locale}/`}>{copy.back}</a><div class="novel-host-actions"><WorkspaceButton type="button" data-legacy-recovery hidden>{copy.restore}</WorkspaceButton><WorkspaceButton tone="quiet" href={`/${locale}/account/creator/`}>{copy.history}</WorkspaceButton><a data-editor-login href={config.loginHref}>{copy.login}</a></div></nav>
  <div id="root" role="region" aria-label={copy.title}><p role="status"><LoadingStatus label={copy.loading}/></p></div>
 <dialog data-legacy-dialog aria-labelledby="legacy-title"><h2 id="legacy-title">{copy.restore}</h2><p>{copy.recovery}</p><div data-legacy-list></div><WorkspaceButton type="button" data-legacy-close>{copy.close}</WorkspaceButton></dialog>
 </main>
 {entry.css?.map((file:string)=><link rel="stylesheet" href={'/_editor/'+file}/>)}
 <script is:inline define:vars={{config,adminReturnHref}}>
  config.initialTarget=new URLSearchParams(location.search).get('target')||undefined;
  config.admin=config.mode==='article'&&new URLSearchParams(location.search).get('admin')==='1';
  config.backHref=config.admin?adminReturnHref:`/${config.locale}/`;config.backLabel=config.admin?(config.locale==='en'?'Content management':config.locale==='ja'?'コンテンツ管理':'内容管理'):(config.locale==='en'?'Back to Wiki':config.locale==='ja'?'Wikiに戻る':'返回 Wiki');
  config.loginHref+='&returnTo='+encodeURIComponent(location.href);
  if(config.admin){document.querySelector('[data-editor-back]').href=adminReturnHref;document.querySelector('[data-editor-back]').textContent=config.locale==='en'?'Content management':config.locale==='ja'?'コンテンツ管理':'内容管理';}
  window.__WIKI_EDITOR_HOST__=config;
  document.querySelector('[data-editor-login]').href=config.loginHref;
 </script>
 <script is:inline type="module" src={'/_editor/'+entry.file}></script>
</BaseLayout>
<style is:global>
 .novel-host-nav{height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 20px;background:var(--theme-panel-solid);border-bottom:1px solid var(--ui-line);font:14px var(--font-sans)}
 .novel-host-actions{display:flex;align-items:center;gap:20px;min-width:0}.novel-host-nav button{min-height:44px}.novel-host-nav a{display:inline-flex;align-items:center;min-height:44px;color:var(--theme-fg)}
 .novel-host #root .wiki-workbench{height:100dvh}
 .novel-host-nav[hidden]{display:none}
 .novel-host[data-ready]>.novel-host-nav{display:none}
 .novel-host[data-ready] #root .wiki-workbench{height:100dvh}
 body:has(.novel-host) :is(.support-float,.community-float,.tools-dock,.ai-chat__launcher){display:none}
</style>

<style>@media(max-width:540px){.novel-host-actions{gap:12px}.novel-host-nav{padding:0 12px;font-size:12px}.novel-host-nav [data-editor-login]{max-width:116px;line-height:1.3}}</style>
