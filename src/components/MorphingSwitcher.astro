---
import Icon from './Icon.astro';
import SelectionGroup from './SelectionGroup.astro';
import slotLabels from '../data/morph-slots.json';
import {categoryLabel} from '../lib/entityNavigation.mjs';
import ResponsiveImage from './ResponsiveImage.astro';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
import type {ResolvedEntity} from '../lib/entityRegistry.mjs';
const labelsBySlot:Record<string,string[]>=slotLabels;
const {entries,current,locale}=Astro.props as {entries:ResolvedEntity[];current:string;locale:string};
const copy=resolveLocaleCopy({zh:{title:'当前观测形态',intro:'同一关联谱系，各自独立的档案。'},ja:{title:'観測形態',intro:'つながる存在、それぞれの記録。'},en:{title:'Observation form',intro:'Connected identities, individual records.'}},locale);
---
<section class="morph-switcher" aria-label={copy.title}>
 <div class="morph-context"><strong>{copy.title}</strong><span>{copy.intro}</span></div>
 <SelectionGroup as="nav" class="morph-rail" aria-label={copy.title} data-morph-rail  style={`--morph-columns:${Math.min(entries.length,4)}`}>{entries.map((entry,i)=><a href={entry.url} aria-current={entry.data.id===current?'page':undefined}><span class="morph-index">{String(i+1).padStart(2,'0')}</span>{entry.data.presentation?.image&&<ResponsiveImage src={entry.data.presentation.image} alt="" widths={[96]} sizes="36px"/>}<span class="morph-copy"><small>{entry.data.presentation?.morphing?.label||(labelsBySlot[entry.data.presentation?.morphing?.slot]?categoryLabel({labels:labelsBySlot[entry.data.presentation.morphing.slot]},locale):entry.data.presentation?.morphing?.slot||'')}</small><strong>{entry.data.name||entry.data.title}</strong></span><span class="morph-state" aria-hidden="true"><Icon name={entry.data.id===current?'circle':'arrow-right'} size={14}/></span></a>)}</SelectionGroup>
</section>
<style is:global>
.morph-switcher{margin-top:20px;padding:0 0 8px}.morph-context{display:flex;gap:16px;align-items:center;margin-bottom:12px;font-size:var(--ui-font-xs);color:var(--reader-muted)}.morph-context strong{font-weight:500;color:var(--reader-text)}.morph-context span{font-size:var(--ui-font-xs)}.morph-rail{position:relative;isolation:isolate;display:grid;grid-template-columns:repeat(var(--morph-columns,4),minmax(0,1fr));gap:4px;padding:5px;border:1px solid var(--reader-line);border-radius:var(--ui-radius-panel);background:rgb(var(--theme-fg-rgb)/.015)}.morph-rail a{position:relative;display:flex;align-items:center;gap:12px;padding:12px;min-width:0;text-decoration:none;color:var(--reader-muted);border:1px solid transparent;border-radius:var(--ui-radius-control);transition:background var(--motion-fast),border-color var(--motion-fast)}.morph-rail a[aria-current]{color:var(--reader-text);border-color:transparent;background:transparent}.morph-rail a:hover{background:rgb(var(--theme-fg-rgb)/.045)}.morph-index{font:var(--ui-font-xs) var(--font-mono);opacity:.5}.morph-rail img{width:36px;height:44px;object-fit:cover;object-position:top;border-radius:2px}.morph-copy{min-width:0}.morph-copy small{display:block;font-size:var(--ui-font-xs);margin-bottom:5px;color:var(--reader-muted)}.morph-copy strong{font:500 14px/1.6 var(--font-serif)}.morph-state{margin-left:auto;font-size:var(--ui-font-xs);opacity:.5}.morph-rail a[aria-current] .morph-state{color:var(--theme-accent-color);opacity:1}@media(max-width:760px){.morph-rail{grid-template-columns:repeat(2,minmax(0,1fr))}.morph-context span{display:none}.morph-rail a{gap:9px;padding:9px}.morph-copy strong{font-size:13px}}@media(prefers-reduced-motion:reduce){.morph-rail a{transition:none}}
</style>

<style is:global>
.morph-rail a{transition:color 240ms ease,transform 360ms cubic-bezier(.22,1,.36,1)}
.morph-rail a img{transition:transform 360ms cubic-bezier(.22,1,.36,1)}
.morph-rail a:hover{background:transparent;color:var(--reader-text)}
.morph-rail a:hover img{transform:scale(1.06)}
.morph-rail a:focus-visible{outline:2px solid var(--theme-accent-color);outline-offset:-2px}
.morph-rail:not([data-slider-ready]) a[aria-current=page]{background:color-mix(in srgb,var(--theme-accent-color) 7%,transparent)}
@media(prefers-reduced-motion:reduce){.morph-rail a,.morph-rail a img{transition:none}.morph-rail a:hover img{transform:none}}
</style>
