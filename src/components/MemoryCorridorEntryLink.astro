---
import ReaderDisclosure from './ReaderDisclosure.astro';
import ExperiencePortals from './ExperiencePortals.astro';

type Props = {
  locale: 'zh' | 'zh-tw' | 'zh-hk' | 'ja' | 'en';
  kind: 'artist' | 'song' | 'album' | 'project';
  entryId: string;
};

const { locale, kind, entryId } = Astro.props as Props;
const copy = {
  zh: {
    heading: '延伸探索',
    label: '写入记忆回廊',
    helper: '以当前词条生成一局 Wiki 联动跑酷',
  },
  'zh-tw': {
    heading: '延伸探索',
    label: '寫入記憶迴廊',
    helper: '以目前詞條生成一局 Wiki 聯動跑酷',
  },
  'zh-hk': {
    heading: '延伸探索',
    label: '寫入記憶迴廊',
    helper: '以目前詞條生成一局 Wiki 聯動跑酷',
  },
  ja: {
    heading: 'さらに探索',
    label: '記憶回廊に接続',
    helper: 'この記事をもとに Wiki 連動ランを開始',
  },
  en: {
    heading: 'Explore further',
    label: 'Enter Memory Corridor',
    helper: 'Start a Wiki-linked run from this entry',
  },
}[locale];

const query = new URLSearchParams({ sourceKind: kind, sourceId: entryId });
const href = `/${locale}/games/memory-corridor?${query.toString()}`;
---

<ReaderDisclosure title={copy.heading} count={3}>
  <ExperiencePortals locale={locale} embedded reader gameHref={href} gameHint={copy.helper} gameLabel={copy.label} />
</ReaderDisclosure>
