---
interface Props { title: string; count?: number; id?: string; }
const {title,count,id}=Astro.props;
---
<details class="reader-disclosure" id={id}>
 <summary><span class="reader-disclosure-title">{title}</span>{count!==undefined&&<span class="reader-disclosure-count">{String(count).padStart(2,'0')}</span>}<span class="reader-disclosure-toggle" aria-hidden="true"></span></summary>
 <div class="reader-disclosure-body"><slot/></div>
</details>
<style>
.reader-disclosure{border-top:1px solid var(--reader-line);margin:0;color:var(--reader-text,var(--theme-fg))}.reader-disclosure:last-child{border-bottom:1px solid var(--reader-line)}
summary{list-style:none;display:flex;align-items:center;gap:16px;padding:21px 0;cursor:pointer;user-select:none}summary::-webkit-details-marker{display:none}summary:focus-visible{outline:2px solid var(--theme-accent-color);outline-offset:5px}
.reader-disclosure-title{font:400 17px/1.7 var(--font-serif);letter-spacing:.06em}.reader-disclosure-count{font:var(--ui-font-xs) var(--font-mono);color:var(--reader-muted)}.reader-disclosure-toggle{margin-left:auto;position:relative;width:12px;height:12px;color:var(--reader-muted)}.reader-disclosure-toggle::before,.reader-disclosure-toggle::after{content:'';position:absolute;top:5px;left:0;width:12px;height:1px;background:currentColor;transition:transform .25s}.reader-disclosure-toggle::after{transform:rotate(90deg)}.reader-disclosure[open] > summary > .reader-disclosure-toggle::after{transform:rotate(0)}.reader-disclosure[open] > summary{color:var(--theme-accent-color)}.reader-disclosure-body{padding:0 0 26px;animation:reader-details-in .25s ease-out}@keyframes reader-details-in{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.reader-disclosure-body{animation:none}.reader-disclosure-toggle::before,.reader-disclosure-toggle::after{transition:none}}
</style>

<style>
summary{transition:color 180ms ease,background-color 180ms ease}
.reader-disclosure-title,.reader-disclosure-count{transition:translate 360ms cubic-bezier(.22,1,.36,1)}
.reader-disclosure[data-expanded='false'] > summary{color:var(--reader-text,var(--theme-fg))}
.reader-disclosure[data-expanded='false'] > summary > .reader-disclosure-toggle::after{transform:rotate(90deg)}
.reader-disclosure-body{animation:none}
@media(hover:hover) and (pointer:fine){summary:hover{color:var(--theme-accent-color);background:rgb(var(--theme-fg-rgb)/.025)}summary:hover :is(.reader-disclosure-title,.reader-disclosure-count){translate:4px 0}}
@media(prefers-reduced-motion:reduce){summary,.reader-disclosure-title,.reader-disclosure-count{transition:none}summary:hover :is(.reader-disclosure-title,.reader-disclosure-count){translate:none}}
</style>
