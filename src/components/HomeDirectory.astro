---
import ClassificationDirectory from './ClassificationDirectory.astro';
const {locale='zh',section}=Astro.props;
---
<section id="database" class="observatory-directory relative mx-auto max-w-7xl px-5 py-20 ui-crosshair bl br tl tr sm:px-6 sm:py-32">
<div id="artist-bg-container" class="artist-bg fixed-bg-hack pointer-events-none" aria-hidden="true"><div class="artist-bg__veil absolute inset-0 z-10 bg-[var(--theme-bg)] opacity-65 mix-blend-multiply"></div><img id="artist-bg-img" alt="" class="artist-bg__image saturate-125"/><img alt="" class="artist-bg__image saturate-125"/></div>
<ClassificationDirectory locale={locale} home>
 <header slot="heading" class="reveal-up">
  <h3 class="text-xs tracking-kamidest-lg font-light text-white mb-2">{section.heading}</h3>
  <p class="font-serif text-xs text-white/50 tracking-widest mb-12">{section.subheading}</p>
 </header>
</ClassificationDirectory>
</section>
<style>.observatory-directory{scroll-margin-top:90px}.artist-bg__veil{position:absolute;inset:0}</style>
