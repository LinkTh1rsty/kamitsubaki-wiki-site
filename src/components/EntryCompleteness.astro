---
import ContextAction from './ContextAction.astro';
interface MissingItem {
  field: string;
  weight: number;
  label?: string;
}

interface Props {
  score: number;
  tier: 'complete' | 'good' | 'brief' | 'stub';
  missing: MissingItem[];
  editHref?: string;
  editLabel?: string;
  labels: {
    kicker: string;
    scoreLabel: string;
    missingLabel: string;
    missingSummary: string;
    missingEmpty: string;
    editHint: string;
    tiers: {
      complete: string;
      good: string;
      brief: string;
      stub: string;
    };
  };
}

const { score, tier, missing, labels, editHref, editLabel } = Astro.props;

const tierClass = `entry-completeness__badge entry-completeness__badge--${tier}`;
const tierLabel = labels.tiers[tier] ?? labels.tiers.stub;
---

<section class="entry-completeness" data-entry-completeness data-score={score} data-tier={tier}>
  <div class="entry-completeness__summary">
    <p class="entry-completeness__kicker">{labels.kicker}</p>
    <div class="entry-completeness__score-line">
      <span class="entry-completeness__score">{score}</span>
      <span class={tierClass}>{tierLabel}</span>
    </div>
    <p class="entry-completeness__caption">{labels.scoreLabel}</p>
    <div class="entry-completeness__track" aria-hidden="true">
      <div class:list={['entry-completeness__fill', `entry-completeness__fill--${tier}`]} style={`width: ${score}%`}></div>
    </div>
  </div>

  {missing.length > 0 ? (
    <details class="entry-completeness__details">
      <summary>
        {labels.missingSummary} · {missing.length}
      </summary>
      <div class="entry-completeness__missing">
        <p class="entry-completeness__caption">{labels.missingLabel}</p>
        <ul>
          {missing.map((item) => (
            <li>
              <span>{item.label ?? item.field}</span>
              <span class="entry-completeness__weight">+{item.weight}</span>
            </li>
          ))}
        </ul>
      </div>
    </details>
  ) : (
    <div class="entry-completeness__empty">{labels.missingEmpty}</div>
  )}
  {missing.length > 0 && editHref && <ContextAction class="entry-completeness__action" layout="row" href={editHref}><strong>{editLabel}</strong><small>{labels.editHint}</small></ContextAction>}
</section>

<style>
  .entry-completeness { width:100%; margin-top:1.5rem; border:0; border-top:1px solid var(--reader-line); background:none; color:var(--reader-text,var(--theme-fg)); }
  .entry-completeness__summary { padding:18px 0; border-bottom:1px solid var(--reader-line); }
  .entry-completeness__kicker,.entry-completeness__caption { margin:0; color:var(--reader-muted); font:var(--ui-font-xs)/1.5 var(--font-mono); letter-spacing:.16em; }
  .entry-completeness__kicker { text-transform:uppercase; letter-spacing:.22em; }
  .entry-completeness__score-line { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-top:6px; }
  .entry-completeness__score { font:600 26px/1.25 var(--font-serif); letter-spacing:.06em; }
  .entry-completeness__track { height:5px; width:100%; overflow:hidden; margin-top:12px; border-radius:99px; background:rgb(var(--theme-fg-rgb)/.11); }
  .entry-completeness__details summary { min-height:44px; padding:12px 0; color:var(--reader-muted); font:12px/1.7 var(--font-sans); cursor:pointer; list-style:none; transition:color 180ms ease; }
  .entry-completeness__details summary:hover { color:var(--reader-text,var(--theme-fg)); background:rgb(var(--theme-fg-rgb)/.035); }
  .entry-completeness__missing { padding:12px 0 18px; border-top:1px solid var(--reader-line); }
  .entry-completeness__missing ul { list-style:none; display:grid; gap:8px; margin:10px 0 0; padding:0; }
  .entry-completeness__missing li { display:flex; align-items:baseline; justify-content:space-between; gap:12px; font-size:12px; }
  .entry-completeness__weight { flex:0 0 auto; color:var(--reader-muted); font:var(--ui-font-xs) var(--font-mono); }
  .entry-completeness__empty { padding:14px 0; color:var(--reader-muted); font-size:12px; }
  .entry-completeness :global(.entry-completeness__action) { border:0; border-top:1px solid var(--reader-line); padding:14px 0; }
  .entry-completeness :global(.entry-completeness__action .context-action__label) { display:grid; gap:3px; }
  .entry-completeness :global(.entry-completeness__action strong) { font-weight:600; }
  .entry-completeness :global(.entry-completeness__action small) { color:var(--reader-muted); font:var(--ui-font-xs)/1.55 var(--font-sans); }
  .entry-completeness__badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid transparent;
    padding: 0.15rem 0.55rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size:var(--ui-font-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.4;
    white-space: nowrap;
  }

  .entry-completeness__badge--complete {
    border-color: rgb(74 222 128 / 0.35);
    background: rgb(74 222 128 / 0.12);
    color: rgb(187 247 208 / 0.9);
  }

  .entry-completeness__badge--good {
    border-color: rgb(125 211 252 / 0.32);
    background: rgb(125 211 252 / 0.1);
    color: rgb(186 230 253 / 0.9);
  }

  .entry-completeness__badge--brief {
    border-color: rgb(253 224 71 / 0.3);
    background: rgb(253 224 71 / 0.1);
    color: rgb(254 249 195 / 0.88);
  }

  .entry-completeness__badge--stub {
    border-color: rgb(252 165 165 / 0.3);
    background: rgb(252 165 165 / 0.1);
    color: rgb(254 226 226 / 0.88);
  }

  .entry-completeness__fill {
    height: 100%;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--wiki-accent-color, #89f5df) 72%, white);
  }

  .entry-completeness__fill--complete {
    background: color-mix(in srgb, #4ade80 80%, var(--wiki-accent-color, #89f5df));
  }

  .entry-completeness__fill--good {
    background: color-mix(in srgb, #7dd3fc 80%, var(--wiki-accent-color, #89f5df));
  }

  .entry-completeness__fill--brief {
    background: color-mix(in srgb, #fde047 75%, var(--wiki-accent-color, #89f5df));
  }

  .entry-completeness__fill--stub {
    background: color-mix(in srgb, #f87171 70%, var(--wiki-accent-color, #89f5df));
  }

  .entry-completeness__details summary::-webkit-details-marker {
    display: none;
  }

  :global(html[data-theme='light']) .entry-completeness__badge--complete {
    border-color: rgb(22 163 74 / 0.35);
    background: rgb(22 163 74 / 0.1);
    color: rgb(21 128 61 / 0.95);
  }

  :global(html[data-theme='light']) .entry-completeness__badge--good {
    border-color: rgb(2 132 199 / 0.3);
    background: rgb(2 132 199 / 0.08);
    color: rgb(3 105 161 / 0.95);
  }

  :global(html[data-theme='light']) .entry-completeness__badge--brief {
    border-color: rgb(202 138 4 / 0.3);
    background: rgb(202 138 4 / 0.08);
    color: rgb(161 98 7 / 0.95);
  }

  :global(html[data-theme='light']) .entry-completeness__badge--stub {
    border-color: rgb(220 38 38 / 0.3);
    background: rgb(220 38 38 / 0.08);
    color: rgb(185 28 28 / 0.95);
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-completeness__fill {
      transition: none;
    }
  }
</style>
