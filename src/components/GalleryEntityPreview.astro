---
import Icon from './Icon.astro';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
const {entityId,locale}=Astro.props;
const api=import.meta.env.PUBLIC_GALLERY_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const copy=resolveLocaleCopy({zh:{title:'图集',all:'查看全部图片',source:'来源',classify:'完善分类',original:'查看原图'},ja:{title:'ギャラリー',all:'すべての画像',source:'出典',classify:'分類を提案',original:'原画像を見る'},en:{title:'Photo album',all:'View all photos',source:'Source',classify:'Suggest classification',original:'View original'}},locale);
---
<section class="entity-gallery-preview" data-entity-gallery data-entity={entityId} data-api={api} data-image-origin={import.meta.env.PUBLIC_GALLERY_IMAGE_ORIGIN||'https://images.kamitsubaki.wiki'} data-locale={locale} data-copy={JSON.stringify(copy)} hidden><div class="entity-gallery-preview__heading"><div><p>VISUAL ARCHIVE</p><h2>{copy.title}</h2></div><a data-gallery-all href={`/${locale}/gallery/?entity=${encodeURIComponent(entityId)}`}>{copy.all} <Icon name="arrow-right" /></a></div><div data-gallery-images></div></section>
<script>import {initEntityGalleryPreviews} from '../scripts/entityGalleryPreview.js';initEntityGalleryPreviews();</script>
<style>
.entity-gallery-preview{margin:26px 0 32px;padding:24px 0;border-top:1px solid var(--reader-line);border-bottom:1px solid var(--reader-line)}.entity-gallery-preview__heading{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:18px}.entity-gallery-preview__heading p{margin:0 0 6px;color:var(--reader-muted);font:var(--ui-font-xs) var(--font-mono);letter-spacing:.13em}.entity-gallery-preview__heading h2{margin:0;font:400 25px var(--font-serif)}.entity-gallery-preview__heading a{color:var(--theme-accent-color);font:12px var(--font-sans);text-underline-offset:4px}.entity-gallery-preview [data-gallery-images]{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:9px}.entity-gallery-preview button{min-width:0;padding:0;border:1px solid var(--reader-line);background:none;cursor:zoom-in}.entity-gallery-preview img{width:100%;aspect-ratio:1;object-fit:contain;background:rgb(var(--theme-fg-rgb)/.035)}.entity-gallery-preview button:hover,.entity-gallery-preview button:focus-visible{border-color:var(--theme-accent-color)}@media(max-width:750px){.entity-gallery-preview [data-gallery-images]{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:420px){.entity-gallery-preview__heading{align-items:start;flex-direction:column}}
</style>
