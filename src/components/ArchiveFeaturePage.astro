---
import WorkspaceLayout from '../layouts/WorkspaceLayout.astro';
import Icon from './Icon.astro';
import ArchiveCompletionTools from './ArchiveCompletionTools.astro';
import {getArchiveSnapshot,archiveManifest} from '../lib/archiveSnapshot.mjs';
import {selectArchive,archiveModules,unique} from '../lib/archiveResearch.mjs';
import {archiveFeature,archiveFeatureCopy,archiveFeatureDefinitions} from '../lib/archiveFeatureCopy.mjs';
import {entityLabel} from '../lib/entityLabels.mjs';
import '../styles/fanArchive.css';
const {locale='zh',module}=Astro.props;
if(!archiveModules.includes(module))throw new Error('Unknown archive module');
const feature=archiveFeature(locale,module),c=archiveFeatureCopy(locale),snapshot=await getArchiveSnapshot();
const manifest=archiveManifest(snapshot),initial=selectArchive(snapshot,{type:module==='music'||module==='radio'?'work-track':module==='physical'?'work-release':module==='live-mode'?'live-event':''},locale).slice(0,12);
const artists=snapshot.entities.filter(e=>['person','virtual-avatar','unit','software-voice'].includes(e.type));
const years=unique(snapshot.entities.map(e=>e.date?.slice(0,4))).sort().reverse();
const label=(entity:any)=>entity.narratives[locale]?.title || entity.narratives.zh?.title || entity.id;
const searchable=['music','radio','statistics','visual','museum','challenges','languages','physical','atlas','live-mode'];
---
<WorkspaceLayout locale={locale} title={feature.title} intro={feature.intro} path={'/explore/'+module+'/'} eyebrow={feature.roadmap+' / '+feature.system.toUpperCase()} backHref={'/'+locale+'/explore/'} backLabel={c.back} width="wide" mainAttributes={{class:'fan-archive-page'}}>
 <section class="fan-archive" data-archive-workspace data-module={module} data-locale={locale} data-map-tile-url={import.meta.env.PUBLIC_ARCHIVE_MAP_TILE_URL || undefined} data-map-attribution={import.meta.env.PUBLIC_ARCHIVE_MAP_ATTRIBUTION || undefined} data-snapshot-url={manifest.snapshotUrl}>
  <nav class="archive-links" aria-label={c.back}>{archiveFeatureDefinitions.filter(row=>row[1]===feature.system).map(row=><a href={'/'+locale+'/explore/'+row[0]+'/'} aria-current={row[0]===module?'page':undefined}>{archiveFeature(locale,row[0]).title}</a>)}</nav>
  <div class="archive-caption"><p>{c.coverage}</p><button type="button" data-archive-share><Icon name="share"/>{c.share}</button></div>
  {searchable.includes(module) && <form class="archive-filters" data-archive-filters>
   <label>{c.search}<input type="search" name="q" maxlength="300"/></label>
   {module!=='physical' && <label>{c.artist}<select name="artist"><option value="">{c.all}</option>{artists.map(e=><option value={e.id}>{label(e)}</option>)}</select></label>}
   {!['challenges','languages','physical'].includes(module) && <label>{c.year}<select name="year"><option value="">{c.all}</option>{years.map(year=><option value={year}>{year}</option>)}</select></label>}
   {['music','radio'].includes(module) && <><label>{c.creator}<input name="creator" list="archive-entity-ids" maxlength="150"/></label><label>{c.tag}<select name="tag"><option value="">{c.all}</option>{unique(snapshot.entities.flatMap(e=>[...(e.facts.genres || []),...(e.facts.tags || []),...(e.facts.genome?.tags || []).map((t:any)=>t.value)])).sort().map(tag=><option value={tag}>{tag}</option>)}</select></label><label>{c.type}<select name="type"><option value="work-track">{c.songs}</option><option value="work-release">{c.releases}</option></select></label></>}
   {module==='music' && <><label>{c.versionType}<select name="version"><option value="">{c.all}</option><option value="any">{c.anyVersion}</option>{['cover','remix','live','acoustic','instrumental','alternate'].map(value=><option value={value}>{c[value]}</option>)}</select></label><label>{c.role}<select name="role"><option value="">{c.all}</option>{unique(snapshot.entities.flatMap(entity=>(entity.facts.credits || []).map(credit=>credit.role))).map(role=><option value={role}>{entityLabel(role,locale)}</option>)}</select></label></>}
   {['visual','museum'].includes(module) && <><label>{c.lineage}<select name="lineage"><option value="">{c.all}</option>{unique(snapshot.entities.map(entity=>(entity.morphing as any)?.group)).sort().map(group=><option value={group}>{group}</option>)}</select></label><label>{c.visualEntity}<input name="visualEntity" list="archive-entity-ids" maxlength="150"/></label></>}
   {module==='museum' && <section class="archive-space"><h2>{c.exhibition}</h2><div data-published-exhibitions></div></section>}
  {module==='atlas' && <label>{c.world}<select name="world"><option value="">{c.all}</option><option value="real">{c.real}</option><option value="virtual">{c.virtual}</option><option value="unknown">{c.worldUnknown}</option></select></label>}
   {module==='challenges' && <label>{c.field}<select name="field"><option value="">{c.all}</option>{unique(snapshot.entities.flatMap(e=>e.completeness.missing.map((m:any)=>m.field))).map(field=><option value={field}>{field}</option>)}<option value="translation">{c.translation}</option></select></label>}
   {['languages','challenges'].includes(module) && <label>{c.languages}<select name="language">{['zh','ja','en'].map(language=><option value={language}>{language}</option>)}</select></label>}
   {module==='challenges' && <label>{c.taskStatus}<select name="taskStatus"><option value="">{c.all}</option>{['available','mine','claimed','submitted','approved'].map(status=><option value={status}>{c[status]}</option>)}</select></label>}
   <label>{c.sort}<select name="sort"><option value="newest">{c.newest}</option><option value="oldest">{c.oldest}</option><option value="title">{c.title}</option></select></label>
   <button type="submit">{c.apply}</button><button type="reset">{c.reset}</button>
  </form>}
  {module==='ask' && <><form data-question-form class="archive-question"><label>{c.question}<input name="question" type="search" maxlength="500" placeholder={locale==='en'?'KAF songs in 2024':locale==='ja'?'2024年の花譜の楽曲':'花谱 2024 年的歌曲'} required/></label><button type="submit">{c.parse}</button></form><p>{c.queryNote}</p><section data-query-plan hidden><h2>{c.parsed}</h2><p data-query-unresolved role="status"></p><form class="archive-filters" data-confirm-query>{['q','entity','artist','creator','year','from','to','role'].map(key=><label>{c[key as keyof typeof c] || key}<input name={key} maxlength="300" list={['artist','creator','entity'].includes(key)?'archive-entity-ids':undefined}/></label>)}<label>{c.type}<select name="type"><option value="">{c.all}</option>{unique(snapshot.entities.map(e=>e.type)).map(type=><option value={type}>{entityLabel(type,locale)}</option>)}</select></label><label><input type="checkbox" name="media" value="yes"/>{c.media}</label><button type="submit">{c.execute}</button></form></section></>}
  {module==='compare' && <><p>{c.compareNote}</p><form data-compare-form class="archive-filters"><label>{c.left}<input name="left" list="archive-entity-ids" maxlength="150" required/></label><label>{c.right}<input name="right" list="archive-entity-ids" maxlength="150" required/></label><button type="submit">{c.compare}</button></form><form data-year-compare-form class="archive-filters"><label>{c.from}<select name="leftYear">{years.map(year=><option value={year}>{year}</option>)}</select></label><label>{c.to}<select name="rightYear">{years.map(year=><option value={year}>{year}</option>)}</select></label><button type="submit">{c.compareYears}</button></form></>}
  {['evidence','languages'].includes(module) && <p>{module==='evidence'?c.evidenceNote:c.factsNote}</p>}
  {module==='evidence' && <form data-evidence-form class="archive-filters"><label>{c.search}<input name="entity" list="archive-entity-ids" maxlength="150" required/></label><button type="submit">{c.apply}</button><a href="/api/archive/v1/manifest.json">{c.openData}<Icon name="arrow-up-right"/></a></form>}
  {module==='music' && <section class="archive-space"><header><h2>{c.genome}</h2><p>{c.genomeNote}</p></header><form class="archive-filters" data-genome-form><label>{c.dimension}<select name="dimension"><option value="2">{c.twoD}</option><option value="3">{c.threeD}</option></select></label><label data-three-d-control hidden>{locale==='en'?'Rotation':locale==='ja'?'回転':'旋转'}<input name="azimuth" type="range" min="-180" max="180" value="35"/></label><label data-three-d-control hidden>{locale==='en'?'Elevation':locale==='ja'?'仰角':'仰角'}<input name="elevation" type="range" min="-90" max="90" value="25"/></label><button type="submit">{c.apply}</button></form><div data-genome></div></section>}
  {module==='atlas' && <><p>{c.routeNote}</p><div data-atlas-map class="archive-space"></div><section class="archive-space"><h2>{c.route}</h2><ol data-pilgrimage-route></ol><a data-route-directions hidden target="_blank" rel="noopener noreferrer">{c.navigate}<Icon name="arrow-up-right"/></a></section></>}
  {['visual','museum'].includes(module) && <><p>{module==='visual'?c.visualNote:c.museumNote}</p><label class="archive-year-scrub">{c.year}<input type="range" data-visual-year min={years.at(-1) || '2018'} max={years[0] || '2026'} value={years[0] || '2026'}/><output data-visual-year-label>{c.all}</output></label>{module==='museum' && <a href={'/'+locale+'/explore/collections/?kind=exhibition'}>{c.exhibition}<Icon name="arrow-up-right"/></a>}</>}
  {module==='radio' && <><p>{c.radioNote}</p><button type="button" data-create-station><Icon name="play"/>{c.station}</button></>}
  {module==='statistics' && <div data-statistics class="archive-space"></div>}
  {module==='observatory' && <><p>{c.privacyNote}</p><p>{c.localWarning}</p><div data-observatory></div><form data-passport-form class="archive-form"><label>{c.passportName}<input name="name" maxlength="120"/></label><label>{c.note}<textarea name="note" maxlength="1000"></textarea></label><label>{c.interests}<textarea name="interests" maxlength="5000"></textarea></label><label><input type="checkbox" name="published"/>{c.publishPassport}</label><button>{c.save}</button></form><button type="button" data-reload-observatory>{c.reloadAccount}</button><div class="archive-actions"><button type="button" data-export-observatory>{c.export}</button><label>{c.import}<input type="file" data-import-observatory accept="application/json"/></label></div><form data-witness-form class="archive-filters"><h2>{c.witness}</h2><label>{c.lives}<input name="entityId" list="archive-live-ids" required/></label><label>{c.date}<input name="date" type="date" required/></label><label>{c.note}<textarea name="note" maxlength="3000"></textarea></label><label>{c.ticket}<input name="ticketUrl" type="url" maxlength="1000"/></label><label>{c.privacy}<select name="visibility"><option value="private">{c.privacy}</option><option value="public">{c.public}</option></select></label><button>{c.save}</button></form></>}
  {module==='collections' && <><p>{c.collectionNote}</p><form data-collection-form class="archive-form"><input name="id" type="hidden"/><input name="revision" type="hidden" value="0"/><label>{c.collectionTitle}<input name="title" maxlength="120" required/></label><label>{c.collectionKind}<select name="kind"><option value="collection">{c.collection}</option><option value="exhibition">{c.exhibition}</option></select></label><label>{c.note}<textarea name="description" maxlength="3000"></textarea></label><label>{c.items}<textarea name="items" rows="6" maxlength="10000" required></textarea></label><label>{c.chapters}<textarea name="notes" rows="6" maxlength="10000"></textarea></label><div class="archive-actions"><button name="action" value="draft">{c.save} · {c.draft}</button><button name="action" value="publish">{c.publish}</button></div></form><h2>{c.community}</h2><div data-community-collections></div></>}
  {module==='challenges' && <><p>{c.challengeNote}</p><div data-monthly-challenge></div><label>{c.proof}<input data-task-proof type="url" maxlength="1000" placeholder="https://github.com/…/pull/…"/></label></>}
  {module==='rooms' && <><p>{c.roomNote}</p><form data-create-room class="archive-filters"><label>{c.roomName}<input name="title" maxlength="120" required/></label><button>{c.createRoom}</button></form><form data-join-room class="archive-filters"><label>{c.roomCode}<input name="id" maxlength="100" required/></label><button>{c.joinRoom}</button></form><section data-active-room hidden class="archive-space"><h2 data-room-title></h2><p data-room-participants></p><form data-room-position class="archive-filters"><label>{c.position}<input name="entityId" list="archive-entity-ids" required/></label><label>{c.type}<select name="kind"><option value="entity">{c.entityPosition}</option><option value="event">{c.timelinePosition}</option><option value="collection">{c.collectionPosition}</option></select></label><label>{c.section}<input name="section" maxlength="100"/></label><button>{c.save}</button></form><label><input type="checkbox" data-follow-host checked/>{c.followHost}</label><div data-room-current></div><button type="button" data-leave-room>{c.leaveRoom}</button><button type="button" data-end-room>{c.endRoom}</button></section></>}
  {module==='physical' && <><p>{c.physicalNote}</p><form data-barcode-form class="archive-filters"><label>{c.barcode}<input name="barcode" inputmode="numeric" maxlength="30" required/></label><button>{c.confirm}</button><button type="button" data-start-scan>{c.scan}</button><button type="button" data-stop-scan hidden>{c.stopScan}</button></form><video data-barcode-camera hidden muted playsinline aria-label={c.scan}></video><div data-barcode-results></div></>}
  {module==='today' && <><p>{c.todayNote}</p><form data-today-form class="archive-filters"><label>{c.monthDay}<input name="monthDay" type="text" pattern="[0-9]{2}-[0-9]{2}" placeholder="10-13" required/></label><button>{c.apply}</button></form><section class="archive-space"><h2>{c.mystery}</h2><div data-mystery-clues></div><form data-mystery-form class="archive-filters"><label>{c.guess}<input name="guess" maxlength="200" required/></label><button>{c.confirm}</button><button type="button" data-mystery-reveal>{c.reveal}</button></form><div data-mystery-answer aria-live="polite"></div></section></>}
  <p data-archive-status role="status" aria-live="polite">{c.loading}</p>
  <ArchiveCompletionTools module={module} copy={c} snapshot={snapshot}/>
  <div data-archive-results class="archive-result-list">{['music','radio','physical'].includes(module) && initial.map(row=><article class="archive-row"><div><small>{entityLabel(row.type,locale)} · {row.date || c.unknown}</small><h2><a href={row.path}>{row.title}</a></h2><p>{row.summary}</p></div></article>)}</div>
  <button type="button" data-archive-more hidden>{c.more}</button>
  <aside data-archive-detail class="archive-detail" hidden tabindex="-1"></aside>
  <details class="archive-data-note"><summary>{c.snapshot} / {c.openData}</summary><p><code>{snapshot.snapshot}</code></p><a href="/api/archive/v1/manifest.json">{c.openData}<Icon name="arrow-up-right"/></a><p>{manifest.license.text}</p><a href="/third-party-notices.txt">{c.openSource}</a></details>
  <datalist id="archive-entity-ids">{snapshot.entities.filter(e=>['person','virtual-avatar','unit','software-voice','work-track','work-release','live-event','project','lore-concept'].includes(e.type)).map(e=><option value={e.id}>{label(e)}</option>)}</datalist>
  <datalist id="archive-live-ids">{snapshot.entities.filter(e=>e.type==='live-event').map(e=><option value={e.id}>{label(e)}</option>)}</datalist>
  <script is:inline type="application/json" data-archive-copy set:html={JSON.stringify(c).replaceAll('<','\\u003c')}/>
  <noscript>{c.coverage} <a href="/api/archive/v1/manifest.json">{c.openData}</a></noscript>
 </section>
</WorkspaceLayout>
<script>import '../scripts/archiveWorkspace.js';</script>
