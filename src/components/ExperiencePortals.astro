---
import Icon from './Icon.astro';
import { centralAccountFrontendOrigin } from '../lib/centralAccountOrigins.mjs';
import ResponsiveImage from './ResponsiveImage.astro';
import { resolveLocaleCopy } from '../lib/i18n.mjs';

const { locale = 'zh', embedded = false, compact = false, reader = false, gameHref, gameHint, gameLabel } = Astro.props as {
  locale?: string;
  embedded?: boolean;
  compact?: boolean;
  reader?: boolean;
  gameHref?: string;
  gameHint?: string;
  gameLabel?: string;
};
const copy = resolveLocaleCopy({
  zh: { heading: '探索更多', labs: '游戏、对话与实验体验', gameTitle: '记忆回廊', game: '在像素世界里探索神椿', chatTitle: '角色对话', chat: '与 V.W.P 角色展开 AI 对话' },
  ja: { heading: 'もっと楽しむ', labs: 'ゲーム・対話・実験', gameTitle: '記憶回廊', game: 'ピクセルの世界で神椿を探索', chatTitle: 'キャラクター対話', chat: 'V.W.P キャラクターとの AI 対話' },
  en: { heading: 'Explore more', labs: 'Games, conversations and experiments', gameTitle: 'Memory Corridor', game: 'Explore Kamitsubaki in pixels', chatTitle: 'Character chat', chat: 'AI conversations with V.W.P characters' },
}, locale);
const pillars=resolveLocaleCopy({zh:['百科资料库','人物、音乐、企划与世界观','文章','史料、观点与艺术研究','全景时间轴','追溯事件与人物的交汇','图片档案','浏览人物、作品与设定图片'],ja:['データベース','人物・音楽・企画・世界観','記事','史料と芸術研究','年代記','出来事と人物の軌跡','画像アーカイブ','人物・作品・設定の画像を探す'],en:['Database','People, music, projects and worlds','Articles','Sources, perspectives and artistic research','Chronicle','Events and connected histories','Image archive','Browse people, works and design images']},locale);
const labs = { key: 'labs', title: 'LABs · Beta', description: copy.labs, href: `/${locale}/labs/`, image: null };
const game = { key: 'game', title: copy.gameTitle, description: gameHint ?? copy.game, href: gameHref ?? `/${locale}/games/memory-corridor`, image: '/games/memory-corridor/assets/creature-idle.png' };
const chatHref = import.meta.env.PUBLIC_WORKSPACE_ISOLATED === 'true'
  ? `${centralAccountFrontendOrigin(import.meta.env.PUBLIC_AI_OBSERVER_API_BASE, null, 'companion')}/`
  : 'https://chat.kamitsubaki.wiki/';
const chat = { key: 'chat', title: copy.chatTitle, description: copy.chat, href: chatHref, image: '/images/artists/vwp.jpg' };
const cards = reader ? [game, labs, chat] : [labs, game, chat];
---

<section id={embedded ? undefined : 'experiences'} class:list={['experience-portals', { 'experience-portals--embedded': embedded, 'experience-portals--compact': compact, 'experience-portals--reader': reader }]} aria-label={copy.heading}>
  {!reader && <h2>{copy.heading}</h2>}
  <div class="experience-portals__grid">
    {cards.map((card) => (
      <a class="experience-portal" href={card.href} title={compact ? card.description : card.key === 'game' ? gameLabel : undefined} data-memory-corridor-link={card.key === 'game' || undefined}>
        <span class="experience-portal__image" aria-hidden="true">
          {card.image ? <ResponsiveImage widths={[96, 192]} sizes="44px" src={card.image} alt="" loading="lazy" width="44" height="44" /> :
            <Icon name="network" />}
        </span>
        <span class="experience-portal__copy">
          <strong>{card.title}</strong>
          <small>{card.description}</small>
        </span>
        <span class="experience-portal__arrow" aria-hidden="true"><Icon name={card.key === 'chat' ? 'arrow-up-right' : 'arrow-right'} /></span>
      </a>
    ))}
  </div>
</section>

<style>
  .experience-portals { max-width: 80rem; margin: 0 auto; padding: 2rem 1.5rem 3rem; color: var(--theme-fg); scroll-margin-top: 7rem; }
  .experience-portals--embedded { max-width: none; padding: 0 0 1.5rem; }
  .experience-portals h2 { margin: 0 0 .75rem; color: rgb(var(--theme-fg-rgb) / .55); font: 500 .8rem/1.5 var(--font-sans); letter-spacing: .02em; }
  .experience-portals__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; }
  .experience-portal { display: flex; align-items: center; gap: .85rem; min-width: 0; min-height: 94px; padding: 1rem; border: 1px solid rgb(var(--theme-fg-rgb) / .12); border-radius: var(--ui-radius-control); background: rgb(var(--theme-fg-rgb) / .025); color: inherit; text-decoration: none; transition: background-color 160ms, border-color 160ms; }
  .experience-portal:hover { border-color: rgb(var(--theme-fg-rgb) / .28); background: rgb(var(--theme-fg-rgb) / .055); }
  .experience-portal__image { display: grid; place-items: center; flex: 0 0 44px; width: 44px; height: 44px; overflow: hidden; border-radius: 6px; background: rgb(var(--theme-fg-rgb) / .05); color: var(--theme-accent-color); }
  .experience-portal__image img { width: 100%; height: 100%; object-fit: cover; }
  .experience-portal[data-memory-corridor-link] img { image-rendering: pixelated; transform: scale(1.3); }
  .experience-portal__image svg { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 1.3; }
  .experience-portal__copy { display: block; min-width: 0; }
  .experience-portal__copy strong { display: block; font: 500 .95rem/1.5 var(--font-sans); }
  .experience-portal__copy small { display: block; margin-top: .2rem; color: rgb(var(--theme-fg-rgb) / .55); font: .75rem/1.65 var(--font-sans); overflow-wrap: anywhere; }
  .experience-portal__arrow { margin-left: auto; flex-shrink: 0; color: rgb(var(--theme-fg-rgb) / .4); font-size: .95rem; }
  @media (max-width: 640px) {
    .experience-portals { padding: 1.5rem 1rem 2rem; }
    .experience-portals--embedded { padding: 0 0 1.25rem; }
    .experience-portals__grid { grid-template-columns: 1fr; gap: .5rem; }
    .experience-portal { min-height: 72px; padding: .7rem .85rem; }
    .experience-portal__image { flex-basis: 36px; width: 36px; height: 36px; }
    .experience-portal__copy strong { font-size: .875rem; }
  }
  @media (prefers-reduced-motion: reduce) { .experience-portal { transition: none; } }
  .experience-portals.experience-portals--compact { margin:24px 0 0; padding:0; max-width:none; }
  .experience-portals--compact h2 { margin-bottom:10px; font-size:11px; color:rgb(var(--theme-fg-rgb)/.45); }
  .experience-portals--compact .experience-portals__grid { display:grid; grid-template-columns:1fr; gap:10px; }
  .experience-portals--compact .experience-portal { min-height:76px; gap:12px; padding:13px 14px; background:rgb(var(--theme-fg-rgb)/.018); border-color:rgb(var(--theme-fg-rgb)/.1); }
  .experience-portals--compact .experience-portal:hover { background:var(--ui-hover); border-color:rgb(var(--theme-fg-rgb)/.24); }
  .experience-portals--compact .experience-portal:focus-visible { outline:2px solid var(--theme-accent-color); outline-offset:3px; }
  .experience-portals--compact .experience-portal__image { flex-basis:36px; width:36px; height:36px; border-radius:4px; }
  .experience-portals--compact .experience-portal__image svg { width:19px; height:19px; }
  .experience-portals--compact .experience-portal__copy strong { font-size:14px; white-space:normal; }
  .experience-portals--compact .experience-portal__arrow { font-size:11px; }
  .experience-portals--reader { max-width:none; margin:0; padding:0; color:var(--reader-text,var(--theme-fg)); }
  .experience-portals--reader .experience-portals__grid { display:grid; grid-template-columns:1fr; gap:0; }
  .experience-portals--reader .experience-portal { min-height:68px; gap:12px; padding:10px 6px; border:0; border-bottom:1px solid var(--reader-line); border-radius:0; background:transparent; transition:background-color 180ms ease,color 180ms ease; }
  .experience-portals--reader .experience-portal:hover { background:rgb(var(--theme-fg-rgb)/.035); color:var(--reader-text,var(--theme-fg)); }
  .experience-portals--reader .experience-portal:focus-visible { outline:2px solid var(--theme-accent-color); outline-offset:-2px; }
  .experience-portals--reader .experience-portal__image { flex-basis:42px; width:42px; height:42px; border-radius:4px; background:rgb(var(--theme-fg-rgb)/.05); color:var(--reader-muted); }
  .experience-portals--reader .experience-portal__image img { filter:saturate(.7); transition:filter 180ms ease; }
  .experience-portals--reader .experience-portal:hover .experience-portal__image img { filter:saturate(1); }
  .experience-portals--reader .experience-portal__image svg { width:21px; height:21px; }
  .experience-portals--reader .experience-portal__copy strong { font:400 15px/1.5 var(--font-serif); letter-spacing:.03em; }
  .experience-portals--reader .experience-portal__copy small { margin-top:1px; color:var(--reader-muted); font:11px/1.6 var(--font-sans); }
  .experience-portals--reader .experience-portal__arrow { color:var(--reader-muted); font-size:12px; transition:transform 180ms ease; }
  .experience-portals--reader .experience-portal:hover .experience-portal__arrow { transform:translateX(3px); }
  @media(max-width:640px) { .experience-portals--reader { padding:0; } .experience-portals--reader .experience-portal { min-height:68px; padding:10px 4px; } }
  @media(prefers-reduced-motion:reduce) { .experience-portals--reader .experience-portal__image img,.experience-portals--reader .experience-portal__arrow { transition:none; } .experience-portals--reader .experience-portal:hover .experience-portal__arrow { transform:none; } }
</style>
