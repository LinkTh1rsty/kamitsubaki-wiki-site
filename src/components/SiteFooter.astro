---
import { defaultLocale, getLocalizedSiteName } from '../lib/i18n.mjs';

type FooterLink = {
  label: string;
  href: string;
};

type FooterContent = {
  tagline: string;
  links: FooterLink[];
  disclaimer: string[];
  license: {
    notice: string;
    mediaNotice: string;
    detailsLabel: string;
    detailsHref: string;
    deedLabel: string;
    deedHref: string;
  };
  copyright: string;
};

const { footer } = Astro.props as { footer: FooterContent };
const footerLogoAlt = getLocalizedSiteName(Astro.params.locale);
const locale = Astro.params.locale ?? defaultLocale;
const supportHref = `/${locale}/support/`;
const docsHref = `/${locale}/docs/`;
const docsLabel = 'DOCUMENTS';
const footerLinks = [
  ...footer.links.filter((link) => ![supportHref,docsHref].map(value=>value.replace(/\/$/,'')).includes(link.href.replace(/\/$/,''))),
  { label: docsLabel, href: docsHref },
  { label: 'SUPPORT', href: supportHref },
];
---

<footer class="site-footer relative mt-14 overflow-hidden border-t border-[rgb(var(--theme-fg-rgb)/0.1)] py-14 text-center ui-crosshair tl tr sm:mt-20 sm:py-20">
  <div class="mx-auto flex max-w-4xl flex-col items-center px-4 sm:px-6">
    <p class="mb-8 font-serif text-sm tracking-[0.34em] text-[rgb(var(--theme-fg-rgb)/0.82)] sm:mb-12 sm:tracking-[0.5em] md:text-base">
      {footer.tagline}
    </p>

    <div class="site-footer__nav mb-10 flex flex-wrap justify-center gap-x-7 gap-y-4 text-[11px] font-light tracking-kamidest text-[rgb(var(--theme-fg-rgb)/0.56)] sm:mb-14 sm:gap-12">
      {footerLinks.map((link) => (
        <a href={link.href} class="relative transition-colors hover:text-[var(--theme-fg)] after:absolute after:-bottom-1 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-[var(--theme-fg)] after:transition-transform hover:after:scale-x-100">
          {link.label}
        </a>
      ))}
    </div>

    <div class="mb-8 h-10 w-px bg-[rgb(var(--theme-fg-rgb)/0.14)] sm:mb-12 sm:h-12"></div>

    <p class="site-footer__disclaimer mb-6 max-w-lg text-[11px] font-light uppercase leading-loose tracking-widest text-[rgb(var(--theme-fg-rgb)/0.48)]">
      {footer.disclaimer.map((line) => (
        <>
          {line}<br />
        </>
      ))}
    </p>
    <div class="site-footer__license mb-6 max-w-2xl text-xs font-light leading-6 text-[rgb(var(--theme-fg-rgb)/0.56)]">
      <p>{footer.license.notice}</p>
      <p class="mt-1 text-[rgb(var(--theme-fg-rgb)/0.46)]">{footer.license.mediaNotice}</p>
      <p class="mt-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-mono text-[11px] uppercase tracking-[0.14em]">
        <a href={footer.license.detailsHref} class="transition-colors hover:text-[var(--theme-fg)]">
          {footer.license.detailsLabel}
        </a>
        <span aria-hidden="true" class="text-[rgb(var(--theme-fg-rgb)/0.22)]">/</span>
        <a rel="license" href={footer.license.deedHref} class="transition-colors hover:text-[var(--theme-fg)]">
          {footer.license.deedLabel}
        </a>
      </p>
    </div>
    <p class="site-footer__copyright font-mono text-[10px] tracking-widest text-[rgb(var(--theme-fg-rgb)/0.4)]">
      {footer.copyright}
    </p>

    <div class="mt-12 w-full sm:mt-16">
      <img
        src="/brand/kamitsubakiwiki-long-dark.svg"
        alt={footerLogoAlt}
        width="1577"
        height="400"
        loading="lazy"
        decoding="async"
        class="footer-brand-logo footer-brand-logo--dark mx-auto h-auto w-full max-w-3xl opacity-25"
      />
      <img
        src="/brand/kamitsubakiwiki-long-light.svg"
        alt=""
        aria-hidden="true"
        width="1577"
        height="400"
        loading="lazy"
        decoding="async"
        class="footer-brand-logo footer-brand-logo--light mx-auto h-auto w-full max-w-3xl opacity-25"
      />
    </div>
  </div>

</footer>
