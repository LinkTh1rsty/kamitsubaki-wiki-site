---
interface Props { prefix:string; character?:string; title?:string; live?:boolean; locale?:string }
import {uploadGuidanceCopy,uploadSourceLabels} from '../lib/uploadGuidanceCopy.mjs';
import {contributionLayoutCopy} from '../lib/contributionLayoutCopy.mjs';
import {creationWorkbenchCopy} from '../lib/creationWorkbenchCopy.mjs';
const {prefix,character='',title='',live=false,locale='zh'}=Astro.props;
const c=creationWorkbenchCopy(locale),labels=c.fields,layout=contributionLayoutCopy(locale),guidance=uploadGuidanceCopy(locale),sources=uploadSourceLabels(locale);
const groups=[{title:layout.basic,keys:['character','title','form']},{title:layout.source,keys:['author','sourceTitle','sourceUrl','rightsBasis','rightsEvidence']},{title:layout.optional,keys:['date','publisher','tags']}];
const fields=[['character',labels.character,character],['title',labels.title,title],['form',labels.form,''],['date',labels.date,''],['tags',labels.tags,''],['publisher',labels.publisher,''],['sourceTitle',labels.sourceTitle,''],['sourceUrl',labels.sourceUrl,''],['author',labels.author,''],['rightsBasis',labels.basis,''],['rightsEvidence',labels.evidence,'']];
---
<div class="creation-fields">
 {groups.map((group,index)=>{const Group=index===2?'details':'fieldset';const Label=index===2?'summary':'legend';return <Group class:list={["submission-field-group",index===2&&"submission-optional"]}><Label>{group.title}</Label>{index===1&&<p class="submission-hint">{layout.requiredHint}</p>}<div class="submission-field-grid">
 {group.keys.map(key=>fields.find(([name])=>name===key)!).map(([name,label,value])=><label class:list={[(["character","title","sourceUrl","rightsEvidence"].includes(name))&&"submission-field-wide"]} for={`${prefix}-${name}`}><span>{label}</span>{live&&name==='character'?<><input data-character-filter aria-label={labels.roleSearch} type="search" placeholder={labels.roleSearchHint}/><select id={`${prefix}-${name}`} name="character" aria-label={labels.character}><option value="">{labels.roleChoose}</option></select></>:name==='rightsBasis'?<select id={`${prefix}-${name}`} name={name}><option value="">{guidance.basisPlaceholder}</option><option value="official">{c.official}</option><option value="original">{c.original}</option><option value="authorized">{c.authorized}</option></select>:<><input id={`${prefix}-${name}`} name={name} value={value} type={name==='sourceUrl'?'url':'text'} list={live&&name==='form'?`${prefix}-forms`:live&&name==='sourceTitle'?`${prefix}-sources`:undefined} placeholder={name==='date'?'YYYY / YYYY-MM / YYYY-MM-DD':name==='tags'?labels.tagsHint:name==='form'?labels.formHint:name==='author'?guidance.authorPlaceholder:name==='sourceTitle'?guidance.sourcePlaceholder:name==='sourceUrl'?guidance.urlPlaceholder:undefined}/>{live&&name==='form'&&<datalist id={`${prefix}-forms`} data-form-options/>}{live&&name==='sourceTitle'&&<datalist id={`${prefix}-sources`}>{sources.map(source=><option value={source.label} data-source-id={source.id}/>)}</datalist>}</>}</label>)}
 {index===2&&<label class="creation-fields__wide submission-field-wide" for={`${prefix}-notes`}><span>{labels.notes}</span><textarea id={`${prefix}-notes`} name="notes" rows="2" placeholder={labels.notesHint}></textarea></label>}
 </div></Group>})}
 {live&&<p class="creation-fields__wide creation-destination" data-set-destination>{c.destinationEmpty}</p>}
</div>
