---
import WorkspaceControl from './WorkspaceControl.astro';
import SubmissionField from './SubmissionField.astro';
interface Props { prefix:string; character?:string; title?:string; live?:boolean; locale?:string }
import {uploadGuidanceCopy,uploadSourceLabels} from '../lib/uploadGuidanceCopy.mjs';
import {contributionLayoutCopy} from '../lib/contributionLayoutCopy.mjs';
import {creationWorkbenchCopy} from '../lib/creationWorkbenchCopy.mjs';
const {prefix,character='',title='',live=false,locale='zh'}=Astro.props;
const c=creationWorkbenchCopy(locale),labels=c.fields,layout=contributionLayoutCopy(locale),guidance=uploadGuidanceCopy(locale),sources=uploadSourceLabels(locale);
const groups=[{title:layout.basic,keys:['character','title','form']},{title:layout.source,keys:['author','sourceTitle','sourceUrl','rightsBasis','rightsEvidence']},{title:layout.optional,keys:['date','publisher','tags']}];
const fields=[['character',labels.character,character],['title',labels.title,title],['form',labels.form,''],['date',labels.date,''],['tags',labels.tags,''],['publisher',labels.publisher,''],['sourceTitle',labels.sourceTitle,''],['sourceUrl',labels.sourceUrl,''],['author',labels.author,''],['rightsBasis',labels.basis,''],['rightsEvidence',labels.evidence,'']];
---
<div class="creation-fields">
 {groups.map((group,index)=>{const Group=index===2?'details':'fieldset';const Label=index===2?'summary':'legend';return <Group class:list={["submission-field-group",index===2&&"submission-optional"]}><Label>{group.title}</Label>{index===1&&<p class="submission-hint">{layout.requiredHint}</p>}<div class="submission-field-grid">
 {group.keys.map(key=>fields.find(([name])=>name===key)!).map(([name,label,value])=><SubmissionField class={["character","title","sourceUrl","rightsEvidence"].includes(name)?"submission-field-wide":undefined} id={`${prefix}-${name}`} label={label} required={["character","title","author","sourceTitle","rightsBasis"].includes(name)}>{live&&name==='character'?<><WorkspaceControl data-character-filter aria-label={labels.roleSearch} type="search" placeholder={labels.roleSearchHint}/><WorkspaceControl as="select" id={`${prefix}-${name}`} name="character" aria-label={labels.character}><option value="">{labels.roleChoose}</option></WorkspaceControl></>:name==='rightsBasis'?<WorkspaceControl as="select" id={`${prefix}-${name}`} name={name}><option value="">{guidance.basisPlaceholder}</option><option value="official">{c.official}</option><option value="original">{c.original}</option><option value="authorized">{c.authorized}</option></WorkspaceControl>:<><WorkspaceControl id={`${prefix}-${name}`} name={name} value={value} type={name==='sourceUrl'?'url':'text'} list={live&&name==='form'?`${prefix}-forms`:live&&name==='sourceTitle'?`${prefix}-sources`:undefined} placeholder={name==='date'?'YYYY / YYYY-MM / YYYY-MM-DD':name==='tags'?labels.tagsHint:name==='form'?labels.formHint:name==='author'?guidance.authorPlaceholder:name==='sourceTitle'?guidance.sourcePlaceholder:name==='sourceUrl'?guidance.urlPlaceholder:undefined}/>{live&&name==='form'&&<datalist id={`${prefix}-forms`} data-form-options/>}{live&&name==='sourceTitle'&&<datalist id={`${prefix}-sources`}>{sources.map(source=><option value={source.label} data-source-id={source.id}/>)}</datalist>}</>}</SubmissionField>)}
 {index===2&&<SubmissionField class="creation-fields__wide submission-field-wide" id={`${prefix}-notes`} label={labels.notes}><WorkspaceControl as="textarea" id={`${prefix}-notes`} name="notes" rows={2} placeholder={labels.notesHint}></WorkspaceControl></SubmissionField>}
 </div></Group>})}
 {live&&<p class="creation-fields__wide creation-destination" data-set-destination>{c.destinationEmpty}</p>}
</div>
