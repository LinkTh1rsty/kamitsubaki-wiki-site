---
import Icon from './Icon.astro';
import type {Source} from '../lib/entityRegistry.mjs';
const {sources,locale='zh'}=Astro.props as {sources:Source[];locale:string};
const reference=locale==='en'?'Reference':locale==='ja'?'参考資料':'参考资料';
const sourceHost=(url?:string)=>{try{return new URL(url!).hostname.replace(/^www\./,'');}catch{return '';}};
const sourceTitle=(source:Source)=>{const title=source.title?.trim();if(title&&!/^https?:\/\//i.test(title))return title;if(source.publisher)return source.publisher;try{const url=new URL(source.url!);const host=sourceHost(source.url);const account=url.pathname.split('/').filter(Boolean)[0];if(['youtube.com','youtu.be'].includes(host))return `YouTube${account?.startsWith('@')?' · '+account:''}`;if(['twitter.com','x.com'].includes(host))return `X / Twitter${account?' · @'+account:''}`;return host||reference;}catch{return reference;}};
---
<ol class="reader-sources">
 {sources.map((source,index)=><li><span class="source-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div>{source.url?<a href={source.url} target="_blank" rel="noopener noreferrer" title={source.url}><span>{sourceTitle(source)}</span><span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>:<span class="source-title">{sourceTitle(source)}</span>}<p>{[source.publisher!==sourceTitle(source)?source.publisher:'',sourceHost(source.url)!==sourceTitle(source)?sourceHost(source.url):'',source.page,source.publishedAt].filter((value,index,all)=>value&&all.indexOf(value)===index).join(' · ')}</p></div></li>)}
</ol>
<style>
.reader-sources{list-style:none;padding:0 12px 0 0;margin:0;max-height:28rem;overflow-y:auto;scrollbar-width:thin;scrollbar-color:var(--reader-line) transparent;overscroll-behavior:contain}.reader-sources li{display:grid;grid-template-columns:22px minmax(0,1fr);gap:16px;padding:16px 0;border-bottom:1px solid var(--reader-line)}.reader-sources li:last-child{border-bottom:0}.source-number{font:var(--ui-font-xs)/2 var(--font-mono);color:var(--reader-muted);padding-top:3px}.reader-sources a{display:flex;align-items:baseline;justify-content:space-between;gap:16px;color:inherit;text-decoration:none;font:13px/1.9 var(--font-sans);overflow-wrap:anywhere}.source-title{font:13px/1.9 var(--font-sans)}.reader-sources a:hover{color:var(--theme-accent-color)}.reader-sources a:focus-visible{outline:2px solid var(--theme-accent-color);outline-offset:4px}.reader-sources a>span:last-child{flex-shrink:0;color:var(--reader-muted);font-size:var(--ui-font-xs)}.reader-sources p{margin:5px 0 0;font:var(--ui-font-xs)/1.8 var(--font-sans);color:var(--reader-muted);overflow-wrap:anywhere}
</style>
<style>
.reader-sources a,.reader-sources a>span:last-child{transition:color 180ms ease,translate 360ms cubic-bezier(.22,1,.36,1)}
@media(hover:hover) and (pointer:fine){.reader-sources a:hover{translate:3px 0}.reader-sources a:hover>span:last-child{translate:2px -2px;color:var(--theme-accent-color)}}
@media(prefers-reduced-motion:reduce){.reader-sources a,.reader-sources a>span:last-child{transition:none;translate:none}}
</style>
