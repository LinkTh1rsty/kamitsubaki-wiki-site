---
import Icon from './Icon.astro';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
import {VISUAL_EXPLORER_BASE,visualRoamImages} from '../lib/visualExplorer.mjs';
const {locale='zh'}=Astro.props;
const explorerBase=import.meta.env.DEV?VISUAL_EXPLORER_BASE:`https://kamitsubaki.wiki${VISUAL_EXPLORER_BASE}`;
const entranceImages=visualRoamImages.map(src=>src.replace(VISUAL_EXPLORER_BASE,explorerBase));
const copy=resolveLocaleCopy({
 zh:{title:'影像漫游',description:'换一种方式，看见神椿。',action:'开始漫游'},
 ja:{title:'ビジュアル散歩',description:'もうひとつの視点から、神椿へ。',action:'散歩をはじめる'},
 en:{title:'Visual roam',description:'Another way to see KAMITSUBAKI.',action:'Start exploring'},
},locale);
---
<a id="visual-roam" class="visual-roam" href={explorerBase} data-visual-roam data-astro-reload aria-labelledby={`visual-roam-title-${locale}`}>
 <div class="visual-roam__art" aria-hidden="true">
  {Array.from({length:6},(_,column)=><div class="visual-roam__strip" style={`--roam-duration:${54+column*7}s;--roam-offset:${column%2?-70:-14}px`}>
   <div class="visual-roam__track">{[0,1].map(()=> <div class="visual-roam__group">{[0,1].map(row=><img src={entranceImages[column*2+row]} alt="" width="480" height="600" loading="lazy" decoding="async" draggable="false"/>)}</div>)}</div>
  </div>)}
 </div>
 <div class="visual-roam__copy"><h2 id={`visual-roam-title-${locale}`}>{copy.title}</h2><p>{copy.description}</p><span class="visual-roam__action">{copy.action}<Icon name="arrow-up-right"/></span></div>
</a>
<script>
 import {initVisualRoamPortals} from '../scripts/visualRoamPortal.js';
 initVisualRoamPortals();
 document.addEventListener('astro:page-load',()=>{
  initVisualRoamPortals();
  if(location.hash==='#visual-roam')document.querySelector('#visual-roam')?.scrollIntoView({block:'start'});
 });
</script>
<style>
.visual-roam{position:relative;isolation:isolate;display:flex;align-items:center;min-height:340px;margin-top:24px;overflow:hidden;border:1px solid #252728;border-radius:4px;background:#101214;color:#f6f5f1;text-decoration:none;contain:layout paint;scroll-margin-top:120px}
.visual-roam__art{position:absolute;z-index:-2;inset:-20px -4% -30px 23%;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:7px;transform:rotate(-5deg) scale(1.04);transform-origin:center;opacity:.86;pointer-events:none}
.visual-roam::after{content:'';position:absolute;z-index:-1;inset:0;background:linear-gradient(90deg,#101214 0%,rgb(16 18 20/.97) 19%,rgb(16 18 20/.82) 30%,rgb(16 18 20/.32) 49%,rgb(16 18 20/.06) 82%);pointer-events:none}
.visual-roam__strip{min-width:0;transform:translateY(var(--roam-offset))}
.visual-roam__track{animation:roam-stream var(--roam-duration) linear infinite;animation-play-state:paused}
.visual-roam__strip:nth-child(even) .visual-roam__track{animation-direction:reverse}
.visual-roam[data-visible] .visual-roam__track{animation-play-state:running}
.visual-roam__group{display:grid;gap:7px;padding-bottom:7px}
.visual-roam__group img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;border-radius:3px;background:#202226}
.visual-roam__group img:nth-child(2){aspect-ratio:1/1}
.visual-roam__copy{position:relative;padding:42px 48px;max-width:60%}
.visual-roam h2{margin:0;font:400 clamp(36px,4.3vw,60px)/1.3 var(--font-serif);letter-spacing:.015em;color:inherit;text-wrap:balance}
.visual-roam p{margin:14px 0 26px;font:18px/1.8 var(--font-serif);color:#dededb}
.visual-roam__action{display:inline-flex;align-items:center;justify-content:center;gap:20px;min-height:48px;padding:10px 22px;border:1px solid rgb(255 255 255/.7);border-radius:3px;font:14px/1.5 var(--font-sans);transition:background 180ms,border-color 180ms,transform 180ms}
.visual-roam__action :global(svg){width:18px;height:18px;transition:transform 180ms}
.visual-roam:hover .visual-roam__action{background:rgb(255 255 255/.13);border-color:white}
.visual-roam:hover .visual-roam__action :global(svg){transform:translate(2px,-2px)}
.visual-roam:focus-visible{outline:3px solid var(--theme-accent-color);outline-offset:5px}
@keyframes roam-stream{to{transform:translateY(-50%)}}
@media(max-width:850px){.visual-roam__copy{padding:36px;max-width:74%}.visual-roam h2{font-size:38px}.visual-roam__art{left:15%}}
@media(max-width:600px){.visual-roam{min-height:480px;align-items:flex-start;margin-top:20px}.visual-roam__copy{padding:28px 26px;max-width:100%;width:100%}.visual-roam h2{font-size:40px}.visual-roam p{font-size:16px;margin:10px 0 20px}.visual-roam__action{min-height:46px;padding:10px 20px}.visual-roam__art{inset:165px -25% -80px -8%;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;transform:rotate(-6deg)}.visual-roam__strip:nth-child(n+5){display:none}.visual-roam::after{background:linear-gradient(180deg,#101214 0%,rgb(16 18 20/.98) 20%,rgb(16 18 20/.84) 35%,rgb(16 18 20/.12) 59%,rgb(16 18 20/.08) 100%)}}
@media(prefers-reduced-motion:reduce){.visual-roam__track{animation:none!important}.visual-roam__action,.visual-roam__action :global(svg){transition:none}.visual-roam:hover .visual-roam__action :global(svg){transform:none}}
</style>
