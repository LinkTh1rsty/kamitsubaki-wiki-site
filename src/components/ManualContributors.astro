---
import WorkspaceButton from './WorkspaceButton.astro';
import WorkspaceControl from './WorkspaceControl.astro';
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import manualContributorData from '../data/manualContributors.json';
import { resolveLocaleCopy } from '../lib/i18n.mjs';
import { convertTraditionalChinese } from '../lib/traditionalChinese.mjs';

type ContributorLocale = 'zh' | 'ja' | 'en';
type LocalizedContributorText = string | Partial<Record<ContributorLocale, string>>;

interface ManualContributor {
  pinned?: boolean;
  id: string;
  collaboration: LocalizedContributorText;
  name: string;
  avatar?: string;
  contacts: Array<{ label: string; href?: string }>;
  introduction: LocalizedContributorText;
  quote: LocalizedContributorText;
  enabled?: boolean;
}

interface Props {
  locale?: ContributorLocale | string;
}

const { locale = 'zh' } = Astro.props as Props;
const activeLocale: ContributorLocale = locale === 'ja' || locale === 'en' ? locale : 'zh';
const contributors = (manualContributorData as ManualContributor[])
  .filter((contributor) => contributor.enabled !== false)
  .sort((a, b) => Number(b.pinned === true) - Number(a.pinned === true));

const copy = resolveLocaleCopy({
  zh: {
    title: '特别协力者',
    subtitle: '感谢每一位以自己的方式支持观测站的朋友。点开名片，认识他们。',
    contact: '联系方式',
    quote: '寄语',
    open: '查看资料',
    close: '收起资料',
    showAll: '查看全部协力者',
    search: '搜索姓名或协力类型',
    previous: '上一页', next: '下一页',
    result: '{count} 位协力者 · {page} / {pages}',
    noResults: '没有找到匹配的协力者，试试其他关键词。',
    showLess: '收起名单',
    empty: '特别协力者名单将在整理后公布。',
    offline: '暂时无法更新，已保留现有名单。', retry: '重试',
  },
  ja: {
    title: 'スペシャルサポーター',
    subtitle: 'さまざまな形でこの観測拠点を支えてくださった皆さまに感謝します。アイコンを選ぶとプロフィールが開きます。',
    contact: '連絡先',
    quote: 'ひとこと',
    open: 'プロフィールを見る',
    close: 'プロフィールを閉じる',
    showAll: 'すべてのサポーター',
    search: '名前・協力内容で検索',
    previous: '前へ', next: '次へ',
    result: '{count} 人 · {page} / {pages}',
    noResults: '該当するサポーターが見つかりません。',
    showLess: '折りたたむ',
    empty: 'サポーター一覧は準備中です。',
    offline: '更新できません。現在の一覧を表示しています。', retry: '再試行',
  },
  en: {
    title: 'Special collaborators',
    subtitle: 'With thanks to everyone who supports this observatory in their own way. Select a portrait to meet them.',
    contact: 'Contact',
    quote: 'In their words',
    open: 'View profile',
    close: 'Close profile',
    showAll: 'View all collaborators',
    search: 'Search names or contributions',
    previous: 'Previous', next: 'Next',
    result: '{count} collaborators · {page} / {pages}',
    noResults: 'No matching collaborators. Try another search.',
    showLess: 'Show less',
    empty: 'The collaborators list will be published when ready.',
    offline: 'Unable to update. The existing list is still available.', retry: 'Retry',
  },
}, locale);

function localized(value: LocalizedContributorText) {
  const localizedValue = typeof value === 'string'
    ? value
    : value[activeLocale] || value.zh || value.ja || value.en || '';
  return convertTraditionalChinese(localizedValue, locale, { ui: true });
}

function safeContactHref(value?: string) {
  if (!value) return '';
  if (value.startsWith('mailto:')) return value;

  try {
    const url = new URL(value);
    return url.protocol === 'https:' || url.protocol === 'http:' ? value : '';
  } catch {
    return '';
  }
}

function safeAvatarSrc(value?: string) {
  if (!value) return '';
  if (value.startsWith('/') && !value.startsWith('//')) return value;

  try {
    const url = new URL(value);
    return url.protocol === 'https:' || url.protocol === 'http:' ? value : '';
  } catch {
    return '';
  }
}

function initials(name: string) {
  return Array.from(name.trim()).slice(0, 2).join('').toUpperCase() || '?';
}
---

<section
  class="manual-contributors"
  aria-labelledby="manual-contributors-title"
  data-manual-contributors
  data-locale={locale}
  data-collaborators-api={import.meta.env.PUBLIC_COLLABORATORS_API_BASE || import.meta.env.PUBLIC_SUPPORT_API_BASE || import.meta.env.PUBLIC_AI_OBSERVER_API_BASE || 'https://api.kamitsubaki.wiki'}
  id="collaborators"
  data-list-expanded="false"
  data-detail-open="false"
  data-has-overflow="false"
>
  <script is:inline type="application/json" data-collaborators-copy set:html={JSON.stringify(copy).replaceAll('<', '\\u003c')} />
  <div class="manual-contributors__status" data-collaborators-status hidden role="status"><span>{copy.offline}</span><WorkspaceButton class="context-action" type="button" data-collaborators-retry>{copy.retry}</WorkspaceButton></div>
  <header class="manual-contributors__header">
    <div>
      <h3 id="manual-contributors-title">{copy.title}</h3>
      <p>{copy.subtitle}</p>
    </div>
    <span aria-label={`${contributors.length} ${copy.title}`}>{String(contributors.length).padStart(2, '0')}</span>
  </header>

  {contributors.length > 0 ? (
    <>
      <div class="manual-contributors__directory-tools" data-directory-tools hidden>
        <label><span>{copy.search}</span><WorkspaceControl type="search" aria-label={copy.search} placeholder={copy.search} data-directory-search /></label>
        <p role="status" data-directory-result data-template={copy.result}></p>
      </div>
      <div class="manual-contributors__grid-wrap">
        <div class="manual-contributors__grid" data-contributor-grid>
          {contributors.map((contributor) => {
            const avatarSrc = safeAvatarSrc(contributor.avatar);
            const detailId = `manual-contributor-${contributor.id}`;

            return (
              <WorkspaceButton
                class="manual-contributors__card"
                type="button"
                aria-expanded="false"
                aria-controls={detailId}
                aria-label={`${copy.open}：${contributor.name}`}
                data-contributor-card={contributor.id}
                data-pinned={String(contributor.pinned === true)}
                data-search={`${contributor.name} ${localized(contributor.collaboration)}`}
              >
                <span class="manual-contributors__avatar">
                  {avatarSrc ? (
                    <ResponsiveImage widths={[96, 192]} sizes="64px" src={avatarSrc} alt="" loading="lazy" referrerpolicy="no-referrer" />
                  ) : (
                    <span>{initials(contributor.name)}</span>
                  )}
                </span>
                <span class="manual-contributors__card-copy">
                  <strong>{contributor.name}</strong>
                  <small>{localized(contributor.collaboration)}</small>
                </span>
                <span class="manual-contributors__card-mark" aria-hidden="true"><Icon name="plus" /></span>
              </WorkspaceButton>
            );
          })}
        </div>
      </div>

      <p class="manual-contributors__no-results" data-directory-empty hidden>{copy.noResults}</p>
      <div class="manual-contributors__pagination" data-directory-pagination hidden>
        <WorkspaceButton type="button" data-directory-previous>{copy.previous}</WorkspaceButton>
        <WorkspaceButton type="button" data-directory-next>{copy.next}</WorkspaceButton>
      </div>
      <WorkspaceButton
        class="manual-contributors__toggle"
        type="button"
        aria-expanded="false"
        data-contributor-list-toggle
        data-show-all={copy.showAll}
        data-show-less={copy.showLess}
      >
        <span>{copy.showAll}</span><i aria-hidden="true"><Icon name="chevron-down" /></i>
      </WorkspaceButton>

      <div class="manual-contributors__drawer" data-contributor-drawer inert hidden>
        <div class="manual-contributors__drawer-clip">
          <div class="manual-contributors__drawer-surface">
            <WorkspaceButton class="manual-contributors__drawer-close" type="button" aria-label={copy.close} data-contributor-close><Icon name="x" /></WorkspaceButton>
            {contributors.map((contributor) => {
              const avatarSrc = safeAvatarSrc(contributor.avatar);
              const contacts = Array.isArray(contributor.contacts) ? contributor.contacts : [];

              return (
                <article id={`manual-contributor-${contributor.id}`} class="manual-contributors__detail" hidden data-contributor-detail={contributor.id}>
                  <div class="manual-contributors__identity">
                    <span class="manual-contributors__detail-avatar">
                      {avatarSrc ? (
                        <ResponsiveImage widths={[96, 192]} sizes="64px" src={avatarSrc} alt="" loading="lazy" referrerpolicy="no-referrer" />
                      ) : (
                        <span>{initials(contributor.name)}</span>
                      )}
                    </span>
                    <div>
                      <p>{localized(contributor.collaboration)}</p>
                      <h4>{contributor.name}</h4>
                    </div>
                  </div>

                  <div class="manual-contributors__bio">
                    <p>{localized(contributor.introduction)}</p>
                    {contacts.length > 0 && (
                      <div class="manual-contributors__contacts">
                        <span>{copy.contact}</span>
                        <div>
                          {contacts.map((contact) => {
                            const contactHref = safeContactHref(contact.href);
                            return contactHref ? (
                              <a href={contactHref} target={contactHref.startsWith('mailto:') ? undefined : '_blank'} rel={contactHref.startsWith('mailto:') ? undefined : 'noopener noreferrer'}>
                                {contact.label}<span aria-hidden="true"><Icon name="arrow-up-right" /></span>
                              </a>
                            ) : (
                              <strong>{contact.label}</strong>
                            );
                          })}
                        </div>
                      </div>
                    )}
                  </div>

                  <blockquote>
                    <span>{copy.quote}</span>
                    <p>“{localized(contributor.quote)}”</p>
                  </blockquote>
                </article>
              );
            })}
          </div>
        </div>
      </div>
    </>
  ) : (
    <p class="manual-contributors__empty">{copy.empty}</p>
  )}
</section>

<script>
  import {createDisclosureMotion} from '../lib/disclosureMotion.mjs';
  import { orderSupporters } from '../lib/supporterOrder.mjs';
  import { loadCollaborators } from '../scripts/collaborators.js';
  import { directoryPage } from '../lib/collaboratorDirectory.mjs';
  function initializeManualContributors() {
    document.querySelectorAll<HTMLElement>('[data-manual-contributors]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const grid = root.querySelector<HTMLElement>('[data-contributor-grid]');
      const listToggle = root.querySelector<HTMLButtonElement>('[data-contributor-list-toggle]');
      const closeButton = root.querySelector<HTMLButtonElement>('[data-contributor-close]');
      const cards = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-contributor-card]'));
      const details = Array.from(root.querySelectorAll<HTMLElement>('[data-contributor-detail]'));
      const drawer = root.querySelector<HTMLElement>('[data-contributor-drawer]');
      const search = root.querySelector<HTMLInputElement>('[data-directory-search]');
      const tools = root.querySelector<HTMLElement>('[data-directory-tools]');
      const result = root.querySelector<HTMLElement>('[data-directory-result]');
      const empty = root.querySelector<HTMLElement>('[data-directory-empty]');
      const pagination = root.querySelector<HTMLElement>('[data-directory-pagination]');
      const previous = root.querySelector<HTMLButtonElement>('[data-directory-previous]');
      const next = root.querySelector<HTMLButtonElement>('[data-directory-next]');
      const drawerMotion=drawer?createDisclosureMotion(drawer):null;
      let detailIntent=0;
      let page = 0;
      let selectedId = '';
      let activeCard: HTMLButtonElement | undefined;

      const shuffledCards = orderSupporters(cards.map(card => ({ card, pinned: card.dataset.pinned === 'true' }))).map(item => item.card);
      shuffledCards.forEach((card) => grid?.append(card));

      const closeDetail = (restoreFocus = true) => {
        detailIntent++;
        root.dataset.detailOpen = 'false';
        cards.forEach(card=>card.setAttribute('aria-expanded','false'));
        selectedId='';
        if(drawer){drawer.inert=true;void drawerMotion?.setOpen(false,{immediate:!restoreFocus});}
        if(restoreFocus)activeCard?.focus({preventScroll:true});
      };

      const positionDetail = () => {
        if (!drawer || !grid || !activeCard || !selectedId) return;
        const visible = shuffledCards.filter(card => !card.hidden);
        const columns = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
        const index = visible.indexOf(activeCard);
        const end = Math.min(visible.length - 1, Math.floor(index / columns) * columns + columns - 1);
        if(visible[end] && visible[end].nextElementSibling!==drawer)visible[end].after(drawer);
      };

      const updateDirectory = () => {
        const expanded = root.dataset.listExpanded === 'true';
        const output = directoryPage(shuffledCards.map(card => ({ card, search: card.dataset.search })), { expanded, query: search?.value || '', page });
        page = output.page;
        const visible = new Set(output.items.map(item => item.card));
        root.dataset.hasOverflow = String(cards.length > 6);
        shuffledCards.forEach(card => { card.hidden = !visible.has(card); });
        if (tools) tools.hidden = !expanded;
        if (empty) empty.hidden = output.total > 0;
        if (pagination) pagination.hidden = !expanded || output.pages < 2;
        if (previous) previous.disabled = page === 0;
        if (next) next.disabled = page + 1 >= output.pages;
        if (result) result.textContent = (result.dataset.template || '').replace('{count}', String(output.total)).replace('{page}', String(page + 1)).replace('{pages}', String(output.pages));
        const label = listToggle?.querySelector('span');
        if (label) label.textContent = expanded ? listToggle?.dataset.showLess || '' : `${listToggle?.dataset.showAll || ''} · ${cards.length}`;
      };

      cards.forEach((card) => {
        card.addEventListener('click', async () => {
          const id = card.dataset.contributorCard || '';
          if (selectedId === id && root.dataset.detailOpen === 'true') {
            closeDetail();
            return;
          }

          const intent=++detailIntent;
          const switching=Boolean(selectedId && activeCard!==card);
          // Close before moving between rows; do not teleport an expanded panel.
          if(switching&&drawer){drawer.inert=true;await drawerMotion?.setOpen(false);if(intent!==detailIntent)return;}
          details.forEach(detail=>detail.hidden=detail.dataset.contributorDetail!==id);
          cards.forEach(item=>item.setAttribute('aria-expanded',String(item===card)));
          selectedId=id;activeCard=card;
          positionDetail();
          if(drawer)drawer.inert=false;
          root.dataset.detailOpen='true';
          await drawerMotion?.setOpen(true);

        });
      });

      closeButton?.addEventListener('click', () => closeDetail());
      root.addEventListener('keydown', (event) => { if (event.key === 'Escape' && selectedId) { event.preventDefault(); closeDetail(); } });

      listToggle?.addEventListener('click', () => {
        const expanded = root.dataset.listExpanded !== 'true';
        closeDetail(false);
        root.dataset.listExpanded = String(expanded);
        listToggle.setAttribute('aria-expanded', String(expanded));
        page = 0;
        if (search) search.value = '';
        updateDirectory();
        if (expanded) search?.focus({ preventScroll: true });
      });
      search?.addEventListener('input', () => { closeDetail(false); page = 0; updateDirectory(); });
      previous?.addEventListener('click', () => { closeDetail(false); page -= 1; updateDirectory(); });
      next?.addEventListener('click', () => { closeDetail(false); page += 1; updateDirectory(); });
      const resizeObserver = new ResizeObserver(positionDetail);
      if (grid) resizeObserver.observe(grid);
      root.addEventListener('collaborators:dispose', () => {resizeObserver.disconnect();drawerMotion?.dispose();}, { once: true });
      document.addEventListener('astro:before-swap', () => {resizeObserver.disconnect();drawerMotion?.dispose();}, { once: true });
      updateDirectory();
      loadCollaborators(root, initializeManualContributors);

    });
  }

  initializeManualContributors();
  document.addEventListener('astro:page-load', initializeManualContributors);
</script>

<style>
  .manual-contributors__status { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px 16px;margin:0 0 18px;padding:10px 0;border-block:1px solid var(--ui-line);color:rgb(var(--theme-fg-rgb)/.72);font:12px/1.7 var(--font-sans); }
  .manual-contributors__status[hidden] { display:none; }
  .manual-contributors {
    margin: 0 0 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--ui-line);
    scroll-margin-top: 110px;
  }
  .manual-contributors__header { display:flex; align-items:start; justify-content:space-between; gap:24px; margin-bottom:24px; }
  .manual-contributors__header h3 { margin:0; font:400 clamp(22px,2.4vw,28px)/1.4 var(--font-serif); color:var(--theme-fg); }
  .manual-contributors__header p { max-width:42rem; margin:8px 0 0; font:13px/1.8 var(--font-sans); color:rgb(var(--theme-fg-rgb)/.56); }
  .manual-contributors__header > span { display:grid; place-items:center; min-width:36px; height:30px; border:1px solid var(--ui-line); border-radius:8px; font:var(--ui-font-xs) var(--font-mono); color:rgb(var(--theme-fg-rgb)/.5); }
  .manual-contributors__directory-tools { display:flex; align-items:end; justify-content:space-between; flex-wrap:wrap; gap:12px; margin:0 0 16px; }
  .manual-contributors__directory-tools label { flex:1; max-width:360px; min-width:200px; }
  .manual-contributors__directory-tools label > span { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
  .manual-contributors__directory-tools input { width:100%; min-height:42px; padding:10px 12px; border:1px solid var(--ui-line); border-radius:8px; background:rgb(var(--theme-fg-rgb)/.025); color:var(--theme-fg); font:13px var(--font-sans); }
  .manual-contributors__directory-tools input:focus-visible { outline:2px solid var(--theme-accent-color); outline-offset:2px; }
  .manual-contributors__directory-tools p { margin:0 0 9px; color:rgb(var(--theme-fg-rgb)/.5); font:var(--ui-font-xs) var(--font-sans); }
  .manual-contributors__pagination { display:flex; justify-content:end; gap:8px; margin:16px 0 0; }
  .manual-contributors__pagination button { min-height:40px; padding:8px 14px; border:1px solid var(--ui-line); border-radius:8px; background:transparent; color:var(--theme-fg); font:12px var(--font-sans); cursor:pointer; }
  .manual-contributors__pagination button:disabled { opacity:.35; cursor:default; }
  .manual-contributors__no-results { padding:24px 0; color:rgb(var(--theme-fg-rgb)/.6); font:13px/1.7 var(--font-sans); }
  .manual-contributors__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
  .manual-contributors__card {--workspace-control-height:98px;--workspace-control-padding:18px;--workspace-control-background:rgb(var(--theme-fg-rgb)/.022);
    position:relative; display:grid; grid-template-columns:56px minmax(0,1fr) 20px; align-items:center; gap:14px;
    min-width:0; border:1px solid var(--ui-line); border-radius:12px; text-align:left; cursor:pointer;
    transition:background 200ms ease,border-color 200ms ease,transform 240ms var(--ui-ease);
  }
  .manual-contributors__card[hidden] { display:none; }
  .manual-contributors__card:hover { background:rgb(var(--theme-fg-rgb)/.045); transform:translateY(-2px); }
  .manual-contributors__card[aria-expanded='true'] { background:rgb(var(--theme-accent-rgb)/.07); border-color:rgb(var(--theme-accent-rgb)/.42); }
  .manual-contributors__card:focus-visible, .manual-contributors__drawer-close:focus-visible, .manual-contributors__toggle:focus-visible { outline:2px solid var(--theme-accent-color); outline-offset:3px; }
  .manual-contributors__avatar, .manual-contributors__detail-avatar { display:grid; place-items:center; aspect-ratio: 1 / 1; overflow:hidden; border-radius:10px; border:1px solid rgb(var(--theme-fg-rgb)/.1); background:rgb(var(--theme-fg-rgb)/.04); }
  .manual-contributors__avatar { width:56px; height:56px; }
  .manual-contributors__avatar img, .manual-contributors__detail-avatar img { display:block; width:100%; height:100%; object-fit: cover; }
  .manual-contributors__avatar > span, .manual-contributors__detail-avatar > span { font:14px var(--font-mono); }
  .manual-contributors__card-copy { display:grid; gap:7px; min-width:0; }
  .manual-contributors__card-copy strong { font:500 15px/1.45 var(--font-sans); overflow-wrap:anywhere; }
  .manual-contributors__card-copy small { font:var(--ui-font-xs)/1.4 var(--font-sans); color:rgb(var(--theme-fg-rgb)/.5); }
  .manual-contributors__card-mark { align-self:start; padding-top:2px; font:16px/1 var(--font-sans); color:rgb(var(--theme-fg-rgb)/.36); transition:transform 240ms ease,color 200ms ease; }
  .manual-contributors__card[aria-expanded='true'] .manual-contributors__card-mark { transform:rotate(45deg); color:var(--theme-accent-color); }
  .manual-contributors__toggle { display:none; align-items:center; gap:8px; margin:16px auto 0; border:1px solid var(--ui-line); border-radius:8px; cursor:pointer; }
  .manual-contributors[data-has-overflow='true'] .manual-contributors__toggle { display:flex; }
  .manual-contributors__toggle i { font-style:normal; transition:transform 240ms ease; }
  .manual-contributors[data-list-expanded='true'] .manual-contributors__toggle i { transform:rotate(180deg); }
  .manual-contributors [hidden] { display:none !important; }
  .manual-contributors__drawer { grid-column:1/-1; display:block;overflow:hidden;opacity:1;overflow-anchor:none; }

  .manual-contributors__drawer-clip { min-height:0; overflow:hidden; }
  .manual-contributors__drawer-surface { position:relative; margin-top:0; padding:28px; border:1px solid rgb(var(--theme-accent-rgb)/.24); border-radius:12px; background:rgb(var(--theme-fg-rgb)/.025); }
  .manual-contributors__drawer-close { position:absolute; top:12px; right:12px; width:36px; height:36px; border:1px solid var(--ui-line); border-radius:8px; cursor:pointer; }
  .manual-contributors__drawer-close:hover { background:var(--ui-hover); color:var(--theme-fg); }
  .manual-contributors__detail { display:grid; grid-template-columns:minmax(220px,.8fr) minmax(0,1.2fr); gap:24px 40px; padding-right:24px; align-items:start; }
  .manual-contributors__detail[hidden] { display:none; }
  .manual-contributors__identity { display:grid; grid-template-columns:64px minmax(0,1fr); gap:16px; align-items:center; }
  .manual-contributors__detail-avatar { width:64px; height:64px; }
  .manual-contributors__identity p { margin:0 0 6px; font:var(--ui-font-xs)/1.5 var(--font-sans); color:var(--theme-accent-color); }
  .manual-contributors__identity h4 { margin:0; font:400 21px/1.5 var(--font-serif); overflow-wrap:anywhere; }
  .manual-contributors__bio > p { margin:0; font:14px/1.9 var(--font-sans); color:rgb(var(--theme-fg-rgb)/.72); overflow-wrap:anywhere; }
  .manual-contributors__contacts { display:flex; flex-wrap:wrap; align-items:center; gap:8px 14px; margin-top:16px; font:var(--ui-font-xs)/1.6 var(--font-sans); }
  .manual-contributors__contacts > span { color:rgb(var(--theme-fg-rgb)/.4); }
  .manual-contributors__contacts > div { display:flex; flex-wrap:wrap; gap:8px; }
  .manual-contributors__contacts a, .manual-contributors__contacts strong { display:inline-flex; gap:10px; padding:6px 10px; border:1px solid var(--ui-line); border-radius:8px; color:rgb(var(--theme-fg-rgb)/.7); font-weight:400; text-decoration:none; overflow-wrap:anywhere; }
