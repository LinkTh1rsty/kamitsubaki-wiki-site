---
import Icon from './Icon.astro';
import {navigationCategories,categoryLabel} from '../lib/entityNavigation.mjs';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
const {locale='zh'}=Astro.props;
const copy=resolveLocaleCopy({zh:{database:'百科资料库',articles:'文章',chronicle:'时间轴',about:'关于',people:'人物与艺人',music:'音乐资料',world:'企划与世界观',all:'进入百科总索引',gallery:'图片档案'},ja:{database:'データベース',articles:'記事',chronicle:'年代記',about:'このサイト',people:'人物・アーティスト',music:'音楽資料',world:'企画・世界観',all:'データベース一覧',gallery:'画像アーカイブ'},en:{database:'Database',articles:'Articles',chronicle:'Chronicle',about:'About',people:'People & artists',music:'Music & performance',world:'Projects & worlds',all:'Explore the database',gallery:'Image archive'}},locale);
const groups=[{label:copy.people,ids:['solo','groups','creators','staff']},{label:copy.music,ids:['isotopes','songs','releases','lives']},{label:copy.world,ids:['projects','organizations','lore']}];
---
<div class="archive-primary-nav"><details class="archive-mega" data-archive-menu><summary>{copy.database}<span aria-hidden="true"><Icon name="chevron-down" /></span></summary><div class="archive-mega-panel"><div class="archive-mega-heading"><small>OBJECTIVE DATABASE</small><a href={`/${locale}/database/`}>{copy.all} <Icon name="arrow-up-right" /></a></div><div class="archive-mega-columns">{groups.map(group=><section><h3>{group.label}</h3>{group.ids.map(id=>{const category=navigationCategories.find(c=>c.id===id)!;return <a href={`/${locale}/database/${category.path}/`}>{categoryLabel(category,locale)}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>})}</section>)}</div></div></details><a href={`/${locale}/labs/explore/`}>LABs</a><a href={`/${locale}/#about`}>{copy.about}</a></div>
<style>.archive-primary-nav{display:flex;align-items:center;gap:25px;color:inherit;font-size:var(--ui-font-xs);letter-spacing:.08em}.archive-primary-nav>a,.archive-mega summary{color:inherit;opacity:.7;text-decoration:none;cursor:pointer;white-space:nowrap}.archive-mega summary{list-style:none;display:flex;gap:8px;align-items:center}.archive-mega summary::-webkit-details-marker{display:none}.archive-mega[open] summary,.archive-primary-nav>a:hover{opacity:1}.archive-mega-panel{position:absolute;left:50%;top:calc(100% + 14px);transform:translateX(-50%);width:min(900px,calc(100vw - 60px));background:var(--theme-bg,#111);color:var(--theme-fg,#eee);border:1px solid #8884;padding:28px 32px;box-shadow:0 20px 60px #0005;letter-spacing:normal}.archive-mega-heading{display:flex;justify-content:space-between;border-bottom:1px solid #8883;padding-bottom:20px}.archive-mega-heading small{font:var(--ui-font-xs) var(--font-mono);letter-spacing:.2em;opacity:.4}.archive-mega-heading a{color:inherit;font-size:var(--ui-font-xs);text-decoration:none;opacity:.7}.archive-mega-columns{display:grid;grid-template-columns:repeat(3,1fr);gap:38px;padding:26px 0}.archive-mega-columns h3{font:15px var(--font-serif);margin:0 0 15px;letter-spacing:.1em}.archive-mega-columns a{display:flex;justify-content:space-between;gap:12px;color:inherit;text-decoration:none;padding:11px 0;font-size:var(--ui-font-xs);opacity:.55}.archive-mega-columns a:hover{opacity:1}.archive-mega-columns a span{opacity:.4}.archive-mega-gallery{display:flex;justify-content:space-between;border-top:1px solid #8883;padding-top:20px;color:inherit;text-decoration:none;font-size:var(--ui-font-xs)}.archive-mega-gallery small{font:var(--ui-font-xs) var(--font-mono);letter-spacing:.15em;opacity:.4}@media(max-width:1180px){.archive-primary-nav{display:none}}
</style>
<script>document.querySelectorAll<HTMLDetailsElement>('[data-archive-menu]').forEach(menu=>{document.addEventListener('click',e=>{if(!menu.contains(e.target as Node))menu.open=false;});menu.addEventListener('keydown',e=>{if(e.key==='Escape'){menu.open=false;menu.querySelector('summary')?.focus();}});});</script>
