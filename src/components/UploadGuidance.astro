---
import Icon from './Icon.astro';
import {uploadGuidanceCopy} from '../lib/uploadGuidanceCopy.mjs';
const {locale='zh'}=Astro.props;
const g=uploadGuidanceCopy(locale);
---
<nav class="upload-guidance" aria-label={g.title}>
  <a class="upload-guidance__link" href={`/${locale}/docs/contribute/gallery/`}>{g.manual} <Icon name="arrow-right" /></a>
  <a class="upload-guidance__link" href={`/${locale}/docs/contribute/rights/`}>{g.rightsManual} <Icon name="arrow-right" /></a>
</nav>
<style>
.upload-guidance { display: flex; flex-wrap: wrap; gap: 0 var(--ui-space-6); margin-block: 0 var(--ui-space-4); }
.upload-guidance__link { display: inline-flex; align-items: center; gap: var(--ui-space-2); min-height: var(--ui-hit-target); font-size: var(--ui-font-sm); text-underline-offset: .25em; }
</style>
