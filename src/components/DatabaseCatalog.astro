---
import WorkspaceButton from './WorkspaceButton.astro';
import WorkspaceControl from './WorkspaceControl.astro';
import Icon from './Icon.astro';
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from './SiteNav.astro';
import SiteFooter from './SiteFooter.astro';
import WorkspaceShell from './WorkspaceShell.astro';
import WorkspaceHeader from './WorkspaceHeader.astro';
import ContextAction from './ContextAction.astro';
import ClassificationDirectory from './ClassificationDirectory.astro';
import DatabaseRecord from './DatabaseRecord.astro';
import {getLocalizedSite} from '../lib/homeData.mjs';
import {buildLocaleLinks} from '../lib/i18n.mjs';
import {getEntityRegistry} from '../lib/entityRegistry.mjs';
import {entityLabel} from '../lib/entityLabels.mjs';
import {imageAttributes} from '../lib/imageAssets.mjs';
import {DATABASE_ARTWORK_FALLBACKS} from '../lib/databaseArtwork.mjs';
import {toDatabaseRecord,collectDatabaseFacets,databaseCollectionCounts} from '../lib/databaseBrowse.mjs';
import {databaseBrowseCopy} from '../lib/databaseBrowseCopy.mjs';
import {foldCjkSearchText} from '../lib/cjkSearch.mjs';
import '../styles/databaseBrowse.css';
import '../styles/uiKit.css';

const {locale='zh'}=Astro.props;
const registry=await getEntityRegistry();
const site=getLocalizedSite(await getCollection('site'),locale);
const copy=databaseBrowseCopy(locale);
const entities=registry.list(locale).filter(e=>e.data.entityType!=='editorial-article');
const peopleById=new Map(entities.filter(e=>['person','virtual-avatar','unit','software-voice'].includes(e.data.entityType)).map(e=>[e.data.id,e.data]));
const projectsById=new Map(entities.filter(e=>e.data.entityType==='project').map(e=>[e.data.id,e.data]));
const collectionOrder=['people','music','projects','lives','organizations','lore','isotopes'];
const records=entities.flatMap(entity=>{
  const relatedProjectIds=registry.getRelations(entity.data.id).filter(edge=>projectsById.has(edge.target)).map(edge=>edge.target);
  const record=toDatabaseRecord(entity,locale,{peopleById,projectsById,relatedProjectIds});
  if(!record)return [];
  const typeLabel=entityLabel(record.type,locale);
  const searchText=foldCjkSearchText([record.searchText,typeLabel,copy.collections[record.collection],...record.genres.map(genre=>entityLabel(genre,locale))].join(' '));
  // Remote temporary nameplates use the same local fallback as missing artwork.
  const artwork=record.image&&!/^https?:\/\/placehold\.co(?:\/|$)/i.test(record.image)?record.image:DATABASE_ARTWORK_FALLBACKS[record.id];
  const imageProps=artwork?imageAttributes(artwork,{widths:[192,480,960],sizes:'(max-width:760px) 50vw, (max-width:1050px) 46vw, (max-width:1440px) 30vw, 450px'}):null;
  return [{...record,searchText,typeLabel,imageProps,sortOrder:entity.data.presentation?.sortOrder??999}];
}).sort((a,b)=>collectionOrder.indexOf(a.collection)-collectionOrder.indexOf(b.collection)||a.sortOrder-b.sortOrder||a.title.localeCompare(b.title,locale));
const facets=collectDatabaseFacets(records);
const collections=databaseCollectionCounts(records).map(row=>({...row,label:copy.collections[row.id]}));
const initial=records.slice(0,24);
const payload=JSON.stringify({records,facets,copy}).replace(/</g,'\\u003c');
---
<BaseLayout title={`${copy.title} · Kamitsubaki Studio Fan Wiki`} lang={locale}>
  <SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/database/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
  <WorkspaceShell width="wide" class="database-catalog" data-ui-kit data-database-catalog data-view="grid" data-filters-open="false" data-locale={locale}>
    <WorkspaceHeader title={copy.title} intro={copy.intro} eyebrow="DATABASE / RECORDS" backHref={`/${locale}/`} backLabel={copy.home}>
      <WorkspaceButton href={`/${locale}/contribute/editor/`} tone="primary">{copy.create}</WorkspaceButton>
      <div class="database-stats" slot="status"><span><strong>{records.length.toLocaleString('en-US')}</strong> RECORDS</span><span><strong>{collections.length}</strong> COLLECTIONS</span></div>
    </WorkspaceHeader>
    <nav class="database-collections" aria-label={copy.collection}>
      <a href={`/${locale}/database/`} data-database-collection="" aria-current="true"><span>{copy.all}</span><small>{records.length}</small></a>
      {collections.map(collection=><a href={`/${locale}/database/?collection=${collection.id}`} data-database-collection={collection.id}><span>{collection.label}</span><small>{collection.count}</small></a>)}
    </nav>
    <section class="database-browser" aria-labelledby="database-browse-title">
      <h2 id="database-browse-title">{copy.browse}</h2>
      <form class="database-query" role="search" data-database-form>
        <label class="database-search"><span class="database-visually-hidden">{copy.search}</span><Icon name="search" /><WorkspaceControl class="dui-input dui-input-ghost" type="search" name="q" aria-label={copy.search} placeholder={copy.placeholder} autocomplete="off"/></label>
        <WorkspaceButton type="button" class="database-filter-toggle dui-btn dui-btn-ghost" data-database-filter-toggle aria-expanded="false" aria-controls="database-filters"><Icon name="sliders-horizontal" /><span>{copy.filters}</span><Icon name="chevron-down" class="database-filter-chevron" /></WorkspaceButton>
        <div class="database-filters" id="database-filters">
          <label><span>{copy.type}</span><WorkspaceControl as="select" class="dui-select" name="type" aria-label={copy.type}><option value="">{copy.allValues}</option>{facets.types.map(type=><option value={type}>{entityLabel(type,locale)}</option>)}</WorkspaceControl></label>
          <label><span>{copy.artist}</span><WorkspaceControl as="select" class="dui-select" name="artist" aria-label={copy.artist}><option value="">{copy.allValues}</option>{facets.artists.map(artist=><option value={artist.id}>{artist.label}</option>)}</WorkspaceControl></label>
          <label><span>{copy.year}</span><WorkspaceControl as="select" class="dui-select" name="year" aria-label={copy.year}><option value="">{copy.allValues}</option>{facets.years.map(year=><option value={year}>{year}</option>)}{facets.hasUnknownYear&&<option value="unknown">{copy.unknownYear}</option>}</WorkspaceControl></label>
          <label><span>{copy.genre}</span><WorkspaceControl as="select" class="dui-select" name="genre" aria-label={copy.genre}><option value="">{copy.allValues}</option>{facets.genres.map(genre=><option value={genre}>{entityLabel(genre,locale)}</option>)}</WorkspaceControl></label>
          <label><span>{copy.project}</span><WorkspaceControl as="select" class="dui-select" name="project" aria-label={copy.project}><option value="">{copy.allValues}</option>{facets.projects.map(project=><option value={project.id}>{project.label}</option>)}</WorkspaceControl></label>
        </div>
        <div class="database-results-bar">
          <p data-database-count role="status" aria-live="polite">{copy.shown} {initial.length} / {records.length} {copy.records}</p>
          <WorkspaceButton type="reset" class="database-clear dui-btn dui-btn-ghost" data-database-clear hidden>{copy.clear}</WorkspaceButton>
          <label class="database-sort"><span>{copy.sort}</span><WorkspaceControl as="select" name="sort">{Object.entries(copy.sortOptions).map(([value,label])=><option value={value}>{label}</option>)}</WorkspaceControl></label>
          <div class="database-view-switch" role="group" aria-label={locale==='en'?'Record layout':locale==='ja'?'表示形式':'记录视图'}>
            <WorkspaceButton type="button" class="dui-btn dui-btn-ghost" data-database-view="grid" aria-pressed="true"><Icon name="layout-grid" />Grid</WorkspaceButton>
            <WorkspaceButton type="button" class="dui-btn dui-btn-ghost" data-database-view="list" aria-pressed="false"><Icon name="list" />List</WorkspaceButton>
          </div>
        </div>
      </form>
      <div class="database-active-filters" data-database-active-filters aria-label={copy.activeFilters} hidden></div>
      <div class="database-list-heading" aria-hidden="true"><span>{copy.record}</span><span>{copy.type}</span><span>{copy.artist}</span><span>{copy.year}</span></div>
      <ul class="database-records" data-database-records>{initial.map(record=><DatabaseRecord record={record} placeholderLabel={copy.imagePending}/>)}</ul>
      <div class="database-empty" data-database-empty hidden><p>{copy.empty}</p><span>{copy.emptyHint}</span><WorkspaceButton type="button" data-database-empty-clear>{copy.clear}</WorkspaceButton></div>
      <WorkspaceButton type="button" class="database-more" data-database-more hidden={records.length<=24}>{copy.more}<span aria-hidden="true"><Icon name="arrow-down" /></span></WorkspaceButton>
    </section>
    <details class="database-classification" data-database-classification id="database-classification">
      <summary><span>{copy.tree}</span><Icon name="chevron-down" /></summary>
      <p>{copy.treeHint}</p>
      <ClassificationDirectory locale={locale}/>
    </details>
    <script is:inline type="application/json" data-database-record-data set:html={payload}/>
  </WorkspaceShell>
  <SiteFooter footer={site.footer}/>
</BaseLayout>
<script>import '../scripts/databaseBrowse.js';</script>
