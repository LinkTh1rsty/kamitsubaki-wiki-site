---
import WorkspaceControl from './WorkspaceControl.astro';
import Icon from './Icon.astro';
import WorkspaceFilters from './WorkspaceFilters.astro';
import WorkspaceShell from './WorkspaceShell.astro';
import ClassificationDirectory from './ClassificationDirectory.astro';
import WorkspaceHeader from './WorkspaceHeader.astro';
import WorkspaceButton from './WorkspaceButton.astro';
import ContextAction from './ContextAction.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import '../styles/labsFeatures.css';
import {navigationCategories,categoryLabel,inNavigationCategory} from '../lib/entityNavigation.mjs';
import {entityLabel} from '../lib/entityLabels.mjs';
import {getCollection} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';import SiteNav from './SiteNav.astro';import SiteFooter from './SiteFooter.astro';
import {getLocalizedSite} from '../lib/homeData.mjs';import {buildLocaleLinks,resolveLocaleCopy} from '../lib/i18n.mjs';import {getEntityRegistry} from '../lib/entityRegistry.mjs';import {loadTaxonomy} from '../lib/featureData.mjs';import '../styles/encyclopedia.css';import '../styles/observatoryWorkspaces.css';
const {locale,articles=false,category=''}=Astro.props;const r=await getEntityRegistry();const site=getLocalizedSite(await getCollection('site'),locale);const entries=r.list(locale).filter(e=>(e.data.entityType==='editorial-article')===articles);
const copy=resolveLocaleCopy({zh:{title:articles?'文章':'客观百科资料库',intro:articles?'记录、观点与研究，欢迎每一位观测者参与。登录后可投稿或提交修改，由站长审核后发布。':'人物、音乐、企划与世界观，在同一份档案中相互连接。',search:articles?'搜索文章、作者或关键词':'检索名称、制作人或作品',all:articles?'全部文章分类':'全部类型',artist:'按演唱者',creator:'按制作人',genre:'按曲风',allPeople:'全部人物',allGenres:'全部曲风',empty:'没有符合条件的资料。'},ja:{title:articles?'記事':'データベース',intro:articles?'誰でも投稿・修正を提案できます。ログイン後に送信し、管理者の審査を経て公開されます。':'人物、音楽、企画、世界観を横断する資料。',search:articles?'記事・著者・キーワードを検索':'名前・クリエイター・作品を検索',all:articles?'すべての記事分類':'すべての種類',artist:'歌手別',creator:'制作者別',genre:'ジャンル別',allPeople:'すべての人物',allGenres:'すべてのジャンル',empty:'該当する資料はありません。'},en:{title:articles?'Articles':'The database',intro:articles?'Everyone can submit articles and suggest edits. Sign in to submit; the site owner reviews changes before publication.':'People, music, projects and worlds, connected through shared records.',search:articles?'Search articles, authors or keywords':'Search names, creators or works',all:articles?'All article categories':'All types',artist:'By performer',creator:'By creator',genre:'By genre',allPeople:'All people',allGenres:'All genres',empty:'No matching records.'}},locale);
const categories=navigationCategories;
const people=r.list(locale).filter(e=>['person','virtual-avatar','unit','software-voice'].includes(e.data.entityType));const genres=(await loadTaxonomy('genres')).values.filter(g=>entries.some(e=>e.data.genres?.includes(g)));
---
<BaseLayout title={`${copy.title} · Kamitsubaki Studio Fan Wiki`} lang={locale}><SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,articles?'/articles/':'/database/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
<WorkspaceShell width="wide" class:list={["wiki-v3 feature-workspace",articles&&"editorial-catalog"]} data-catalog data-result-label={locale==='en'?'records':locale==='ja'?'件の記録':'份档案'}><WorkspaceHeader title={copy.title} intro={copy.intro} eyebrow={articles?'LABs / EDITORIAL':'DATABASE'} backHref={`/${locale}/${articles?'labs/explore/':'#database'}`} backLabel={articles?'LABs':locale==='en'?'Home':locale==='ja'?'ホーム':'首页'}>{articles?<WorkspaceButton href={`/${locale}/articles/submit/`} tone="primary">{locale==='en'?'Submit an article':locale==='ja'?'記事を投稿':'投稿文章'}</WorkspaceButton>:<WorkspaceButton href={`/${locale}/contribute/editor/`} tone="primary">{locale==='en'?'Create an entry':locale==='ja'?'項目を新規作成':'新建词条'}</WorkspaceButton>}</WorkspaceHeader>

{!articles&&<ClassificationDirectory locale={locale} initial={navigationCategories.find(c=>c.path===category)?.id||'people'}/>}
<details class="catalog-search-drawer" open={articles}><summary>{locale==='en'?'Search across records':locale==='ja'?'全資料を検索':'跨分类检索 · 名称、人物与曲风'}</summary>
<div class="catalog-layout catalog-layout--editorial">
<section class="catalog-results"><WorkspaceFilters collapsible={articles} class="toolbar feature-filters" role="search"><label><span>{copy.search}</span><WorkspaceControl name="q" type="search" placeholder={copy.search} aria-label={copy.search}/></label><label><span>{copy.all}</span><WorkspaceControl as="select" name="type" aria-label={copy.all}><option value="">{copy.all}</option>{[...new Set(entries.map(e=>articles?e.data.articleCategory:e.data.entityType))].map(t=><option value={t}>{entityLabel(t,locale)}</option>)}</WorkspaceControl></label>{!articles&&<><fieldset class="perspective-rail"><legend>{locale==='en'?'Perspective':locale==='ja'?'視点':'浏览视角'}</legend>{[['artist',copy.artist],['creator',copy.creator],['genre',copy.genre]].map(([value,label])=><label><WorkspaceControl type="radio" name="perspective" value={value} checked={value==='artist'}/><span>{label}</span></label>)}</fieldset><label data-person-filter><span>{copy.allPeople}</span><WorkspaceControl as="select" name="person" aria-label={copy.allPeople}><option value="">{copy.allPeople}</option>{people.map(e=><option value={e.data.id}>{e.data.name}</option>)}</WorkspaceControl></label><label data-genre-filter hidden><span>{copy.allGenres}</span><WorkspaceControl as="select" name="genre" aria-label={copy.allGenres}><option value="">{copy.allGenres}</option>{genres.map(g=><option value={g}>{entityLabel(g,locale)}</option>)}</WorkspaceControl></label></>}<WorkspaceButton type="reset" class="filter-reset">{locale==='en'?'Clear filters':locale==='ja'?'条件をクリア':'清除筛选'}</WorkspaceButton></WorkspaceFilters>
<p data-count class="feature-count" aria-live="polite">{Math.min(24,entries.length)} / {entries.length}</p><div class="entry-grid">{entries.map((e,index)=>{const d=e.data;return <a href={e.url} class="entry-card" hidden={index>=24} data-card data-title={`${d.name||d.title} ${d.romanizedName||d.romanizedTitle||''} ${d.summary||''} ${d.author||''}`.toLowerCase()} data-type={articles?d.articleCategory:d.entityType} data-performers={(d.performers||[]).map(p=>p.entity).concat(d.primaryArtist||[]).join(' ')} data-creators={(d.credits||[]).map(p=>p.entity).filter(Boolean).join(' ')} data-genres={(d.genres||[]).join(' ')}><span class="entry-record-label"><span class="eyebrow">{entityLabel(articles?d.articleCategory:d.entityType,locale)}</span><span aria-hidden="true"><Icon name="arrow-right" /></span></span>{d.presentation?.image&&<ResponsiveImage src={d.presentation.image} alt="" widths={[192,480]} sizes="240px" class="catalog-cover"/>}<h3>{d.name||d.title}</h3><p>{d.summary||d.description||d.profileTagline||d.romanizedName||d.releaseDate}</p></a>})}</div><div class="empty catalog-empty" data-empty hidden><span>{copy.empty}</span><WorkspaceButton type="button" class="context-action" data-tone="secondary" data-empty-clear>{locale==='en'?'Clear filters':locale==='ja'?'条件をクリア':'清除筛选'}</WorkspaceButton>{!articles&&<ContextAction href={`/${locale}/contribute/editor/`}>{locale==='en'?'Create an entry':locale==='ja'?'項目を新規作成':'新建词条'}</ContextAction>}</div><WorkspaceButton type="button" class="archive-load-more" data-catalog-more hidden={entries.length<=24}>{locale==='en'?'Load 24 more':locale==='ja'?'さらに24件を表示':'继续浏览 · 再显示 24 条'} <span aria-hidden="true"><Icon name="arrow-down" /></span></WorkspaceButton></section></div>
</details>
</WorkspaceShell><SiteFooter footer={site.footer}/></BaseLayout>
<script>
const root=document.querySelector('[data-catalog]');const form=root?.querySelector('form');if(root&&form){const cards=[...root.querySelectorAll<HTMLElement>('[data-card]')];const controls=[...form.querySelectorAll<HTMLInputElement|HTMLSelectElement>('input,select')];let limit=24;const more=root.querySelector<HTMLButtonElement>('[data-catalog-more]')!;const apply=(push=false)=>{const v=Object.fromEntries(new FormData(form).entries());const genreMode=v.perspective==='genre';const pf=root.querySelector<HTMLElement>('[data-person-filter]');const gf=root.querySelector<HTMLElement>('[data-genre-filter]');if(pf)pf.hidden=genreMode;if(gf)gf.hidden=!genreMode;let n=0;cards.forEach(card=>{const type=!v.type||card.dataset.type===v.type;const person=v.perspective==='genre'||!v.person||(card.dataset[v.perspective==='creator'?'creators':'performers']||'').split(' ').includes(String(v.person));const genre=v.perspective!=='genre'||!v.genre||(card.dataset.genres||'').split(' ').includes(String(v.genre));const q=!v.q||(card.dataset.title||'').includes(String(v.q).toLowerCase());const match=type&&person&&genre&&q;if(match)n++;card.hidden=!match||n>limit;});root.querySelector('[data-count]')!.textContent=`${Math.min(limit,n)} / ${n} ${(root as HTMLElement).dataset.resultLabel}`;more.hidden=n<=limit;(root.querySelector('[data-empty]') as HTMLElement).hidden=n>0;if(push){const url=new URL(location.href);controls.forEach(c=>{if(c.type==='radio'&&!(c as HTMLInputElement).checked)return;c.value?url.searchParams.set(c.name,c.value):url.searchParams.delete(c.name);});history.replaceState(null,'',url);}};const restore=()=>{const p=new URLSearchParams(location.search);controls.forEach(c=>{if(c.type==='radio')(c as HTMLInputElement).checked=c.value===(p.get(c.name)||'artist');else c.value=p.get(c.name)||'';});apply();};more.addEventListener('click',()=>{limit+=24;apply();});root.querySelector<HTMLButtonElement>('[data-empty-clear]')?.addEventListener('click',()=>form.reset());form.addEventListener('reset',()=>requestAnimationFrame(()=>{limit=24;apply(true);}));form.addEventListener('input',()=>{limit=24;apply(true);});form.addEventListener('submit',e=>e.preventDefault());addEventListener('popstate',restore);restore();}
</script>

<style is:global>
.catalog-navigation{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 28px;margin:24px 0 36px}.catalog-category{display:flex;align-items:center;gap:12px;border-bottom:1px solid rgb(var(--theme-fg-rgb)/.12);padding:16px 0;text-decoration:none;font-size:12px;transition:color .2s}.catalog-category>span:last-child{margin-left:auto;opacity:.35}.category-number{font:var(--ui-font-xs) var(--font-mono);opacity:.35}.catalog-category:hover{color:var(--theme-accent-color)}.catalog-category[aria-current]{background:none!important;border-color:var(--theme-accent-color)}@media(max-width:900px){.catalog-navigation{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 18px}}@media(max-width:520px){.catalog-category{font-size:var(--ui-font-xs);gap:8px}}

.wiki-v3.feature-workspace .feature-filters:not([data-workspace-toolbar]){display:grid;grid-template-columns:2fr 1fr 1.7fr 1fr}.feature-workspace .perspective-rail{background:var(--theme-bg);border:0;padding:0;margin:0;display:flex;align-items:end;gap:0;position:relative;padding:16px 12px 10px;min-width:0}.perspective-rail legend{position:absolute;top:8px;left:12px;font-size:var(--ui-font-xs);color:var(--reader-muted)}.feature-filters .perspective-rail label{padding:0;background:transparent;display:block;flex:1;position:relative;cursor:pointer}.feature-workspace .feature-filters .perspective-rail input{position:absolute;opacity:0;width:1px;height:1px}.perspective-rail label span{display:block;text-align:center;padding:12px 5px;border-block:1px solid var(--reader-line);font-size:var(--ui-font-xs);white-space:nowrap;transition:color .2s,background .2s}.perspective-rail input:checked+span{color:var(--theme-accent-color);background:rgb(var(--theme-fg-rgb)/.055);border-bottom-color:var(--theme-accent-color)}.perspective-rail input:focus-visible+span{outline:2px solid var(--theme-accent-color);outline-offset:3px}.feature-filters [hidden]{display:none}.entry-card{transition:background .25s,transform .25s}.entry-card:hover{background:rgb(var(--theme-fg-rgb)/.035);transform:translateY(-2px)}.entry-card h3{font-family:var(--font-serif)}.entry-card .catalog-cover{aspect-ratio:1;object-position:top;height:auto!important;max-height:250px}.feature-count{font-family:var(--font-mono);border-bottom:1px solid var(--reader-line);padding-bottom:15px}@media(max-width:900px){.wiki-v3.feature-workspace .feature-filters:not([data-workspace-toolbar]){grid-template-columns:1fr 1fr}.perspective-rail{min-height:62px}}@media(max-width:520px){.wiki-v3.feature-workspace .feature-filters:not([data-workspace-toolbar]){grid-template-columns:1fr}.entry-grid{grid-template-columns:1fr 1fr}.entry-card{padding:14px}.entry-card h3{font-size:17px}}@media(prefers-reduced-motion:reduce){.entry-card{transition:none}.entry-card:hover{transform:none}}

.editorial-catalog .wiki-v3.feature-workspace .feature-filters:not([data-workspace-toolbar]){display:grid;grid-template-columns:2fr 1fr}.editorial-catalog .entry-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 48px;border:0;background:none}.editorial-catalog .entry-card{padding:32px 0;border-top:1px solid rgb(var(--theme-fg-rgb)/.18);background:none;box-shadow:none}.editorial-catalog .entry-card h3{font:500 24px/1.8 var(--font-serif);margin:22px 0 14px}.editorial-catalog .entry-card p{font-size:13px;line-height:1.9;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.entry-record-label{display:flex;justify-content:space-between;gap:20px}.entry-record-label>span:last-child{font-size:12px;color:rgb(var(--theme-fg-rgb)/.3)}.entry-card .catalog-cover{width:100%;height:180px;object-fit:cover;margin:20px 0}.editorial-catalog .entry-card:hover h3{color:var(--theme-accent-color)}@media(max-width:760px){.editorial-catalog .entry-grid{grid-template-columns:1fr}.editorial-catalog .entry-card h3{font-size:21px}.editorial-catalog .wiki-v3.feature-workspace .feature-filters:not([data-workspace-toolbar]){grid-template-columns:1fr}}
</style>

<style>.catalog-search-drawer{margin-top:48px;border-top:1px solid rgb(var(--theme-fg-rgb)/.2);padding-top:24px}.catalog-search-drawer>summary{cursor:pointer;font:16px/1.8 var(--font-serif);margin-bottom:28px}.editorial-catalog .catalog-search-drawer>summary{display:none}.catalog-search-drawer .catalog-layout{display:block}</style>
<style>.catalog-empty{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;padding:1rem 0;color:var(--reader-muted);font-size:.8rem}.catalog-empty[hidden]{display:none}.catalog-empty span{flex-basis:100%;margin-bottom:.25rem}</style>
