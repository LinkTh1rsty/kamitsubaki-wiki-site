---
import {benefitsCopy} from '../lib/benefitsCopy.mjs';
import {imageLibraryCopy} from '../lib/imageLibraryCopy.mjs';
import {accountWorkspaceCopy} from '../lib/accountWorkspaceCopy.mjs';
import {accountCopy} from '../lib/accountCopy.mjs';
import {centralAccountFrontendOrigin,centralAccountUIOrigin} from '../lib/centralAccountOrigins.mjs';
interface Props {locale:string; active?:'account'|'creator';}
const {locale,active='account'}=Astro.props;
const ui=accountWorkspaceCopy(locale),c=accountCopy(locale),base=`/${locale}/account/`;
const groups=[
  {label:locale==='en'?'WORKSPACE':locale==='ja'?'作業':'工作',items:[['overview',ui.overview],['creator',ui.creator],['images',imageLibraryCopy(locale).title]]},
  {label:locale==='en'?'LIBRARY':locale==='ja'?'保存':'收藏',items:[['library',c.library]]},
  {label:locale==='en'?'ACCOUNT':locale==='ja'?'アカウント':'账户',items:[['benefits',benefitsCopy(locale).title],['profile',c.profile],['security',ui.security],['data',c.data],['appearance',ui.appearance]]},
] as const;
const apiBase=import.meta.env.PUBLIC_AI_OBSERVER_API_BASE || 'https://api.kamitsubaki.wiki';
const siteOrigin=centralAccountFrontendOrigin(apiBase,import.meta.env.PUBLIC_SITE_URL||Astro.site?.origin);
const security=new URL('/auth/security',centralAccountUIOrigin(apiBase));security.searchParams.set('locale',locale);security.searchParams.set('returnTo',`${siteOrigin}${base}#overview`);
---
<nav class="account-sections" aria-label={c.title}>
  {groups.map(group=><div class="account-sections-group"><span class="account-sections-heading">{group.label}</span>{group.items.map(([key,label])=>{
    const href=key==='security'?security.toString():key==='images'?`/${locale}/gallery/mine/`:key==='creator'?`${base}creator/`:active==='creator'?`${base}#${key}`:`#${key}`;
    return <a href={href} data-account-security={key==='security'||undefined} data-account-label={label} aria-current={key==='creator'&&active==='creator'?'page':key==='overview'&&active==='account'?'location':undefined}>{label}{key==='creator'&&<b data-creator-unread hidden></b>}</a>;
  })}</div>)}
</nav>
