---
import WorkspaceButton from './WorkspaceButton.astro';
import Icon from './Icon.astro';
import AppearanceControls from './AppearanceControls.astro';
import {featuresFor} from '../lib/siteFeatures.mjs';
import {accountCopy} from '../lib/accountCopy.mjs';
import CompactLanguageSwitcher from './CompactLanguageSwitcher.astro';
import { resolveLocaleCopy } from '../lib/i18n.mjs';

type NavItem = {
  label: string;
  href: string;
};

type LocaleLink = {
  code: string;
  label: string;
  shortLabel: string;
  navShortLabel?: string;
  dropdownLabel?: string;
  href: string;
  current: boolean;
};

const { navItems, localeLinks, brandLines, homeHref = '/', compact = false } = Astro.props as {
  navItems: NavItem[];
  localeLinks: LocaleLink[];
  brandLines: string[];
  homeHref?: string;
  compact?: boolean;
};


const currentLocale = localeLinks.find((item) => item.current)?.code ?? 'en';
const primaryFeatures=featuresFor(currentLocale,'main');
const labsLabel=primaryFeatures.find(item=>item.id==='explore')!.title;
const preferencesCopy = resolveLocaleCopy({
  zh: {language: '语言', theme: '主题'},
  ja: {language: '言語', theme: 'テーマ'},
  en: {language: 'Language', theme: 'Theme'},
}, currentLocale);
const menuCopy = resolveLocaleCopy({
  zh:{menu:'菜单',title:'探索与设置',about:'关于本站',experiences:'互动体验',database:'艺人资料',songs:'歌曲',albums:'专辑',projects:'企划',game:'游戏'},
  ja:{menu:'メニュー',title:'探索と設定',about:'サイトについて',experiences:'体験',database:'アーティスト',songs:'楽曲',albums:'アルバム',projects:'プロジェクト',game:'ゲーム'},
  en:{menu:'Menu',title:'Explore & settings',about:'About',experiences:'Experiences',database:'Artists',songs:'Songs',albums:'Albums',projects:'Projects',game:'Games'},
},currentLocale);
const searchLabel = resolveLocaleCopy({
  zh: '打开站内搜索',
  ja: 'サイト内検索を開く',
  en: 'Open site search',
}, currentLocale);
const themeCopy = resolveLocaleCopy({
  zh: {
    groupLabel: '主题模式',
    options: [
      { value: 'system', shortLabel: '系', label: '跟随系统模式' },
      { value: 'dark', shortLabel: '夜', label: '使用深色模式' },
      { value: 'light', shortLabel: '日', label: '使用浅色模式' },
    ],
  },
  ja: {
    groupLabel: 'テーマモード',
    options: [
      { value: 'system', shortLabel: '自', label: 'システム設定に従う' },
      { value: 'dark', shortLabel: '夜', label: 'ダークモードを使用' },
      { value: 'light', shortLabel: '昼', label: 'ライトモードを使用' },
    ],
  },
  en: {
    groupLabel: 'Theme mode',
    options: [
      { value: 'system', shortLabel: 'SYS', label: 'Follow system theme' },
      { value: 'dark', shortLabel: 'NIGHT', label: 'Use dark mode' },
      { value: 'light', shortLabel: 'DAY', label: 'Use light mode' },
    ],
  },
}, currentLocale);
---

<nav class:list={["site-nav home-chrome", compact ? "home-chrome--compact" : "site-nav--home"]} aria-label={currentLocale === 'ja' ? 'メインナビゲーション' : currentLocale === 'en' ? 'Main navigation' : '主导航'}>
  <div class="site-nav__home-cluster">
    <a href={homeHref} class="home-chrome__brand" data-home-nav-brand>
      <p>{brandLines.map((line, index) => <>{line}{index < brandLines.length - 1 && <br />}</>)}</p>
    </a>
  </div>
  <div class="home-chrome__actions">
    <a class="account-nav" data-account-nav href={`/${currentLocale}/account/`}>{accountCopy(currentLocale).title}</a>
    <a href={`/${currentLocale}/explore/`} class="home-chrome__labs">{labsLabel}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
    <a href={`/${currentLocale}/graph/`} class="home-chrome__labs" data-nav-graph>Graph<span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
    <WorkspaceButton class="home-chrome__search" type="button" data-search-open aria-label={searchLabel} title={searchLabel}>
      <Icon name="search" />
    </WorkspaceButton>
    <details class="home-chrome__menu" data-chrome-menu>
      <summary aria-label={menuCopy.menu}><span>{menuCopy.menu}</span><Icon name="menu" /></summary>
      <div class="home-chrome__panel">
        <p class="home-chrome__eyebrow">{menuCopy.title} <kbd data-search-shortcut>Ctrl+K</kbd></p>
        <div class="home-chrome__links">
          <a href={`/${currentLocale}/account/`} data-account-nav style="--menu-step:0">{accountCopy(currentLocale).title}</a>
          {primaryFeatures.map((item, index) => <a href={item.href} style={`--menu-step:${index + 1}`}><small aria-hidden="true">{String(index + 1).padStart(2, '0')}</small>{item.title}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>)}
        </div>
        <div class="site-nav__controls-origin" data-home-nav-controls-origin>
          <div class="site-nav__portable-controls" data-home-nav-portable-controls>
            <div class="home-chrome__preferences" style={`--menu-step:${navItems.length + 1}`}>
              <div class="home-chrome__preference-row home-chrome__preference-row--language">
                <span class="home-chrome__preference-label">{preferencesCopy.language}</span>
                <CompactLanguageSwitcher localeLinks={localeLinks} />
              </div>
              <div class="home-chrome__preference-row">
                <span class="home-chrome__preference-label">{preferencesCopy.theme}</span>
              <div class="site-nav__theme-switcher" data-theme-switcher role="radiogroup" aria-label={themeCopy.groupLabel}>
                {themeCopy.options.map((option: { value: string; shortLabel: string; label: string }) => (
                  <WorkspaceButton type="button" class="site-nav__theme-option" data-theme-toggle data-theme-value={option.value} role="radio" aria-checked="false" aria-label={option.label} title={option.label}>{option.shortLabel}</WorkspaceButton>
                ))}
              </div>
              </div>
              <AppearanceControls locale={currentLocale} compact accentOnly/>
            </div>
          </div>
        </div>
      </div>
    </details>
  </div>
</nav>

<script>
  import '../scripts/quietChrome.js';
</script>
