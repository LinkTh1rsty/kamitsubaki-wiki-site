---
import Icon from './Icon.astro';
import {homeFeaturedArticles} from '../data/homeEditorial.mjs';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
import ContentSkeleton from './ContentSkeleton.astro';
const {locale='zh'}=Astro.props as {locale?:string};
const copy=resolveLocaleCopy({zh:{title:'文章专栏',all:'阅读全部文章',loading:'正在载入文章…',empty:'尚无已公开文章',error:'文章暂时无法载入，请前往专栏重试。'},en:{title:'Articles',all:'All articles',loading:'Loading articles…',empty:'No published articles yet',error:'Articles are unavailable. Visit the column to retry.'},ja:{title:'記事',all:'記事一覧',loading:'記事を読み込み中…',empty:'公開記事はまだありません',error:'記事を読み込めません。一覧から再試行してください。'}},locale);
const api=import.meta.env.PUBLIC_ARTICLE_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
---
<section id="articles" class="home-articles mx-auto max-w-7xl px-5 py-20 sm:px-6" data-ui-kit data-home-articles data-api={api} data-featured={homeFeaturedArticles[locale==='ja'?'ja':locale==='en'?'en':'zh']||undefined} data-locale={locale} data-copy={JSON.stringify(copy)}>
 <header><h2>03. ARTICLES</h2><p>{copy.title}</p><a href={`/${locale}/articles/`}>{copy.all} <Icon name="arrow-right" /></a></header>
 <div class="home-article-list"><p role="status" data-home-article-status hidden></p><ContentSkeleton count={3} data-home-article-loading/><div data-home-article-items></div></div>
</section>
<script>
for(const root of document.querySelectorAll<HTMLElement>('[data-home-articles]')){
 const copy=JSON.parse(root.dataset.copy!),locale=root.dataset.locale!,status=root.querySelector<HTMLElement>('[data-home-article-status]')!,list=root.querySelector('[data-home-article-items]')!;
 const skeleton=root.querySelector<HTMLElement>('[data-home-article-loading]')!,cacheKey='home-articles:v1:'+root.dataset.api+':'+locale;
 const render=(items:any[])=>{list.replaceChildren();for(const item of items){const a=document.createElement('a');a.href=`/${locale}/articles/read/${encodeURIComponent(item.id)}/`;const title=document.createElement('h3');title.textContent=item.title;const summary=document.createElement('p');summary.textContent=item.summary;const meta=document.createElement('small');meta.textContent=[item.author,item.updatedAt].filter(Boolean).join(' · ');a.append(meta,title,summary);list.append(a);}skeleton.hidden=true;status.textContent=items.length?'':copy.empty;status.hidden=!!items.length;};
 try{const cached=JSON.parse(localStorage.getItem(cacheKey)||'null');if(Array.isArray(cached?.items)&&Date.now()-cached.at<300000)render(cached.items);}catch{}
 const load=async()=>{root.setAttribute('aria-busy','true');try{const response=await fetch(root.dataset.api+'/api/articles?locale='+(locale.startsWith('zh')?'zh':locale),{signal:AbortSignal.timeout(15000)});if(!response.ok)throw Error();const data=await response.json();let items=data.items.slice(0,4);if(root.dataset.featured){try{const featuredResponse=await fetch(root.dataset.api+'/api/articles/items/'+encodeURIComponent(root.dataset.featured)+'?locale='+(locale.startsWith('zh')?'zh':locale),{signal:AbortSignal.timeout(15000)});if(featuredResponse.ok){const featured=await featuredResponse.json();if(!featured.fallback&&featured.article)items=[featured.article,...data.items.filter((item:any)=>item.id!==featured.article.id).slice(0,3)];}}catch{/* Latest public articles remain available. */}}render(items);try{localStorage.setItem(cacheKey,JSON.stringify({items,at:Date.now()}));}catch{}}catch{skeleton.hidden=true;status.textContent=copy.error;status.hidden=false;}finally{root.setAttribute('aria-busy','false');}};
 const observer=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting)){observer.disconnect();void load();}},{rootMargin:'300px'});observer.observe(root);
}
</script>
<style>
.home-articles{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,3fr);gap:48px}header h2{font-size:var(--ui-font-xs);letter-spacing:.25em;font-weight:300}header p{font:var(--ui-font-xs) var(--font-serif);opacity:.55;margin:8px 0 28px}header a{font-size:12px}.home-article-list{min-width:0;min-height:260px;overflow-wrap:anywhere}.home-article-list :global(a){display:block;padding:18px 0;border-bottom:1px solid rgb(var(--theme-fg-rgb)/.14);transition:color 180ms}.home-article-list :global(a:hover){color:var(--theme-accent-color)}.home-article-list :global(h3){font:22px/1.5 var(--font-serif);margin:8px 0}.home-article-list :global(a:first-child h3){font-size:28px}.home-article-list :global(p){font-size:13px;opacity:.65;line-height:1.8}.home-article-list :global(small){font-size:var(--ui-font-xs);opacity:.5}@media(max-width:760px){.home-articles{grid-template-columns:minmax(0,1fr);gap:24px}}
</style>
