---
import LoadingStatus from './LoadingStatus.astro';
import ManualContributors from './ManualContributors.astro';
import { getEditableLocale, resolveLocaleCopy } from '../lib/i18n.mjs';

interface Props {
  mode: 'summary' | 'entry';
  locale?: 'zh' | 'ja' | 'en' | string;
  collection?: string;
  entryId?: string;
  sourcePath?: string;
}

const { mode, locale = 'zh', collection = '', entryId = '', sourcePath = '' } = Astro.props as Props;
const apiBase = import.meta.env.PUBLIC_AI_OBSERVER_API_BASE || 'https://api.kamitsubaki.wiki';
const guideHref = `/${locale}/contribute/`;
const syntaxHref = `/${locale}/docs/contribute/syntax/`;
const formatHref = `/${locale}/docs/contribute/format/`;
const ownerLogin = import.meta.env.PUBLIC_SITE_OWNER_GITHUB || 'LinkTh1rsty';
const editableCollections = new Set(['artists', 'albums', 'songs', 'projects', 'logs', 'people', 'units', 'isotopes', 'releases', 'lives', 'organizations', 'lore', 'articles']);
const editableLocale = getEditableLocale(locale);
const targetPath = sourcePath ? sourcePath.replace(/\/(zh|ja|en|zh-tw|zh-hk)\.md$/, `/${editableLocale}.md`) : editableCollections.has(collection) && entryId ? `src/content/${collection}/${entryId}/${editableLocale}.md` : '';
const editorHref = `/${locale}/contribute/editor/`;
const editHref = targetPath ? `${editorHref}?target=${encodeURIComponent(targetPath)}` : editorHref;
const resolvedCopy = resolveLocaleCopy({
  zh: {
    kicker: mode === 'entry' ? 'ENTRY KEEPERS' : 'COMMUNITY ARCHIVE',
    title: mode === 'entry' ? '守护这个词条的贡献者' : '一起建设这座观测站',
    subtitle: mode === 'entry' ? '每一次校正、补充和翻译，都让这份记录更完整。' : '词条、翻译、功能、设计与基础设施都属于贡献。排行榜按去重提交统计，不以改动文件数量刷榜。',
    loading: '正在连接贡献记录…',
    empty: '这里还没有公开维护记录。你可以成为第一位贡献者。',
    error: '贡献记录暂时无法读取，请稍后重试。',
    retry: '重新读取',
    cached: '暂时显示已保存的贡献记录，可稍后重新读取。',
    recentUnavailable: '最近贡献记录暂时无法更新。',
    ownerKicker: 'SITE STEWARD',
    ownerTitle: '站长与主理人',
    ownerRole: '负责产品方向、功能开发、基础设施与社区维护。',
    ownerBadge: '站长',
    topTitle: '总贡献排行',
    recentTitle: '最近贡献',
    contributors: '贡献者',
    contributions: '次有效提交',
    entries: '个内容词条',
    contentContributions: '内容贡献',
    functionalContributions: '功能贡献',
    areas: '个功能领域',
    rankLabel: '荣誉序号',
    guideAction: '贡献中心',
    syntaxAction: '语法属性指南',
    formatAction: '统一格式指南',
    joinAction: mode === 'entry' ? '维护这个词条' : '打开编辑器',
    commit: '查看修改',
    unknownSummary: '完善词条资料',
    maintainedEntry: '维护了',
    collectionLabels: { development: '功能开发', documentation: '项目文档', design: '视觉与资产' },
    areaLabels: { automation: '自动化与 CI', quality: '测试与质量', 'wiki-docs': 'Wiki 文档', 'backend-docs': '后端文档', 'site-assets': '站点视觉资产', 'data-platform': '数据平台', 'backend-services': '后端服务', 'backend-tooling': '后端工程', 'site-experience': '站点体验', 'content-platform': '内容平台', 'contributor-tooling': '贡献工具链', 'site-tooling': '前端工程' },
    localeLabels: { zh: '中文', ja: '日本語', en: 'English' },
  },
  ja: {
    kicker: mode === 'entry' ? 'ENTRY KEEPERS' : 'COMMUNITY ARCHIVE',
    title: mode === 'entry' ? 'この記事を守る貢献者' : 'この観測拠点を一緒に築く',
    subtitle: mode === 'entry' ? '修正、追記、翻訳の一つひとつが記録をより確かなものにします。' : '記事、翻訳、機能、デザイン、基盤整備をすべて貢献として記録し、重複しないコミット単位で集計します。',
    loading: '貢献記録に接続しています…',
    empty: '公開メンテナンス記録はまだありません。最初の貢献者になれます。',
    error: '貢献記録を読み込めませんでした。もう一度お試しください。',
    retry: '再読み込み',
    cached: '保存済みの貢献記録を表示しています。後でもう一度読み込めます。',
    recentUnavailable: '最近の貢献記録は一時的に更新できません。',
    ownerKicker: 'SITE STEWARD',
    ownerTitle: 'サイトオーナー',
    ownerRole: 'プロダクト方針、機能開発、基盤、コミュニティ運営を担当。',
    ownerBadge: 'サイトオーナー',
    topTitle: '総合貢献ランキング',
    recentTitle: '最近の貢献',
    contributors: '貢献者',
    contributions: '件の有効コミット',
    entries: '件の記事',
    contentContributions: 'コンテンツ貢献',
    functionalContributions: '機能貢献',
    areas: '機能領域',
    rankLabel: 'オナー番号',
    guideAction: '貢献センター',
    syntaxAction: '構文属性ガイド',
    formatAction: '統一スタイルガイド',
    joinAction: mode === 'entry' ? 'この記事を編集する' : 'エディターを開く',
    commit: '変更を見る',
    unknownSummary: '記事資料を更新',
    maintainedEntry: 'メンテナンス',
    collectionLabels: { development: '機能開発', documentation: 'プロジェクト文書', design: 'デザイン・素材' },
    areaLabels: { automation: '自動化・CI', quality: 'テスト・品質', 'wiki-docs': 'Wiki 文書', 'backend-docs': 'バックエンド文書', 'site-assets': 'サイト素材', 'data-platform': 'データ基盤', 'backend-services': 'バックエンド', 'backend-tooling': 'バックエンド基盤', 'site-experience': 'サイト体験', 'content-platform': 'コンテンツ基盤', 'contributor-tooling': '貢献ツール', 'site-tooling': 'フロントエンド基盤' },
    localeLabels: { zh: '中文', ja: '日本語', en: 'English' },
  },
  en: {
    kicker: mode === 'entry' ? 'ENTRY KEEPERS' : 'COMMUNITY ARCHIVE',
    title: mode === 'entry' ? 'Contributors keeping this entry accurate' : 'Build this observatory together',
    subtitle: mode === 'entry' ? 'Every correction, source, and translation makes this record stronger.' : 'Entries, translations, features, design, and infrastructure all count. Rankings use unique commits rather than changed-file volume.',
    loading: 'Connecting to contribution records…',
    empty: 'No public maintenance record yet. You can be the first contributor.',
    error: 'Contribution records are temporarily unavailable. Please try again.',
    retry: 'Try again',
    cached: 'Showing saved contribution records while updates are unavailable.',
    recentUnavailable: 'Recent contribution activity is temporarily unavailable.',
    ownerKicker: 'SITE STEWARD',
    ownerTitle: 'Site owner and steward',
    ownerRole: 'Leads product direction, feature development, infrastructure, and community maintenance.',
    ownerBadge: 'Site owner',
    topTitle: 'Overall contribution ranking',
    recentTitle: 'Recent contributions',
    contributors: 'Contributors',
    contributions: 'verified commits',
    entries: 'content entries',
    contentContributions: 'Content contributions',
    functionalContributions: 'Feature contributions',
    areas: 'functional areas',
    rankLabel: 'Honor number',
    guideAction: 'Contribution hub',
    syntaxAction: 'Read the syntax guide',
    formatAction: 'Unified style guide',
    joinAction: mode === 'entry' ? 'Improve this entry' : 'Open editor',
    commit: 'View change',
    unknownSummary: 'Improved entry information',
    maintainedEntry: 'Maintained',
    collectionLabels: { development: 'Feature development', documentation: 'Project documentation', design: 'Design and assets' },
    areaLabels: { automation: 'Automation and CI', quality: 'Testing and quality', 'wiki-docs': 'Wiki documentation', 'backend-docs': 'Backend documentation', 'site-assets': 'Site visual assets', 'data-platform': 'Data platform', 'backend-services': 'Backend services', 'backend-tooling': 'Backend engineering', 'site-experience': 'Site experience', 'content-platform': 'Content platform', 'contributor-tooling': 'Contributor tooling', 'site-tooling': 'Frontend engineering' },
    localeLabels: { zh: '中文', ja: '日本語', en: 'English' },
  },
}, locale);
const copy = {
  ...resolvedCopy,
  localeLabels: {
    ...resolvedCopy.localeLabels,
    'zh-tw': '台繁',
    'zh-hk': '港繁',
  },
};
---

<section
  class:list={['contributor-roster', 'reveal-up', mode === 'summary' ? 'contributor-roster--summary' : 'contributor-roster--entry']}
  id={mode === 'summary' ? 'contributors' : undefined}
  data-contributor-roster
  data-mode={mode}
  data-api-base={apiBase}
  data-locale={locale}
  data-collection={collection}
  data-entry-id={entryId}
  data-guide-href={guideHref}
  data-syntax-href={syntaxHref}
  data-format-href={formatHref}
  data-edit-href={editHref}
  data-owner-login={ownerLogin}
  data-copy={JSON.stringify(copy)}
>
  <header class="contributor-roster__header">
    <div>
      <p class="contributor-roster__kicker">{copy.kicker}</p>
      <h2>{copy.title}</h2>
    </div>
    <p>{copy.subtitle}</p>
  </header>

  <div class="contributor-roster__state" role="status" data-contributor-state><LoadingStatus label={copy.loading}/></div>
  <div class="contributor-roster__content" data-contributor-content hidden></div>
  {mode === 'summary' && <ManualContributors locale={locale} />}
</section>

<script>
  import '../scripts/contributorRoster.js';
</script>
