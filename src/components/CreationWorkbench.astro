---
import {uploadGuidanceCopy} from '../lib/uploadGuidanceCopy.mjs';
import UploadGuidance from './UploadGuidance.astro';
import UploadDraftStatus from './UploadDraftStatus.astro';
import SubmissionPanel from './SubmissionPanel.astro';
import {contributionLayoutCopy} from '../lib/contributionLayoutCopy.mjs';
import WorkspaceToolbar from './WorkspaceToolbar.astro';
import CreationFields from './CreationFields.astro';
import WorkspaceButton from './WorkspaceButton.astro';
import SubmissionReceipt from './SubmissionReceipt.astro';
import {creationWorkbenchCopy} from '../lib/creationWorkbenchCopy.mjs';
import '../styles/creationWorkbench.css';
const {live=false,locale='zh'}=Astro.props;
const c=creationWorkbenchCopy(locale),layout=contributionLayoutCopy(locale),guidance=uploadGuidanceCopy(locale);
---
<section class="creation-prototype" data-creation-prototype={!live || undefined} data-creation-uploader={live || undefined} data-copy={JSON.stringify(c)} data-layout-copy={JSON.stringify(layout)} data-locale={locale}>
 <p class="creation-demo-note" hidden={live}><strong>交互原型</strong>示例设定与审核记录仅用于界面验收。选入的文件只在本机预览，不发送到服务器。</p>
 <nav hidden={live} class="creation-modes" aria-label="工作台示例"><button type="button" data-creation-mode="upload" aria-pressed="true">上传工作台</button><button type="button" data-creation-mode="review" aria-pressed="false">审核工作台</button></nav>
 <div data-creation-upload>
  {live&&<SubmissionReceipt locale={locale}/>}
  {live&&<UploadGuidance locale={locale}/>}
  <WorkspaceToolbar class="creation-toolbar"><div><h2>{c.toolbarTitle}</h2>{live&&<div class="creation-session-strip" data-upload-session aria-label={c.session}><span class="creation-session-state" data-session-state role="status">{c.connecting}</span><span class="creation-session-stat" data-session-stat hidden><small>{c.remaining}</small><strong><span data-quota-remaining>—</span> / <span data-quota-limit>—</span> {c.photosUnit}</strong></span><span class="creation-session-stat" data-session-stat hidden><small>{c.concurrent}</small><strong><span data-session-concurrency>—</span> {c.photosUnit}</strong></span><span class="creation-session-stat" data-session-expiry hidden><small>{c.expiry}</small><strong data-session-expiry-value>—</strong></span></div>}</div><div class="workspace-tool-group"><WorkspaceButton hidden={live} data-demo-files tone="quiet">{c.demoFiles}</WorkspaceButton>{live&&<a class="creation-new-draft" href={`/${locale}/gallery/manage/?mode=sets&new=1`}>{guidance.newDraft} →</a>}<WorkspaceButton data-add-set>{c.addSet}</WorkspaceButton></div></WorkspaceToolbar>
  <div class="creation-workspace">
   <aside class="creation-index"><p class="creation-caption">{c.currentSets}</p><nav data-set-index aria-label={c.setIndex}></nav></aside>
   <div class="creation-content" data-set-container>
    <section class="creation-set" data-set="set-1" id="creation-set-1"><header><div><span class="creation-caption">01 / SET</span><h3>{c.firstSet}</h3></div><div class="creation-set-actions">{live&&<><button type="button" data-remove-set>{c.removeSet}</button></>}</div></header><div class="submission-columns creation-set-layout"><SubmissionPanel title={layout.info} hint={layout.setHint} step="01" heading="h4"><CreationFields prefix="set-1" live={live} locale={locale}/></SubmissionPanel><SubmissionPanel title={layout.images} hint={layout.imageHint} step="02" heading="h4" class="creation-set-media"><div class="creation-image-heading"><strong data-set-photo-count>0 {c.photosUnit}</strong><span>{c.coverHint}</span></div><div class="creation-drop" data-drop-set="set-1" tabindex="0" aria-label={c.dropAria}><span aria-hidden="true">＋</span><strong>{c.dropPrompt}</strong><button type="button" data-select-set="set-1">{c.selectPhotos}</button><input data-file-picker type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden/></div><div data-image-list></div></SubmissionPanel></div></section>
   </div>

  </div>
  <footer class="creation-upload-footer"><div><strong data-upload-count>{c.uploadCount.replace('{photos}','0').replace('{sets}','1').replace('{staged}','0')}</strong><p data-upload-status role="status"></p>{live&&<UploadDraftStatus locale={locale}/>}<progress data-total-progress max="100" value="0" aria-label={c.progress}></progress></div><WorkspaceButton data-simulate-upload disabled tone="primary">{live?c.uploadAll:'演示上传进度'}</WorkspaceButton>{live&&<WorkspaceButton data-submit-batch disabled>{c.submitAll}</WorkspaceButton>}{live&&<ul data-upload-issues aria-label={c.issues}></ul>}</footer>
 </div>
 {!live&&<div data-creation-review hidden>
  <WorkspaceToolbar class="creation-toolbar"><div><h2>审核工作台</h2><p>队列、内容差异与审核操作保持在同一个位置</p></div><label class="creation-review-type">投稿类型<select data-review-type><option value="gallery">设定图库</option><option value="article">文章</option><option value="entry">词条</option></select></label></WorkspaceToolbar>
  <div class="creation-review-workspace">
   <aside class="creation-review-queue"><label>搜索记录<input data-review-search type="search" placeholder="标题或投稿者"/></label><div data-review-queue></div></aside>
   <section class="creation-review-body"><header><span class="creation-caption" data-review-meta>图库 · 示例</span><h3 data-review-title></h3><p data-review-description></p></header><div data-review-gallery><div class="creation-review-images"><button type="button" data-review-image="0" aria-pressed="true"><img src="/images/albums/fate-vwp-1400x1400.jpg" alt="演示图片 1"/><span>01 · 封面图</span><small data-review-image-status="0">待审核</small></button><button type="button" data-review-image="1" aria-pressed="false"><img src="/images/albums/koko/prayer.jpg" alt="演示图片 2"/><span>02 · 补充图</span><small data-review-image-status="1">待审核</small></button></div><div class="creation-review-large"><img data-review-large src="/images/albums/fate-vwp-1400x1400.jpg" alt="演示审核图片"/></div></div><div class="creation-diff"><div><span>原公开版本</span><p data-review-before>尚未公开 · 新设定</p></div><div><span>本次提交</span><p data-review-after></p></div></div></section>
   <aside class="creation-review-actions"><p class="creation-caption">REVIEW</p><h3>审核意见</h3><p class="creation-muted" data-review-help>选中图片可单独处理；公共资料通过后，已通过的图片才可公开。</p><label data-shared-review><input type="checkbox" data-approve-metadata/>公共资料已检查</label><label>处理范围<select data-review-scope><option value="current">当前图片</option><option value="all">本套全部待审核图片</option></select></label><label>审核备注<textarea data-review-note rows="5" placeholder="退回时请说明需要修改的地方"></textarea></label><WorkspaceButton data-review-approve tone="primary">通过所选（演示）</WorkspaceButton><WorkspaceButton data-review-reject>退回修改（演示）</WorkspaceButton><p data-review-status role="status"></p><p class="creation-muted">这里的操作只改变示例状态，不执行真实审核。</p></aside>
  </div>
 </div>
 }

</section>
<script>import '../scripts/creationPrototype.js';</script>
<style>.creation-prototype[data-complete] .creation-toolbar,.creation-prototype[data-complete] .creation-workspace,.creation-prototype[data-complete] .creation-upload-footer{display:none}</style>
