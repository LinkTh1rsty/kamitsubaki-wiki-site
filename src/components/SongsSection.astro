---
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
type Song = {
  href: string;
  title: string;
  subtitle: string;
  image: string | null;
  primaryInfo: string | null;
  secondaryInfo: string | null;
};

const { songs, section, locale } = Astro.props as {
  songs: Song[];
  section: {
    heading: string;
    subheading: string;
    viewAllLabel?: string;
  };
  locale: string;
};
---

<section id="songs" class="relative mx-auto max-w-7xl px-4 py-20 ui-crosshair bl br sm:px-6 sm:py-28">
  <div class="relative z-10 grid grid-cols-1 gap-9 sm:gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-3">
      <div class="sticky top-32 reveal-up">
        <h3 class="mb-2 font-mono text-[10px] tracking-[0.36em] text-[var(--theme-fg)]">{section.heading}</h3>
        <p class="mb-7 font-serif text-xs tracking-[0.16em] text-[rgb(var(--theme-fg-rgb)/0.56)]">{section.subheading}</p>

        {section.viewAllLabel && (
          <a
            href={`/${locale}/database/music/songs/`}
            class="group inline-flex items-center gap-2 text-xs tracking-wider text-[rgb(var(--theme-fg-rgb)/0.62)] transition-colors duration-300 hover:text-[var(--theme-fg)]"
          >
            <span class="border-b border-[rgb(var(--theme-fg-rgb)/0.2)] pb-1 transition-colors group-hover:border-[rgb(var(--theme-fg-rgb)/0.55)]">
              {section.viewAllLabel}
            </span>
            <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" />
          </a>
        )}
      </div>
    </div>

    <div class="flex flex-col pb-20 lg:col-span-9">
      <div class="mb-4 hidden items-end justify-between border-b border-[rgb(var(--theme-fg-rgb)/0.16)] pb-4 md:flex md:px-4 reveal-up">
        <span class="w-12 shrink-0 font-mono text-[10px] tracking-wider text-[rgb(var(--theme-fg-rgb)/0.46)]">COVER</span>
        <span class="flex-1 pl-6 font-mono text-[10px] tracking-wider text-[rgb(var(--theme-fg-rgb)/0.46)]">TITLE & ARTIST</span>
        <span class="box-content w-32 pr-12 text-right font-mono text-[10px] tracking-wider text-[rgb(var(--theme-fg-rgb)/0.46)]">INFO</span>
      </div>

      <div
        id="songs-list"
        data-home-music-list
        data-home-music-kind="songs"
        data-home-music-url={`/${locale}/home-catalog.json`}
      >
        {songs.map((song) => (
            <a href={song.href} data-music-background data-img={song.image || undefined} class="group block list-row py-6 reveal-up">
              <div class="flex flex-col justify-between gap-4 px-3 md:flex-row md:items-center md:px-4">
                <div class="flex min-w-0 flex-1 items-center gap-5 sm:gap-6">
                  <span class="grid h-12 w-12 shrink-0 place-items-center overflow-hidden border border-[rgb(var(--theme-fg-rgb)/0.12)] bg-[rgb(var(--theme-fg-rgb)/0.03)]">
                    {song.image ? (
                      <ResponsiveImage widths={[96, 192]} sizes="48px" src={song.image} alt="" class="h-full w-full object-cover opacity-85 transition duration-500 group-hover:scale-105 group-hover:opacity-100" loading="lazy" />
                    ) : (
                      <span class="font-serif text-base text-[rgb(var(--theme-fg-rgb)/0.35)]">{Array.from(song.title)[0] ?? '?'}</span>
                    )}
                  </span>
                  <div class="min-w-0">
                    <h4 class="font-serif text-lg tracking-wide text-[rgb(var(--theme-fg-rgb)/0.84)] transition-colors duration-300 group-hover:text-[var(--theme-fg)] md:text-xl">
                      {song.title}
                    </h4>
                    <span class="mt-1 block text-[11px] font-light tracking-wider text-[rgb(var(--theme-fg-rgb)/0.5)] transition-colors group-hover:text-[rgb(var(--theme-fg-rgb)/0.72)]">
                      {song.subtitle}
                    </span>
                  </div>
                </div>
                <div class="flex items-center gap-4 font-mono text-[10px] text-[rgb(var(--theme-fg-rgb)/0.45)] md:gap-8 md:text-right">
                  {song.primaryInfo && <span class="w-12 text-left md:text-right">{song.primaryInfo}</span>}
                  {song.secondaryInfo && <span class="hidden w-20 text-left md:block md:text-right">{song.secondaryInfo}</span>}
                  <Icon name="chevron-right" class="h-4 w-4 shrink-0 -translate-x-3 text-[var(--theme-fg)] opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100" />
                </div>
              </div>
            </a>
        ))}
      </div>

      <template data-home-music-template>
        <a data-home-music-link data-music-background class="group block list-row py-6 reveal-up active">
          <div class="flex flex-col justify-between gap-4 px-3 md:flex-row md:items-center md:px-4">
            <div class="flex min-w-0 flex-1 items-center gap-5 sm:gap-6">
              <span class="grid h-12 w-12 shrink-0 place-items-center overflow-hidden border border-[rgb(var(--theme-fg-rgb)/0.12)] bg-[rgb(var(--theme-fg-rgb)/0.03)]">
                <img data-home-music-image alt="" class="h-full w-full object-cover opacity-85 transition duration-500 group-hover:scale-105 group-hover:opacity-100" loading="lazy" hidden />
                <span data-home-music-placeholder class="font-serif text-base text-[rgb(var(--theme-fg-rgb)/0.35)]" hidden></span>
              </span>
              <div class="min-w-0">
                <h4 data-home-music-title class="font-serif text-lg tracking-wide text-[rgb(var(--theme-fg-rgb)/0.84)] transition-colors duration-300 group-hover:text-[var(--theme-fg)] md:text-xl"></h4>
                <span data-home-music-subtitle class="mt-1 block text-[11px] font-light tracking-wider text-[rgb(var(--theme-fg-rgb)/0.5)] transition-colors group-hover:text-[rgb(var(--theme-fg-rgb)/0.72)]"></span>
              </div>
            </div>
            <div class="flex items-center gap-4 font-mono text-[10px] text-[rgb(var(--theme-fg-rgb)/0.45)] md:gap-8 md:text-right">
              <span data-home-music-primary-info class="w-12 text-left md:text-right"></span>
              <span data-home-music-secondary-info class="hidden w-20 text-left md:block md:text-right"></span>
              <Icon name="chevron-right" class="h-4 w-4 shrink-0 -translate-x-3 text-[var(--theme-fg)] opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100" />
            </div>
          </div>
        </a>
      </template>
    </div>
  </div>
</section>
