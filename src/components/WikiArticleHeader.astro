---
import Icon from './Icon.astro';
import Bookmark from './labs/Bookmark.astro';
import SharePopover from './SharePopover.astro';
type LocaleLink = {
  code: string;
  label: string;
  shortLabel: string;
  href: string;
  current: boolean;
};

type Labels = {
  home: string;
  artists?: string;
  songs?: string;
  albums?: string;
  section?: string;
  source: string;
  languages: string;
};

type Props = {
  data: {
    name: string;
    romanizedName: string;
    categoryTitle?: string;
    categorySubtitle?: string;
    profileTagline?: string;
    statusLabel?: string;
    status?: string;
    meta?: string;
  };
  localeLinks: LocaleLink[];
  labels: Labels;
  sourceHref: string;
  homeHref: string;
  sharePath?: string;
};

const { data, localeLinks, labels, sourceHref, homeHref, sharePath } = Astro.props as Props;
const sectionLabel = labels.section ?? labels.artists ?? labels.songs ?? labels.albums;
const currentLocale = localeLinks.find((item) => item.current);
const editorHref = sourceHref.replace('/contribute/edit?', '/contribute/editor/?');
---

<header class="wiki-article-header">
  <div class="wiki-article-context">
    <nav aria-label={currentLocale?.code === 'en' ? 'Breadcrumb' : currentLocale?.code === 'ja' ? 'パンくずリスト' : '頁面路徑'} class="wiki-article-breadcrumb">
      <a href={homeHref}>{labels.home}</a>
      {sectionLabel && <><span aria-hidden="true">/</span><slot name="section"><span>{sectionLabel}</span></slot></>}
      {data.categoryTitle && <><span aria-hidden="true">/</span><span>{data.categoryTitle}</span></>}
    </nav>
    <details class="wiki-article-language-menu">
      <summary aria-label={labels.languages}>{currentLocale?.shortLabel}<span aria-hidden="true"><Icon name="chevron-down" /></span></summary>
      <nav class="wiki-article-locales" aria-label={labels.languages}>
        {localeLinks.map((item) => (
          <a href={item.href} data-locale-href={item.href} aria-current={item.current ? 'page' : undefined} class="wiki-chip">{item.label}</a>
        ))}
      </nav>
    </details>
  </div>

  <div class="wiki-article-title-row">
    <div class="wiki-article-heading">
      <h1 class="wiki-page-title">{data.name}</h1>
      {data.romanizedName && data.romanizedName !== data.name && <p>{data.romanizedName}</p>}
    </div>
    <div class="wiki-article-actions">
      <Bookmark locale={homeHref.split('/')[1]} title={data.name} />
      {sharePath && <SharePopover locale={homeHref.split('/')[1]} path={sharePath} />}
      <a href={editorHref} class="wiki-source-link">{labels.source}</a>
    </div>
  </div>
  {data.profileTagline && <p class="wiki-article-description">{data.profileTagline}</p>}
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.wiki-article-language-menu').forEach((menu) => {
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      event.preventDefault();
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  });
</script>
