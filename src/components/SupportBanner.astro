---
import Icon from './Icon.astro';
import { getSupportCopy } from '../data/supportCopy';
interface Props { locale: string; }
const { locale } = Astro.props;
const copy = getSupportCopy(locale);
---

<section class="home-support" aria-labelledby="home-support-title">
  <div class="home-support__copy">
    <p class="home-support__eyebrow">SUPPORT THE OBSERVATORY</p>
    <h2 id="home-support-title">{copy.bannerTitle}</h2>
    <p class="home-support__body">{copy.bannerBody}</p>
  </div>
  <a class="home-support__action" data-support-open href={`/${locale}/support/`}>{copy.bannerAction}<span aria-hidden="true"><Icon name="arrow-right" /></span></a>
</section>

<style>
  .home-support { display:flex; align-items:center; justify-content:space-between; gap:28px; max-width:1116px; margin:64px auto 0; padding:36px 40px; border:1px solid rgb(var(--theme-accent-rgb) / .3); border-radius:var(--ui-radius-panel); background:rgb(var(--theme-accent-rgb) / .035); color:var(--theme-fg); }
  .home-support__copy { min-width:0; }
  .home-support__eyebrow { font:var(--ui-font-xs)/1.8 var(--font-mono); letter-spacing:.14em; color:var(--theme-accent-color); }
  .home-support h2 { margin:12px 0; font:500 clamp(23px,2.4vw,30px)/1.5 var(--font-serif); text-wrap:balance; }
  .home-support__body { font-size:13px; line-height:1.9; color:rgb(var(--theme-fg-rgb) / .68); }
  .home-support__action { display:inline-flex; flex-shrink:0; align-items:center; justify-content:center; gap:24px; min-height:46px; padding:12px 20px; border:1px solid var(--theme-accent-color); border-radius:var(--ui-radius-control); background:var(--theme-accent-color); color:var(--theme-bg); font-size:13px; transition:background var(--motion-fast),color var(--motion-fast); }
  .home-support__action:hover { background:var(--theme-bg); color:var(--theme-accent-color); }
  .home-support__action:focus-visible { outline:2px solid var(--theme-accent-color); outline-offset:5px; }
  @media(max-width:1180px) { .home-support { margin-inline:32px; } }
  @media(max-width:760px) { .home-support { flex-direction:column; align-items:flex-start; margin:40px 22px 0; padding:26px 24px; gap:22px; } .home-support__action { width:100%; } }
  @media(prefers-reduced-motion:reduce) { .home-support__action { transition:none; } }
</style>
