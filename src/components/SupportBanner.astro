---
import Icon from './Icon.astro';
import { getSupportCopy } from '../data/supportCopy';
interface Props { locale: string; }
const { locale } = Astro.props;
const copy = getSupportCopy(locale);
---

<div class="home-support-frame">
  <section class="home-support" aria-labelledby="home-support-title">
    <div class="home-support__copy">
      <p class="home-support__eyebrow">SUPPORT THE OBSERVATORY</p>
      <h2 id="home-support-title">{copy.bannerTitle}</h2>
      <p class="home-support__body">{copy.bannerBody}</p>
    </div>
    <a class="home-support__action" data-support-open href={`/${locale}/support/`}><span>{copy.bannerAction}</span><span class="home-support__icon" aria-hidden="true"><Icon name="arrow-up-right" /></span></a>
  </section>
</div>

<style>
  .home-support-frame { max-width:80rem; margin:64px auto 0; padding:0 24px; box-sizing:border-box; }
  .home-support { display:flex; align-items:center; justify-content:space-between; gap:28px; padding:36px 40px; border:1px solid rgb(var(--theme-accent-rgb) / .28); border-radius:var(--ui-radius-panel); background:rgb(var(--theme-accent-rgb) / .035); color:var(--theme-fg); }
  .home-support__copy { min-width:0; }
  .home-support__eyebrow { margin:0; font:10px/1.8 var(--font-mono); letter-spacing:.2em; color:var(--theme-accent-color); }
  .home-support h2 { margin:10px 0 12px; font:500 clamp(22px,2.2vw,28px)/1.5 var(--font-serif); text-wrap:balance; }
  .home-support__body { margin:0; max-width:58ch; font-size:13.5px; line-height:1.9; color:rgb(var(--theme-fg-rgb) / .68); }
  .home-support__action { display:inline-flex; flex-shrink:0; align-items:center; justify-content:center; gap:14px; min-height:48px; padding:12px 22px; border:1px solid var(--theme-accent-color); border-radius:var(--ui-radius-control); background:var(--theme-accent-color); color:var(--theme-bg); font-size:13px; font-weight:500; transition:background var(--motion-fast),color var(--motion-fast); }
  .home-support__icon { display:inline-flex; align-items:center; }
  .home-support__action:hover { background:var(--theme-bg); color:var(--theme-accent-color); }
  .home-support__action:focus-visible { outline:2px solid var(--theme-accent-color); outline-offset:5px; }
  @media(max-width:760px) { .home-support-frame { margin-top:40px; padding:0 16px; } .home-support { flex-direction:column; align-items:flex-start; padding:24px 20px; gap:20px; } .home-support__action { width:100%; } }
  @media(prefers-reduced-motion:reduce) { .home-support__action { transition:none; } }
</style>
