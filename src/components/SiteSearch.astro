---
import WorkspaceButton from './WorkspaceButton.astro';
import WorkspaceControl from './WorkspaceControl.astro';
import Icon from './Icon.astro';
import { getLanguageTag, resolveLocaleCopy } from '../lib/i18n.mjs';

const { lang = 'zh' } = Astro.props as { lang?: string };
const languageTag = getLanguageTag(lang);

const copy = resolveLocaleCopy({
  zh: {
    openLabel: '打开站内搜索',
    title: '搜索观测记录',
    closeLabel: '关闭搜索',
    placeholder: '搜索艺人、歌曲、专辑、企划或观测记录…',
    idle: '输入关键词，检索本站全部观测记录。',
    loading: '正在读取观测索引…',
    error: '搜索索引暂时无法读取，请稍后再试。',
    empty: '没有找到匹配的观测记录。',
    resultCount: (count: number) => `找到 ${count} 条结果`,
    kinds: { all: '全部', artist: '艺人', song: '歌曲', album: '专辑', live: '演出', project: '企划', lore: '世界观', organization: '组织', log: '记录' },
    navigateHint: '↑↓ 选择',
    openHint: 'ENTER 打开',
    shortcutAction: '搜索',
    retry: '重试',
  },
  ja: {
    openLabel: 'サイト内検索を開く',
    title: '観測記録を検索',
    closeLabel: '検索を閉じる',
    placeholder: 'アーティスト、楽曲、アルバム、プロジェクト、記録を検索…',
    idle: 'キーワードを入力して、すべての観測記録を検索します。',
    loading: '観測インデックスを読み込んでいます…',
    error: '検索インデックスを読み込めません。しばらくしてからお試しください。',
    empty: '一致する観測記録が見つかりませんでした。',
    resultCount: (count: number) => `${count} 件の結果`,
    kinds: { all: 'すべて', artist: 'アーティスト', song: '楽曲', album: 'アルバム', live: 'ライブ', project: '企画', lore: '世界観', organization: '組織', log: '記録' },
    navigateHint: '↑↓ 選択',
    openHint: 'ENTER 開く',
    shortcutAction: '検索',
    retry: '再試行',
  },
  en: {
    openLabel: 'Open site search',
    title: 'Search observations',
    closeLabel: 'Close search',
    placeholder: 'Search artists, songs, albums, projects, or logs…',
    idle: 'Enter a keyword to search every observation on this site.',
    loading: 'Loading observation index…',
    error: 'The search index is unavailable. Please try again later.',
    empty: 'No matching observations found.',
    resultCount: (count: number) => `${count} result${count === 1 ? '' : 's'}`,
    kinds: { all: 'All', artist: 'Artist', song: 'Song', album: 'Album', live: 'Live event', project: 'Project', lore: 'Lore', organization: 'Organization', log: 'Log' },
    navigateHint: '↑↓ Select',
    openHint: 'ENTER Open',
    shortcutAction: 'Search',
    retry: 'Retry',
  },
}, lang);

const resultCountTemplate = resolveLocaleCopy({
  zh: '找到 {count} 条结果',
  ja: '{count} 件の結果',
  en: '{count} result|{count} results',
}, lang);
const resultKinds = resolveLocaleCopy({
  zh: { 'software-voice': '音乐同位体', 'live-event': '现场演出', 'lore-concept': '世界观', organization: '组织', person: '人物', 'virtual-avatar': '虚拟艺人', project: '企划', 'work-release': '音乐发行', 'work-track': '歌曲', unit: '组合', log: '记录' },
  ja: { 'software-voice': '音楽的同位体', 'live-event': 'ライブ', 'lore-concept': '世界観', organization: '組織', person: '人物', 'virtual-avatar': 'バーチャルアーティスト', project: '企画', 'work-release': '音楽作品', 'work-track': '楽曲', unit: 'ユニット', log: '記録' },
  en: { 'software-voice': 'Voicebank', 'live-event': 'Live event', 'lore-concept': 'Lore', organization: 'Organization', person: 'Person', 'virtual-avatar': 'Virtual artist', project: 'Project', 'work-release': 'Release', 'work-track': 'Song', unit: 'Group', log: 'Log' },
}, lang);
const serializedCopy = {
  ...copy,
  resultCount: undefined,
  resultCountTemplate,
  resultKinds,
};
---

<dialog
  class="site-search"
  data-site-search
  data-modal-layout="fullscreen"
  data-locale={lang}
  data-copy={JSON.stringify(serializedCopy)}
  lang={languageTag}
  role="dialog"
  aria-modal="true"
  aria-labelledby="site-search-title"
  hidden
>
  <section class="site-search__panel">
    <header class="site-search__header">
      <div>
        <span class="site-search__eyebrow">DATABASE_QUERY // {lang.toUpperCase()}</span>
        <h2 id="site-search-title">{copy.title}</h2>
      </div>
      <WorkspaceButton class="site-search__close" type="button" data-search-close aria-label={copy.closeLabel}>
        <Icon name="x" />
      </WorkspaceButton>
    </header>

    <form class="site-search__form" data-search-form role="search">
      <Icon name="search" class="site-search__input-icon" />
      <WorkspaceControl
        class="site-search__input"
        data-search-input
        type="search"
        name="q"
        autocomplete="off"
        spellcheck="false"
        placeholder={copy.placeholder}
        aria-label={copy.title}
        aria-controls="site-search-results"
      />
      <kbd>ESC</kbd>
    </form>

    <div class="site-search__status" data-search-status aria-live="polite">{copy.idle}</div>
    <div class="site-search__filters" aria-label={copy.title}>
      {Object.entries(copy.kinds).map(([kind, label], index) => (
        <WorkspaceButton
          type="button"
          data-search-kind={kind}
          class={index === 0 ? 'is-active' : ''}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {label}
        </WorkspaceButton>
      ))}
    </div>
    <div class="site-search__results" id="site-search-results" data-search-results role="listbox"></div>

    <footer class="site-search__footer" aria-hidden="true">
      <span>{copy.navigateHint}</span>
      <span>{copy.openHint}</span>
      <span><span data-search-shortcut>Ctrl+K</span> {copy.shortcutAction}</span>
    </footer>
  </section>
</dialog>

<script>
  import '../scripts/siteSearch.js';
</script>
