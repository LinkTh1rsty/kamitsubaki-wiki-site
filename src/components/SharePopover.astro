---
import WorkspaceButton from './WorkspaceButton.astro';
import WorkspaceControl from './WorkspaceControl.astro';
import Icon from './Icon.astro';
import { resolveLocaleCopy } from '../lib/i18n.mjs';

interface Props {
  locale: string;
  path?: string;
  deferred?: boolean;
}

const { locale, path = '', deferred = false } = Astro.props as Props;
const copy = resolveLocaleCopy({
  zh: { share: '分享', heading: '分享此页面', anchor: '包含当前小节锚点', copy: '复制链接', copied: '链接已复制', failed: '自动复制失败，请手动复制显示的链接。', link: '分享链接' },
  ja: { share: '共有', heading: 'このページを共有', anchor: '現在の見出しへのリンクを含める', copy: 'リンクをコピー', copied: 'リンクをコピーしました', failed: '自動コピーできませんでした。表示されたリンクを手動でコピーしてください。', link: '共有リンク' },
  en: { share: 'Share', heading: 'Share this page', anchor: 'Include the current section anchor', copy: 'Copy link', copied: 'Link copied', failed: 'Copy failed. Select and copy the displayed link.', link: 'Share link' },
}, locale);
---

<div class="share-popover" data-share-popover data-share-path={path} data-copy={JSON.stringify(copy)} hidden={deferred}>
  <WorkspaceButton type="button" class="share-popover__trigger" data-share-trigger aria-expanded="false" aria-controls="reader-share-panel" aria-haspopup="true">
    <Icon name="share" size={14} />
    <span>{copy.share}</span>
  </WorkspaceButton>
  <div class="share-popover__panel" id="reader-share-panel" data-share-panel hidden>
    <p class="share-popover__heading">{copy.heading}</p>
    <label class="share-popover__anchor" data-share-anchor-row hidden>
      <WorkspaceControl type="checkbox" data-share-anchor checked />
      <span>{copy.anchor}</span>
    </label>
    <WorkspaceControl class="share-popover__link" type="text" data-share-link aria-label={copy.link} readonly />
    <div class="share-popover__actions">
      <WorkspaceButton type="button" class="share-popover__copy" data-share-copy>{copy.copy}</WorkspaceButton>
      <slot name="actions" />
    </div>
    <p class="share-popover__status" role="status" aria-live="polite" data-share-status></p>
  </div>
</div>

<script>
  type ShareCopy = { copied: string; failed: string };
  for (const root of document.querySelectorAll<HTMLElement>('[data-share-popover]')) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-share-trigger]')!;
    const panel = root.querySelector<HTMLElement>('[data-share-panel]')!;
    const anchorRow = root.querySelector<HTMLElement>('[data-share-anchor-row]')!;
    const anchor = root.querySelector<HTMLInputElement>('[data-share-anchor]')!;
    const copyButton = root.querySelector<HTMLButtonElement>('[data-share-copy]')!;
    const status = root.querySelector<HTMLElement>('[data-share-status]')!;
    const link = root.querySelector<HTMLInputElement>('[data-share-link]')!;
    const messages = JSON.parse(root.dataset.copy || '{}') as ShareCopy;

    const currentHeadingHash = () => {
      if (!location.hash) return '';
      try {
        const id = decodeURIComponent(location.hash.slice(1));
        const target = document.getElementById(id);
        return target?.matches('h1,h2,h3,h4,h5,h6') ? location.hash : '';
      } catch { return ''; }
    };
    const shareUrl = () => {
      const url = new URL(root.dataset.sharePath || location.pathname, location.origin);
      url.hash = anchor.checked ? currentHeadingHash() : '';
      return url.href;
    };
    const updateLink = () => { link.value = shareUrl(); };
    const position = () => {
      if (panel.hidden) return;
      const rect = trigger.getBoundingClientRect();
      const width = panel.getBoundingClientRect().width;
      const height = panel.getBoundingClientRect().height;
      panel.style.left = `${Math.max(16, Math.min(rect.right - width, innerWidth - width - 16))}px`;
      panel.style.top = `${rect.bottom + height + 8 > innerHeight ? Math.max(8, rect.top - height - 8) : rect.bottom + 8}px`;
    };
    const close = (restoreFocus = false) => {
      if (panel.hidden) return;
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger.focus();
    };
    trigger.addEventListener('click', () => {
      if (!panel.hidden) { close(true); return; }
      for (const other of document.querySelectorAll<HTMLElement>('[data-share-popover]')) {
        if (other !== root) {
          other.querySelector<HTMLElement>('[data-share-panel]')?.setAttribute('hidden', '');
          other.querySelector<HTMLElement>('[data-share-trigger]')?.setAttribute('aria-expanded', 'false');
        }
      }
      anchorRow.hidden = !currentHeadingHash();
      anchor.checked = true;
      status.textContent = '';
      updateLink();
      panel.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      position();
      copyButton.focus();
    });
    copyButton.addEventListener('click', async () => {
      const url = shareUrl();
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = messages.copied;
      } catch {
        status.textContent = messages.failed;
        link.value = url;
        link.focus();
        link.select();
      }
    });
    anchor.addEventListener('change', updateLink);
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) { event.preventDefault(); close(true); }
    });
    window.addEventListener('resize', position);
    window.addEventListener('scroll', position, { passive: true });
    window.addEventListener('hashchange', () => {
      if (!panel.hidden) { anchorRow.hidden = !currentHeadingHash(); updateLink(); position(); }
    });
  }
</script>

<style>
  .share-popover { display: inline-flex; }
  .share-popover[hidden], .share-popover__panel[hidden], .share-popover__anchor[hidden] { display: none !important; }
  .share-popover__trigger { display: inline-flex; align-items: center; gap: .35rem; }
  .share-popover__panel { position: fixed; z-index: 100; width: min(17.5rem, calc(100vw - 32px)); padding: .9rem; border: 1px solid var(--reader-line, rgb(var(--theme-fg-rgb) / .16)); border-radius: var(--ui-radius-control, 4px); background: var(--reader-paper, var(--theme-bg)); color: var(--theme-fg); box-shadow: 0 12px 30px rgb(0 0 0 / .16); animation: share-enter 180ms ease-out both; }
  .share-popover__heading { margin: 0 0 .75rem; font: 500 .88rem/1.5 var(--font-serif); }
  .share-popover__anchor { display: flex; align-items: center; gap: .55rem; min-height: 40px; padding: .4rem 0; border-top: 1px solid var(--reader-line); color: var(--reader-muted); font-size: .75rem; line-height: 1.5; cursor: pointer; }
  .share-popover__anchor input { accent-color: var(--theme-fg); width: 15px; height: 15px; flex: none; }
  .share-popover__link { display: block; margin: .2rem 0 .6rem; border: 1px solid var(--reader-line); border-radius: var(--ui-radius-control, 4px); background: transparent; font: .7rem/1.4 var(--font-mono); text-overflow: ellipsis; }
  .share-popover__actions { display: grid; gap: .35rem; padding-top: .55rem; border-top: 1px solid var(--reader-line); }
  .share-popover .share-popover__copy { display: flex; justify-content: center; align-items: center; min-height: 40px; width: 100%; border: 1px solid var(--reader-line); border-radius: var(--ui-radius-control, 4px); background: var(--theme-fg); color: var(--theme-bg); font: 500 .78rem/1.4 var(--font-sans); cursor: pointer; transition: opacity 180ms ease; }
  .share-popover .share-popover__copy:hover { opacity: .82; }
  .share-popover__status { margin: .45rem 0 0; color: var(--reader-muted); font: var(--ui-font-xs)/1.5 var(--font-sans); }
  .share-popover__status:empty { display: none; }
  .share-popover :is(button, input):focus-visible { outline: 2px solid var(--theme-accent-color); outline-offset: 2px; }
  @keyframes share-enter { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .share-popover__panel { animation: none; } .share-popover .share-popover__copy { transition: none; } }
</style>
