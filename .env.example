# 实时活动 API 基地址（PUBLIC_ 变量会编译进公开 JS，严禁放任何密钥）
# 只填基地址：不带末尾 /，也不要包含 /v1/events。
PUBLIC_EVENTS_API_BASE=https://kamitsubaki-events-api.apikatsuwiki.workers.dev

# 本地联调时可临时指向本机服务，部署前务必恢复：
# PUBLIC_EVENTS_API_BASE=http://localhost:8787
# Public support data. The support page keeps its fallback content if unavailable.
# Shared account authority and AI API; this is public configuration, never a secret.
# PUBLIC_AI_OBSERVER_API_BASE=https://api.kamitsubaki.wiki
# Exact registered frontend origins used by static account links and the AI terminal.
# PUBLIC_SITE_URL=https://kamitsubaki.wiki
# PUBLIC_COMPANION_SITE_URL=https://chat.kamitsubaki.wiki
# PUBLIC_SUPPORT_API_BASE=https://api.kamitsubaki.wiki
# Local support backend (do not use this value in a production build):
# PUBLIC_SUPPORT_API_BASE=http://127.0.0.1:8789

# Optional separate API origin for special collaborators; otherwise uses support / existing public API origin.
# PUBLIC_COLLABORATORS_API_BASE=http://127.0.0.1:8789

# Public reference gallery assets (no credentials)
PUBLIC_GALLERY_R2_URL=https://images.kamitsubaki.wiki

# Worker endpoint for gallery submission, review and published metadata.
PUBLIC_GALLERY_API_URL=https://api.kamitsubaki.wiki

# For an online acceptance/production build, run pnpm build:online.
# It explicitly enables reviewed GitHub PR submission, disables local fixtures,
# targets the production Worker, and audits all five editor locales before deploy.
# A regular pnpm build keeps the explicit feature flags configured by the host.
# PUBLIC_EDITOR_ENABLED=true
# PUBLIC_EDITOR_LOCAL=false
# PUBLIC_EDITOR_API_BASE=https://api.kamitsubaki.wiki
# Independent management UI. Change only after its API/Access acceptance passes.
# Public URL only; this does not change any authenticated API base.
# PUBLIC_ADMIN_UI_ORIGIN=https://admin.kamitsubaki.wiki
# In isolated local acceptance:
# PUBLIC_ADMIN_UI_ORIGIN=http://127.0.0.1:4315

# QQ-only Folia: leave empty until the exact release is approved.
# Preview only: https://wiki-folia-qq-preview.linkth1rstyg.workers.dev
# PUBLIC_FOLIA_ORIGIN=https://music.kamitsubaki.wiki
